    "surface": "#171f33",
    "surface_high": "#222a3d",
    "surface_highest": "#2d3449",
    "border": "#3c4a42",
    "border_strong": "#86948a",
    "text": "#dae2fd",
    "text_muted": "#bbcabf",
    "text_dim": "#86948a",
    "primary": "#4edea3",
    "primary_container": "#10b981",
    "on_primary": "#003824",
    "secondary": "#4cd7f6",
    "on_secondary": "#003640",
    "success": "#4edea3",
    "on_success": "#003824",
    "error": "#ffb4ab",
    "on_error": "#690005",
    "warning": "#f59e0b"
