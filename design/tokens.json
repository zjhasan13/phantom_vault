{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "PhantomVault UI tokens (Aegis Cyber-Cockpit)",
  "source": "expected ui/stitch_phantom_vault_desktop_ui/all_vault_items/code.html (Tailwind config)",
  "decision": "AegisVault Cyber-Cockpit redesign (Option B): deep navy + mint + electric cyan. See docs/UI_PARITY_MAP.md §18.",
  "palette": {
    "canvas": "#0b1326",
    "surface_lowest": "#060e20",
