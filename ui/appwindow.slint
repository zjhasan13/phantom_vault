                        AuraButton { label: "Medium"; primary: root.prox_sensitivity == 1; width: 76px; height: 30px; clicked => { root.set_prox_sensitivity(1); } }
                        AuraButton { label: "Far"; primary: root.prox_sensitivity == 2; width: 76px; height: 30px; clicked => { root.set_prox_sensitivity(2); } }
                        AuraButton { label: "Save device"; primary: true; width: 110px; height: 30px; clicked => { root.save_prox_device(root.prox_device); } }
                    }
                    Text { text: root.prox_status; color: #38e1ff; font-size: 11px; wrap: word-wrap; }
                }}
                Rectangle { background: #0d131f; border-radius: 12px; border-width: 1px; border-color: #26315c; VerticalLayout { padding: 16px; spacing: 10px;
                    Text { text: "GitHub Sync"; color: #8b7cf6; font-size: 12px; font-weight: 800; }
                    LineEdit { placeholder-text: "Owner"; text <=> root.sync_owner; height: 36px; } LineEdit { placeholder-text: "Repo"; text <=> root.sync_repo; height: 36px; } LineEdit { placeholder-text: "PAT"; input-type: password; text <=> root.sync_token_input; height: 36px; }
                    HorizontalLayout { spacing: 8px; AuraButton { label: "Connect"; primary: true; width: 120px; clicked => { root.save_sync_config(root.sync_owner, root.sync_repo, root.sync_token_input); } } AuraButton { label: "Sync Now"; width: 120px; clicked => { root.sync_now(); } } }
                    Text { text: root.sync_status; color: #38e1ff; font-size: 11px; wrap: word-wrap; }
                }}
                Rectangle { background: #0d131f; border-radius: 12px; border-width: 1px; border-color: #26315c; VerticalLayout { padding: 16px; spacing: 10px;
                    Text { text: "📡 LOCAL WI-FI P2P SYNC (OFFLINE)"; color: #8b7cf6; font-size: 12px; font-weight: 800; }
                    Text { text: "Ciphertext only — keys never leave this device. Newer vault wins; same-age divergence keeps local and reports."; color: #5b6589; font-size: 11px; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; Text { text: "Enable Local Wi-Fi Discovery"; color: #eef1ff; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } AuraButton { label: root.p2p_enabled ? "ON" : "OFF"; primary: root.p2p_enabled; width: 90px; clicked => { root.set_p2p(!root.p2p_enabled); } } }
                    HorizontalLayout { spacing: 8px; Text { text: "Pairing PIN (this device)"; color: #eef1ff; font-size: 12px; vertical-alignment: center; } Text { text: root.p2p_pin == "" ? "—" : root.p2p_pin; color: #38e1ff; font-size: 14px; font-weight: 800; } AuraButton { label: "⟳ New PIN"; width: 100px; height: 30px; clicked => { root.regen_p2p_pin(); } } }
                    Text { text: "Peers with 🔒 need their PIN typed below before Sync."; color: #5b6589; font-size: 11px; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; AuraButton { label: "🔍 Scan LAN Peers"; width: 200px; clicked => { root.scan_p2p(); } } LineEdit { placeholder-text: "Peer PIN (if 🔒)"; text <=> root.p2p_peer_pin; height: 36px; horizontal-stretch: 1; } }
                    for peer in root.p2p_peers : Rectangle { background: #121927; border-radius: 8px; height: 44px; HorizontalLayout { padding-left: 12px; padding-right: 6px; spacing: 8px; VerticalLayout { spacing: 0px; horizontal-stretch: 1; alignment: center; Text { text: "💻 " + peer.name + " (" + peer.ip + ")"; color: #eef1ff; font-size: 12px; font-weight: 700; overflow: elide; } Text { text: peer.detail; color: #5b6589; font-size: 10px; overflow: elide; } } AuraButton { label: "Sync Now"; width: 110px; height: 30px; y: 7px; clicked => { root.sync_peer(peer.ip, root.p2p_peer_pin); } } } }
                    Text { text: root.p2p_status; color: #38e1ff; font-size: 11px; wrap: word-wrap; }
                }}
                Rectangle { background: #0d131f; border-radius: 12px; border-width: 1px; border-color: #26315c; VerticalLayout { padding: 16px; spacing: 10px;
                    Text { text: "Browser Bridge (headless)"; color: #8b7cf6; font-size: 12px; font-weight: 800; }
                    Text { text: "Paste your extension ID (chrome://extensions → Developer mode), then install. The ID is locked into allowed_origins — no other extension can reach the vault."; color: #5b6589; font-size: 11px; wrap: word-wrap; }
                    LineEdit { placeholder-text: "Extension ID (32 chars, e.g. abcdefgh…)"; text <=> root.ext_host_id; height: 36px; }
                    HorizontalLayout { spacing: 8px; AuraButton { label: "🌐 Install Browser Extension Host"; primary: true; width: 280px; clicked => { root.install_browser_host(root.ext_host_id); } } }
                    Text { text: root.bridge_status; color: #38e1ff; font-size: 11px; wrap: word-wrap; }
                }}
                Rectangle { background: #0d131f; border-radius: 12px; border-width: 1px; border-color: #26315c; VerticalLayout { padding: 16px; spacing: 10px;
                    Text { text: "📤 EXPORT VAULT (ZERO VENDOR LOCK-IN)"; color: #8b7cf6; font-size: 12px; font-weight: 800; }
                    Text { text: "Plaintext files hit your disk — master-password verified, save dialog is the consent point. Shred the file after moving it."; color: #5b6589; font-size: 11px; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; AuraButton { label: "📄 Export Bitwarden JSON"; primary: true; width: 230px; clicked => { root.export_vault(1); } } AuraButton { label: "📊 Export CSV"; width: 170px; clicked => { root.export_vault(2); } } }
                    Text { text: root.export_status; color: #38e1ff; font-size: 11px; wrap: word-wrap; }
