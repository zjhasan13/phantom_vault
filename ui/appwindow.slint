                    if root.recovery_backed_up : Text { text: "✅ Recovery Sheet exported"; color: #34d399; font-size: 11px; wrap: word-wrap; }
                    AuraButton { label: "Recovery Sheet"; width: 200px; clicked => { root.generate_shards(); } } AuraButton { label: "Hide in PNG"; width: 200px; clicked => { root.stego_hide(); } } AuraButton { label: "Restore PNG"; width: 200px; clicked => { root.stego_restore(); } }
                    AuraButton { label: "🖨️ Export Printable PDF Recovery Sheet"; primary: true; height: 40px; clicked => { root.export_recovery_sheet(); } }
                    FieldLabel { text: "DURESS PASSWORD (DECOY VAULT)"; }
