    in-out property <string> rp_backup_pass: "";
    in-out property <string> rp_backup_confirm: "";
    in-out property <bool> show_2fa_import: false;
    // GA reverse-export modal state (image set from Rust PNG bytes).
    in-out property <bool> ga_show: false;
    // The sheet opens IMMEDIATELY on click and shows this state while the
