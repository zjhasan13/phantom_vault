    callback delete_passkey(string);
    callback restore_passkey(string);
    callback toggle_passkey_fav(string);
    callback copy_passkey_pub(string);
    callback export_recovery_sheet();
    callback verify_shard_drill(string, string);
    in-out property <string> notification_text: "";
    // Toast severity: "info" | "success" | "warn" | "error". Banner tints by
    // kind; Rust copy paths set it, everything else defaults to info.
    in-out property <string> notification_kind: "info";
    // Full coverage without touching 100+ call sites: any toast resets to
    // info unless Rust sets a kind right AFTER the text (same closure).
    changed notification_text => { root.notification_kind = "info"; }
    in-out property <bool> sidebar_collapsed: false;
    in-out property <[CredentialView]> credentials;
    in-out property <string> search_query;
    // Isolated 2FA Hub query — never touches the vault search above.
    in-out property <string> totp_search_query: "";
    // Hub filter: 0 All, 1 Starred, 2 TOTP, 3 HOTP, 4 Steam.
    in-out property <int> totp_filter: 0;
    // Hub sort: 0 vault order (favourites first), 1 name A-Z, 2 name Z-A.
    in-out property <int> totp_sort: 0;
    // Rust-fed hub content width (logical px) — self-healing every TOTP tick.
    in-out property <float> hub_px_w: 1200;
    // Rust-fed hub Rectangle width — explicit beats stretch unconditionally.
    in-out property <float> hub_w: 1200;
    // Bitwarden-parity item management
    in-out property <int> new_kind: 1;
    in-out property <int> type_filter: 0;
    in-out property <string> folder_filter: "All";
    in-out property <string> f_title;
    in-out property <string> f_tags;
    in-out property <string> f_a;
    in-out property <string> f_b;
    in-out property <string> f_c;
    // Secondary website URLs (primary stays in f_c above).
    in-out property <[string]> f_urls;
    // Per-URL match rule, index-aligned with f_urls (0 Default … 5 Never).
    // Narrow labels keep rows compact; full names live in the tooltip.
    in-out property <[int]> f_url_rules;
    callback cycle_url_rule(int);
    in-out property <string> f_d;
    in-out property <string> f_e;
    // Identity structured parts (kind 5 only; all optional).
    in-out property <string> f_company;
    in-out property <string> f_city;
    in-out property <string> f_state;
    in-out property <string> f_zip;
    in-out property <string> f_country;
    in-out property <string> f_notes;
    in-out property <string> f_folder: "General";
    in-out property <string> f_totp;
    in-out property <string> f_backup;
    in-out property <bool> f_reprompt: false;
    in-out property <bool> f_fav: false;
    in-out property <bool> f_travel: false;
    // Folder engine
    in-out property <[string]> folders_list;
    in-out property <[string]> filter_folders;
    in-out property <string> new_folder_name;
