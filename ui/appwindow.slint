    // ================= LOCK SCREEN (cryptographic gateway) =================
    if !root.is_unlocked : Rectangle {
        background: #0b1326;

        // 38px technical grid (design .cyber-grid)
        for gx in 54 : Rectangle { x: gx * 38px; y: 0; width: 1px; height: parent.height; background: #ffffff0d; }
        for gy in 28 : Rectangle { x: 0; y: gy * 38px; width: parent.width; height: 1px; background: #ffffff0d; }

        // Ambient light: one very soft top glow (no hard-edged circles).
        Rectangle { x: parent.width / 2 - 160px; y: 0px; width: 320px; height: 220px; border-radius: 160px; background: #10b98108; drop-shadow-blur: 180px; drop-shadow-color: #10b98122; }
        Rectangle { x: parent.width - 280px; y: parent.height - 220px; width: 240px; height: 180px; border-radius: 120px; background: #4edea308; drop-shadow-blur: 160px; drop-shadow-color: #4edea31f; }

        VerticalLayout { spacing: 0px;
            // ---- live telemetry strip
            Rectangle { height: 26px; background: #060e20e8;
                HorizontalLayout { padding-left: 22px; padding-right: 22px; spacing: 16px;
                    Text { text: "● VAULT SEALED"; color: PhantomTheme.success; font-size: 10px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.7px; vertical-alignment: center; }
                    Text { text: "Argon2id 64 MiB · t=3 · p=4 · memory zeroize"; color: PhantomTheme.text-muted; font-size: 10px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "DEVICE BINDING: " + (root.device_bound ? "BOUND" : "FIRST UNLOCK"); color: root.device_bound ? PhantomTheme.success : PhantomTheme.text-dim; font-size: 10px; font-family: "JetBrains Mono"; letter-spacing: 0.5px; vertical-alignment: center; }
                }
            }
            Rectangle { height: 1px; background: #ffffff0f; }
            // ---- engine flags
            Rectangle { height: 32px; background: #060e20cc;
                HorizontalLayout { padding-left: 22px; padding-right: 22px; spacing: 8px;
                    MonoChip { label: "ENGINE v" + root.app_version + "-rs"; tone: PhantomTheme.text-muted; }
                    if root.hello_available : MonoChip { label: "WINDOWS HELLO ACTIVE"; tone: PhantomTheme.secondary; }
                    if root.portable_badge != "" : MonoChip { label: "PORTABLE · USB/RAM"; tone: PhantomTheme.success; }
                    AuraButton { label: root.ui_lang == "bn" ? "LOC: BN" : "LOC: EN"; width: 70px; height: 24px; clicked => { root.ui_lang = root.ui_lang == "bn" ? "en" : "bn"; root.set_language(root.ui_lang); } }
                    AuraButton { label: "?"; width: 24px; height: 24px; clicked => { root.show_login_hints = !root.show_login_hints; } }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "LOCAL-FIRST"; color: PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; letter-spacing: 0.8px; vertical-alignment: center; }
                }
            }
            if root.show_login_hints : Rectangle { height: 24px; background: #060e20;
                HorizontalLayout { padding-left: 22px; padding-right: 22px; spacing: 14px;
                    Text { text: "ENTER unlock · TAB cycle fields · ESC dismiss hints"; color: PhantomTheme.text-dim; font-size: 10px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                }
            }
            Rectangle { height: 1px; background: #ffffff0f; }

            // hero pill: pinned above the scroll area so focus-scrolling can never hide it
            Rectangle { height: 8px; }
            HorizontalLayout { alignment: center;
                Rectangle { height: 24px; width: root.pq_paranoid_on ? (root.pq_backend == "tpm" ? 292px : 272px) : 226px; border-radius: 12px; background: #131b2e; border-width: 1px; border-color: #10b98140;
                    HorizontalLayout { alignment: center; padding-left: 10px; padding-right: 5px; spacing: 7px;
                        Text { text: "●"; color: PhantomTheme.success; font-size: 9px; vertical-alignment: center; }
                        Text { text: root.pq_paranoid_on ? (root.pq_backend == "tpm" ? "POST-QUANTUM ENCLAVE · TPM 2.0" : "POST-QUANTUM ENCLAVE ACTIVE") : "LOCAL ENCLAVE ACTIVE"; color: PhantomTheme.text; font-size: 10px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 1px; vertical-alignment: center; }
                        MonoChip { label: root.pq_paranoid_on ? (root.pq_backend == "tpm" ? "HW KEY" : "ML-KEM-768") : "XChaCha20"; tone: PhantomTheme.secondary; outlined: false; }
                    }
                }
            }
            Rectangle { height: 6px; }

            // wordmark + shield crest: pinned with the pill so auto-focus scrolling
            // can never push the brand header out of view
            HorizontalLayout { alignment: center; spacing: 12px;
                        Rectangle { width: 46px; height: 50px;
                            Rectangle { x: 3px; y: 4px; width: 40px; height: 44px; border-radius: 20px; background: #10b98114; }
                            Path { x: 0; y: 0; width: 46px; height: 50px; viewbox-width: 46; viewbox-height: 50; commands: "M 23 2 L 44 9 L 44 26 C 44 37 35 45 23 48 C 11 45 2 37 2 26 L 2 9 Z"; fill: #0b1326; stroke: @linear-gradient(135deg, #4edea3 0%, #4cd7f6 55%, #c0c1ff 100%); stroke-width: 2px; }
                            Path { x: 10px; y: 11px; width: 26px; height: 28px; viewbox-width: 26; viewbox-height: 28; commands: "M 13 1 L 24 6 L 24 14 C 24 20 19 24 13 26 C 7 24 2 20 2 14 L 2 6 Z"; fill: #131b2e; stroke: #4edea366; stroke-width: 1px; }
                            Path { x: 17px; y: 17px; width: 12px; height: 16px; viewbox-width: 12; viewbox-height: 16; commands: "M 6 1 C 8 1 9.5 2.5 9.5 4.5 C 9.5 6 8.5 7 7.5 7.5 L 8.5 12 L 3.5 12 L 4.5 7.5 C 3.5 7 2.5 6 2.5 4.5 C 2.5 2.5 4 1 6 1 Z"; fill: #4edea3; }
                        }
                        Text { text: "PHANTOM"; color: #ffffff; font-size: 36px; font-weight: 900; letter-spacing: -0.5px; vertical-alignment: center; }
                        Text { text: "VAULT"; color: @linear-gradient(90deg, #dae2fd 0%, #4edea3 55%, #4cd7f6 100%); font-size: 36px; font-weight: 900; letter-spacing: -0.5px; vertical-alignment: center; }
                    }
                    Rectangle { height: 4px; }
                    Text { text: "ZERO-KNOWLEDGE · NATIVE · LOCAL-FIRST"; color: PhantomTheme.text-dim; font-size: 10px; font-weight: 600; font-family: "JetBrains Mono"; letter-spacing: 2px; horizontal-alignment: center; }
                    Rectangle { height: 8px; }
                    // ---- scrollable gateway
                    ScrollView { vertical-stretch: 1;
                        VerticalLayout { padding-left: 16px; padding-right: 16px; padding-top: 0px; padding-bottom: 14px; spacing: 0px;
                    // cryptographic gateway card
                    HorizontalLayout { alignment: center;
                        VerticalLayout { alignment: start;
                        Rectangle { width: 520px; background: #0f1a30e8; border-radius: 16px; border-width: 1px; border-color: #10b98138; drop-shadow-blur: 110px; drop-shadow-color: #10b98133;
                            Rectangle { x: 26px; y: 0; width: parent.width - 52px; height: 2px; background: @linear-gradient(90deg, transparent 0%, #4edea3 50%, transparent 100%); }
                            VerticalLayout { padding: 14px; spacing: 0px;
                                HorizontalLayout { spacing: 8px;
                                    Rectangle { width: 9px; height: 9px; border-radius: 5px; background: PhantomTheme.primary; }
                                    Text { text: "CRYPTOGRAPHIC GATEWAY"; color: #ffffff; font-size: 11px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 1px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: root.pq_paranoid_on ? "CIPHER: ML-KEM-768 + XChaCha20" : "CIPHER: XChaCha20-Poly1305"; color: PhantomTheme.success; font-size: 10px; font-weight: 700; font-family: "JetBrains Mono"; vertical-alignment: center; }
                                }
                                Rectangle { height: 8px; }
                                Rectangle { height: 1px; background: #ffffff10; }
                                Rectangle { height: 8px; }
                                // auth mode tabs
                                Rectangle { height: 36px; border-radius: 12px; background: #060e20; border-width: 1px; border-color: #ffffff08;
                                    HorizontalLayout { padding: 4px; spacing: 4px;
                                        GatewayTab { label: root.ui_lang == "bn" ? "🔑  মাস্টার পাস" : "🔑  Master Pass"; active: root.unlock_tab == 0; horizontal-stretch: 1; clicked => { root.unlock_tab = 0; root.show_pin_pad = false; root.show_recover = false; root.unlock_error_message = ""; } }
                                        GatewayTab { label: root.pin_available ? (root.ui_lang == "bn" ? "🔒  পিন" : "🔒  PIN") : (root.ui_lang == "bn" ? "🔒  পিন · অফ" : "🔒  PIN · OFF"); active: root.unlock_tab == 1; horizontal-stretch: 1; clicked => { if root.pin_available { root.unlock_tab = 1; root.show_pin_pad = true; root.show_recover = false; root.pin_error = ""; } else { root.unlock_tab = 0; root.unlock_error_message = root.ui_lang == "bn" ? "আগে সেটিংসে অ্যাপ পিন চালু করুন।" : "Enable an App PIN in Settings first."; } } }
                                        GatewayTab { label: root.ui_lang == "bn" ? "🧩  রিকভারি শার্ড" : "🧩  Recovery Shards"; active: root.unlock_tab == 2; horizontal-stretch: 1; clicked => { root.unlock_tab = 2; root.show_pin_pad = false; root.show_recover = true; } }
                                    }
                                }
                                Rectangle { height: 8px; }
                                if root.show_totp_step : VerticalLayout { spacing: 8px;
                                    Text { text: root.ui_lang == "bn" ? "দ্বিতীয় ধাপ প্রয়োজন" : "SECOND FACTOR REQUIRED"; color: PhantomTheme.text; font-size: 11px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 1px; horizontal-alignment: center; }
                                    totp_step_input := LineEdit { placeholder-text: "6-digit code"; height: 42px; font-size: 16px; font-family: "JetBrains Mono"; horizontal-alignment: center; accepted(text) => { root.verify_totp_unlock(text); } }
                                    if root.totp_step_error != "" : Text { text: root.totp_step_error; font-size: 11px; font-weight: 600; color: PhantomTheme.error; horizontal-alignment: center; wrap: word-wrap; }
                                    HorizontalLayout { spacing: 8px; alignment: center;
                                        AuraButton { label: root.ui_lang == "bn" ? "যাচাই ও খুলুন" : "Verify & Unlock"; primary: true; height: 38px; width: 180px; clicked => { root.verify_totp_unlock(totp_step_input.text); } }
                                        AuraButton { label: root.ui_lang == "bn" ? "পেছনে" : "Back"; height: 38px; width: 90px; clicked => { root.cancel_totp_step(); } }
                                    }
                                }
                                if !root.show_totp_step : VerticalLayout { spacing: 0px;
                                    // account identifier (real local vault file, never a fake account)
                                    HorizontalLayout { height: 14px;
                                        Text { text: "VAULT ACCOUNT IDENTIFIER"; color: PhantomTheme.text-muted; font-size: 10px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 1px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: root.ui_lang == "bn" ? "লোকাল-ওনলি · কোনো অ্যাকাউন্ট নেই" : "LOCAL-ONLY · NO ACCOUNT"; color: PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; letter-spacing: 0.5px; vertical-alignment: center; }
                                    }
                                    Rectangle { height: 4px; }
                                    Rectangle { height: 36px; border-radius: 10px; background: #0b1326; border-width: 1px; border-color: #ffffff14;
                                        HorizontalLayout { padding-left: 12px; padding-right: 8px; spacing: 10px;
                                            Text { text: "▣"; color: PhantomTheme.text-dim; font-size: 14px; vertical-alignment: center; }
                                            Text { text: root.vault_label; color: PhantomTheme.text; font-size: 13px; font-family: "JetBrains Mono"; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                            MonoChip { label: "LOCAL"; tone: PhantomTheme.text-muted; }
                                        }
                                    }
                                    Rectangle { height: 8px; }
                                    // master passphrase (conditional: hidden blocks must not reserve space)
                                    if root.unlock_tab == 0 : VerticalLayout { spacing: 0px;
                                        HorizontalLayout { height: 14px;
                                            Text { text: "MASTER PASSPHRASE"; color: PhantomTheme.text-muted; font-size: 10px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 1px; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: "Argon2id 64 MiB"; color: PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                                        }
                                        Rectangle { height: 4px; }
                                        Rectangle { height: 40px;
                                            password_input := LineEdit { x: 0; y: 0; width: parent.width; height: parent.height; placeholder-text: root.ui_lang == "bn" ? "মাস্টার পাসফ্রেজ…" : "Enter master passphrase…"; input-type: root.show_master ? text : password; font-size: 14px; font-family: "JetBrains Mono"; init => { self.focus(); } edited(text) => { root.unlock_busy = false; root.lock_entropy(text); } accepted(text) => { if !root.unlock_busy { root.unlock_busy = true; root.unlock_requested(text); } } }
                                            Rectangle { x: parent.width - 38px; y: 5px; width: 32px; height: 32px; border-radius: 8px; background: #0b1326; }
                                            TouchArea { x: parent.width - 38px; y: 6px; width: 32px; height: 32px; mouse-cursor: pointer; clicked => { root.show_master = !root.show_master; } Text { text: root.show_master ? "◉" : "○"; color: PhantomTheme.text-dim; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; } }
                                        }
                                        Rectangle { height: 8px; }
                                        // live entropy panel (real estimate, real KDF params)
                                        Rectangle { height: 46px; border-radius: 10px; background: #060e20cc; border-width: 1px; border-color: #ffffff10;
                                            VerticalLayout { padding: 6px; spacing: 4px;
                                                HorizontalLayout { Text { text: "Entropy: " + Math.round(root.lock_bits) + " bits (Argon2id bound)"; color: PhantomTheme.text-muted; font-size: 10px; font-family: "JetBrains Mono"; horizontal-stretch: 1; overflow: elide; } Text { text: "64 MiB · t=3 · p=4"; color: root.lock_bits >= 55 ? PhantomTheme.success : PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; } }
                                                HorizontalLayout { spacing: 5px;
                                                    Rectangle { height: 4px; border-radius: 2px; horizontal-stretch: 1; background: root.lock_bits >= 20 ? PhantomTheme.success : #ffffff1f; }
                                                    Rectangle { height: 4px; border-radius: 2px; horizontal-stretch: 1; background: root.lock_bits >= 40 ? PhantomTheme.success : #ffffff1f; }
                                                    Rectangle { height: 4px; border-radius: 2px; horizontal-stretch: 1; background: root.lock_bits >= 60 ? PhantomTheme.success : #ffffff1f; }
                                                    Rectangle { height: 4px; border-radius: 2px; horizontal-stretch: 1; background: root.lock_bits >= 80 ? PhantomTheme.success : #ffffff1f; }
                                                    Rectangle { height: 4px; border-radius: 2px; horizontal-stretch: 1; background: root.lock_bits >= 100 ? PhantomTheme.success : #ffffff1f; }
                                                }
                                                HorizontalLayout { Text { text: "Resistance: " + (root.pq_paranoid_on ? "ML-KEM-768 + XChaCha20" : "XChaCha20-Poly1305"); color: PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; horizontal-stretch: 1; } Text { text: "Zeroized on lock"; color: PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; } }
                                            }
                                        }
                                        Rectangle { height: 8px; }
                                        if root.pq_paranoid_on && root.pq_backend == "tpm" : StatusRow { label: root.ui_lang == "bn" ? "TPM 2.0 হার্ডওয়্যার কী-তে বাঁধা" : "Hardware-bound to this TPM 2.0 key"; on: true; chip: "TPM 2.0"; }
                                        if !root.pq_paranoid_on || root.pq_backend != "tpm" : StatusRow { label: root.ui_lang == "bn" ? "এই ডিভাইসে বাঁধা (DPAPI)" : "Bind to this device (DPAPI machine ID)"; on: root.device_bound; chip: root.device_bound ? "BOUND" : "FIRST UNLOCK"; }
                                        StatusRow { label: root.ui_lang == "bn" ? "লক করলে সিক্রেট জিরো হয়" : "Zeroize secrets on lock"; on: true; chip: "ALWAYS"; }
                                        Rectangle { height: 10px; }
                                        PrimaryGradientAction { glyph: "🔓"; label: root.unlock_busy ? (root.ui_lang == "bn" ? "ডিক্রিপ্ট হচ্ছে…" : "Decrypting vault…") : (root.ui_lang == "bn" ? "ভল্ট খুলুন ও সাইন ইন" : "Unlock Enclave & Sign In"); enabled: !root.unlock_busy; shortcut: "↵ Enter"; clicked => { root.unlock_busy = true; root.unlock_requested(password_input.text); } }
                                        VerticalLayout { spacing: 0px;
                                            Rectangle { height: 6px; }
                                            Rectangle { height: 34px; border-radius: 10px; background: PhantomTheme.surface; border-width: 1px; border-color: root.hello_available ? #ffffff10 : #ffffff08;
                                                HorizontalLayout { alignment: center; spacing: 8px;
                                                    Text { text: "●"; color: root.hello_available ? PhantomTheme.success : PhantomTheme.text-dim; font-size: 9px; vertical-alignment: center; }
                                                    Text { text: root.hello_available ? (root.ui_lang == "bn" ? "Windows Hello দিয়ে খুলুন" : "Unlock with Windows Hello") : (root.ui_lang == "bn" ? "Windows Hello এনরোল নেই · পাসফ্রেজ ব্যবহার করুন" : "Windows Hello not enrolled · use the passphrase"); color: root.hello_available ? PhantomTheme.text-muted : PhantomTheme.text-dim; font-size: 12px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                                                }
                                                TouchArea { mouse-cursor: pointer; clicked => { if root.hello_available { root.request_biometric_unlock(); } else { root.unlock_error_message = root.ui_lang == "bn" ? "আগে সেটিংসে Windows Hello চালু করুন।" : "Enroll Windows Hello in Settings to unlock with it."; } } }
                                            }
                                        }
                                        if root.unlock_error_message != "" : Text { text: root.unlock_error_message; color: PhantomTheme.error; font-size: 11px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
                                    }
                                    // app PIN
                                    if root.pin_available && root.unlock_tab == 1 : VerticalLayout { spacing: 7px;
                                        Text { text: "APP PIN"; color: PhantomTheme.text-muted; font-size: 10px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 1px; }
                                        pin_input := LineEdit { placeholder-text: root.ui_lang == "bn" ? "৪–৮ সংখ্যার পিন…" : "4–8 digit PIN…"; input-type: password; height: 44px; font-size: 16px; font-family: "JetBrains Mono"; horizontal-alignment: center; accepted(text) => { root.request_pin_unlock(text); } }
                                        if root.pin_error != "" : Text { text: root.pin_error; font-size: 11px; font-weight: 600; color: PhantomTheme.error; horizontal-alignment: center; wrap: word-wrap; }
                                        PrimaryGradientAction { label: root.ui_lang == "bn" ? "পিন দিয়ে খুলুন" : "Unlock with PIN"; shortcut: "↵"; clicked => { root.request_pin_unlock(pin_input.text); } }
                                    }
                                    // recovery shards
                                    if root.unlock_tab == 2 && root.show_recover : VerticalLayout { spacing: 7px;
                                        Text { text: "RECOVERY SHARDS"; color: PhantomTheme.text-muted; font-size: 10px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 1px; }
                                        LineEdit { placeholder-text: "Shard A (PHANTOM-n …)"; input-type: root.show_recover_shards ? text : password; text <=> root.recover_1; height: 38px; font-family: "JetBrains Mono"; }
                                        LineEdit { placeholder-text: "Shard B (PHANTOM-n …)"; input-type: root.show_recover_shards ? text : password; text <=> root.recover_2; height: 38px; font-family: "JetBrains Mono"; }
                                        LineEdit { placeholder-text: "Shard C (PHANTOM-n …)"; input-type: root.show_recover_shards ? text : password; text <=> root.recover_3; height: 38px; font-family: "JetBrains Mono"; }
                                        HorizontalLayout { spacing: 8px;
                                            AuraButton { label: root.show_recover_shards ? "Hide" : "Show"; width: 84px; height: 28px; clicked => { root.show_recover_shards = !root.show_recover_shards; } }
                                            AuraButton { label: "Clear"; width: 84px; height: 28px; clicked => { root.recover_1 = ""; root.recover_2 = ""; root.recover_3 = ""; } }
                                            Rectangle { horizontal-stretch: 1; }
                                            Text { text: "3 of 5"; color: PhantomTheme.text-dim; font-size: 10px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                                        }
                                        PrimaryGradientAction { label: root.ui_lang == "bn" ? "পুনর্গঠন ও খুলুন" : "Rebuild & Unlock"; enabled: root.recover_1 != "" && root.recover_2 != "" && root.recover_3 != ""; clicked => { root.recover_with_shards(root.recover_1, root.recover_2, root.recover_3); } }
                                    }
                                    if root.integrity_warning != "" : Rectangle { height: 38px; border-radius: 8px; background: #ffb4ab12; border-width: 1px; border-color: #ffb4ab55;
                                        HorizontalLayout { padding: 7px; spacing: 8px;
                                            Text { text: "⚠"; color: PhantomTheme.error; font-size: 13px; vertical-alignment: center; }
                                            Text { text: root.integrity_warning; color: PhantomTheme.error; font-size: 11px; font-weight: 600; horizontal-stretch: 1; wrap: word-wrap; vertical-alignment: center; }
                                        }
                                    }
                                }
                                Rectangle { height: 10px; }
                                Rectangle { height: 1px; background: #ffffff10; }
                                Rectangle { height: 8px; }
                                HorizontalLayout { spacing: 14px;
                                    LinkAction { label: root.ui_lang == "bn" ? "পাসফ্রেজ হারিয়েছেন? শার্ড দিয়ে উদ্ধার" : "Lost passphrase? Recover with shards"; clicked => { root.unlock_tab = 2; root.show_recover = true; root.show_pin_pad = false; } }
                                    Rectangle { horizontal-stretch: 1; }
                                    if root.has_vault_file : LinkAction { label: root.ui_lang == "bn" ? "ভল্ট মুছে নতুন শুরু…" : "Shred & start over…"; clicked => { root.factory_reset_start(); } }
                                }
                                if root.duress_armed : Rectangle { height: 26px; border-radius: 7px; background: #93000a33; border-width: 1px; border-color: #ffb4ab33;
                                    HorizontalLayout { alignment: center; spacing: 6px;
                                        Text { text: "⚠"; color: PhantomTheme.error; font-size: 11px; vertical-alignment: center; }
                                        Text { text: root.ui_lang == "bn" ? "ডিউরেস পাসওয়ার্ড সক্রিয় · ডিকয় ভল্ট খুলবে" : "DURESS PASSWORD ARMED · OPENS THE DECOY VAULT"; color: PhantomTheme.error; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.5px; vertical-alignment: center; }
                                    }
                                }
                                Rectangle { height: 6px; }
                                Text { text: "Optional local unlock shortcuts only. Nothing leaves this device unless you enable sync."; color: PhantomTheme.text-dim; font-size: 9px; horizontal-alignment: center; wrap: word-wrap; }
                            }
                        }
                        }
                    }
                }
            }

            // ---- cryptographic footer
            Rectangle { height: 1px; background: #ffffff0f; }
            Rectangle { height: 30px; background: #0b1326e8;
                HorizontalLayout { padding-left: 22px; padding-right: 22px; spacing: 14px;
                    Text { text: "● LOCAL-FIRST · SYNC OFF BY DEFAULT"; color: PhantomTheme.success; font-size: 9px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                    Text { text: "Argon2id 64 MiB · t=3 · p=4"; color: PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                    Text { text: "XChaCha20-Poly1305"; color: PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "v" + root.app_version + " · MIT · OPEN SOURCE"; color: PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                }
            }
        }
    }
    // ==== First-run onboarding carousel (no vault on disk yet) ====
    if !root.is_unlocked && root.show_onboarding : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: PhantomTheme.canvas;
        TouchArea { mouse-cursor: default; }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 480px;
                    background: PhantomTheme.surface;
                    border-radius: 18px;
                    border-width: 1px;
                    border-color: PhantomTheme.primary;
                    drop-shadow-blur: 36px;
                    drop-shadow-color: #00000088;
                    VerticalLayout { padding: 28px; spacing: 14px;
                        HorizontalLayout { alignment: center; spacing: 8px;
                            TouchArea { mouse-cursor: pointer; clicked => { root.ob_error = ""; root.onboarding_step = 1; }
                                Text { text: root.onboarding_step >= 1 ? "●" : "○"; color: PhantomTheme.primary; font-size: 12px; } }
                            TouchArea { mouse-cursor: pointer; clicked => { root.ob_error = ""; root.onboarding_step = 2; }
                                Text { text: root.onboarding_step >= 2 ? "●" : "○"; color: PhantomTheme.primary; font-size: 12px; } }
                            TouchArea { mouse-cursor: pointer; clicked => { if root.ob_shards_ok { root.ob_error = ""; root.onboarding_step = 3; } else { root.ob_error = "⚠️ Please tick the box on step 2 first."; } }
                                Text { text: root.onboarding_step >= 3 ? "●" : "○"; color: PhantomTheme.primary; font-size: 12px; } }
                            Text { text: "  Step " + root.onboarding_step + " of 3"; color: PhantomTheme.text-dim; font-size: 11px; font-weight: 700; }
                        }
                        if root.onboarding_step == 1 : VerticalLayout { spacing: 10px;
                            Text { text: "🛡️"; font-size: 44px; horizontal-alignment: center; }
                            Text { text: "Welcome to PhantomVault"; color: PhantomTheme.text; font-size: 20px; font-weight: 900; horizontal-alignment: center; }
                            Text { text: "Zero-knowledge & post-quantum protected. Your secrets are encrypted on YOUR machine before they go anywhere — no cloud, no accounts, no tracking."; color: PhantomTheme.text-muted; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                        }
                        if root.onboarding_step == 2 : VerticalLayout { spacing: 10px;
                            Text { text: "🔑"; font-size: 44px; horizontal-alignment: center; }
                            Text { text: "Your Master Password is your ONLY key"; color: PhantomTheme.text; font-size: 18px; font-weight: 900; horizontal-alignment: center; wrap: word-wrap; }
                            Text { text: "We never store or transmit it. If you lose it AND your recovery shards, nobody — not even us — can open your vault."; color: PhantomTheme.text-muted; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                            HorizontalLayout { spacing: 8px; alignment: center;
                                Rectangle { height: 40px; horizontal-stretch: 1;
                                    CheckBox { text: "I understand — shards can be re-exported anytime in Settings"; checked <=> root.ob_shards_ok; y: 8px; x: 12px; }
                                }
                            }
                            Text { text: "📄 Right after setup you will get ONE prompt to print your 5 recovery shards. Do not skip it."; color: PhantomTheme.warning; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                        }
                        if root.onboarding_step == 3 : VerticalLayout { spacing: 10px;
                            Text { text: "🔐 Create your Master Password"; color: PhantomTheme.text; font-size: 18px; font-weight: 900; horizontal-alignment: center; }
                            ob_new := LineEdit { placeholder-text: "New master password (8 min, 12+ recommended)…"; input-type: password; height: 42px; text <=> root.ob_new_text; edited(text) => { root.ob_pw_changed(text); } accepted(text) => { ob_confirm.focus(); } }
                            ob_confirm := LineEdit { placeholder-text: "Confirm master password…"; input-type: password; height: 42px; text <=> root.ob_confirm_text; accepted(text) => {
                                if root.ob_new_text == "" || root.ob_confirm_text == "" { root.ob_error = "⚠️ Type the password twice to confirm."; }
                                else if root.ob_new_text != root.ob_confirm_text { root.ob_error = "⚠️ Passwords do not match."; }
                                else if root.ob_new_text.character-count < 8 { root.ob_error = "⚠️ Minimum 8 characters (12+ recommended)."; }
                                else { root.ob_error = ""; root.unlock_requested(root.ob_new_text); }
                            } }
                            HorizontalLayout { spacing: 8px;
                                Text { text: root.ob_strength_label; color: root.ob_strength_frac < 0.28 ? PhantomTheme.error : (root.ob_strength_frac < 0.5 ? PhantomTheme.warning : (root.ob_strength_frac < 0.8 ? PhantomTheme.success : PhantomTheme.secondary)); font-size: 12px; font-weight: 800; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            Rectangle { background: PhantomTheme.surface-high; border-radius: 5px; height: 10px; clip: true;
                                Rectangle { width: parent.width * root.ob_strength_frac; height: 10px; border-radius: 5px; background: root.ob_strength_frac < 0.28 ? PhantomTheme.error : (root.ob_strength_frac < 0.5 ? PhantomTheme.warning : (root.ob_strength_frac < 0.8 ? PhantomTheme.success : PhantomTheme.secondary)); }
                            }
                            Text { text: "12+ chars · upper + lower + digit + symbol = strongest"; color: PhantomTheme.text-muted; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                            Rectangle { height: 1px; background: PhantomTheme.border; }
                            Text { text: "OR RESTORE AN EXISTING VAULT FROM GITHUB"; color: PhantomTheme.secondary; font-size: 10px; font-weight: 800; font-family: "JetBrains Mono"; letter-spacing: 0.6px; horizontal-alignment: center; }
                            HorizontalLayout { spacing: 8px;
                                LineEdit { placeholder-text: "Owner (github username)"; text <=> root.ob_gh_owner; height: 36px; horizontal-stretch: 1; }
                                LineEdit { placeholder-text: "Repo (private vault repo)"; text <=> root.ob_gh_repo; height: 36px; horizontal-stretch: 1; }
                            }
                            LineEdit { placeholder-text: "PAT (classic token, repo scope)"; input-type: password; text <=> root.ob_gh_token; height: 36px; }
                            AuraButton { label: root.ob_gh_busy ? "Pulling…" : "Restore from GitHub"; width: 220px; height: 38px; enabled: !root.ob_gh_busy && root.ob_gh_owner != "" && root.ob_gh_repo != "" && root.ob_gh_token != ""; clicked => { root.ob_gh_busy = true; root.ob_gh_status = ""; root.restore_from_github(root.ob_gh_owner, root.ob_gh_repo, root.ob_gh_token); } }
                            if root.ob_gh_status != "" : Text { text: root.ob_gh_status; color: PhantomTheme.secondary; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                            Text { text: "Downloads the encrypted vault only. Unlock it with the OLD master password; a device-bound vault also needs its pq_decapsulation.dpapi."; color: PhantomTheme.text-dim; font-size: 9px; horizontal-alignment: center; wrap: word-wrap; }
                            if root.ob_error != "" : Text { text: root.ob_error; color: PhantomTheme.error; font-size: 12px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                        }
                        HorizontalLayout { spacing: 8px; alignment: center;
                            if root.onboarding_step > 1 : AuraButton { label: "◀ Back"; width: 110px; height: 40px; clicked => { root.ob_error = ""; root.onboarding_step = root.onboarding_step - 1; } }
                            if root.onboarding_step < 3 : AuraButton { label: "Next ▶"; primary: true; width: 130px; height: 40px; clicked => { if root.onboarding_step == 2 && !root.ob_shards_ok { root.ob_error = "⚠️ Please tick the box above — this cannot be undone later."; } else { root.ob_error = ""; root.onboarding_step = root.onboarding_step + 1; } } }
                            if root.onboarding_step == 3 : AuraButton { label: "🚀 Create Vault"; primary: true; width: 170px; height: 40px; clicked => {
                                if root.ob_new_text == "" || root.ob_confirm_text == "" { root.ob_error = "⚠️ Type the password twice to confirm."; }
                                else if root.ob_new_text != root.ob_confirm_text { root.ob_error = "⚠️ Passwords do not match."; }
                                else if root.ob_new_text.character-count < 8 { root.ob_error = "⚠️ Minimum 8 characters (12+ recommended)."; }
                                else { root.ob_error = ""; root.unlock_requested(root.ob_new_text); }
                            } }
                        }
                        HorizontalLayout { alignment: center;
                            // PR-2: mandatory setup — no vault file ⇒ Skip jumps to Step 3 (Create).
                            if !root.has_vault_file : AuraButton { label: "Continue to password ▶"; width: 170px; height: 30px; clicked => { root.ob_error = ""; root.onboarding_step = 3; } }
                            if root.has_vault_file : AuraButton { label: "Skip tour"; width: 110px; height: 30px; clicked => { root.show_onboarding = false; } }
                        }
                    }
                }
            }
        }
    }

    // ================= APP SHELL — STRICT 3-COLUMN =================
    // Width straight from the Window (NOT parent: parent is the `if`
    // wrapper, which sizes to content and starves the shell). Window size
    // is external (user/maximized), so this cannot loop.
    if root.is_unlocked : HorizontalLayout {
        width: root.width;
        height: root.height;
        spacing: 0px;

        // 1. Column 1: Sidebar (256px, 64px collapsed) — Aegis vault rail
        Rectangle {
            width: root.sidebar_collapsed ? 64px : 256px;
            background: PhantomTheme.surface-lowest;
            VerticalLayout { spacing: 0px;
                // brand header (56px)
                Rectangle { height: 56px; background: PhantomTheme.surface-lowest;
                    // Collapsed rail: stack the mark and the expand chevron.
                    // Side by side they need 92px, so the 64px rail clipped
                    // the only control that could reopen the sidebar.
                    if root.sidebar_collapsed : VerticalLayout { spacing: 0px; alignment: center; padding-top: 3px;
                        Rectangle { width: 28px; height: 28px; border-radius: 8px; background: PhantomTheme.primary; Text { text: "P"; color: PhantomTheme.on-primary; font-size: 15px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } }
                        AuraButton { label: "»"; width: 40px; height: 20px; clicked => { root.sidebar_collapsed = false; } }
                    }
                    if !root.sidebar_collapsed : HorizontalLayout { padding-left: 14px; padding-right: 8px; spacing: 10px;
                        Rectangle { width: 34px; height: 34px; border-radius: 9px; background: PhantomTheme.primary; Text { text: "P"; color: PhantomTheme.on-primary; font-size: 17px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } }
                        VerticalLayout { spacing: 0px; Text { text: "PHANTOM VAULT"; color: PhantomTheme.text; font-size: 13px; font-weight: 900; letter-spacing: -0.2px; } Text { text: "v" + root.app_version + " · " + (root.pq_paranoid_on ? "PQ ENCLAVE" : "NATIVE VAULT"); color: PhantomTheme.primary; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.5px; } }
                        Rectangle { horizontal-stretch: 1; }
                        AuraButton { label: "«"; width: 26px; height: 26px; clicked => { root.sidebar_collapsed = true; } }
                    }
                }
                // enclave mode (honest: local mode, not "airgapped")
                if !root.sidebar_collapsed : Rectangle { height: 50px;
                    VerticalLayout { padding-left: 12px; padding-right: 12px; padding-top: 6px; spacing: 1px;
                        Text { text: "ENCLAVE MODE"; color: PhantomTheme.text-dim; font-size: 8px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.8px; }
                        HorizontalLayout { spacing: 6px;
                            Text { text: "\u{e9e0}"; color: PhantomTheme.success; font-family: "Material Symbols Outlined"; font-size: 16px; vertical-alignment: center; }
                            Text { text: root.ui_lang == "bn" ? "লোকাল মোড" : "Local mode"; color: PhantomTheme.text; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle { height: 18px; border-radius: 4px; background: PhantomTheme.primary-container; HorizontalLayout { padding-left: 6px; padding-right: 6px; Text { text: "v" + root.app_version; color: PhantomTheme.on-primary; font-size: 8px; font-weight: 800; font-family: "JetBrains Mono"; vertical-alignment: center; } } }
                        }
                    }
                }
                // vault selector
                if !root.sidebar_collapsed : Rectangle { height: 56px;
                    VerticalLayout { padding-left: 10px; padding-right: 10px; padding-top: 4px; padding-bottom: 4px;
                        Rectangle { height: 44px; background: PhantomTheme.surface; border-radius: 8px; border-width: 1px; border-color: PhantomTheme.border;
                            HorizontalLayout { padding-left: 10px; padding-right: 8px; spacing: 8px;
                                Text { text: "◈"; color: PhantomTheme.primary; font-size: 14px; vertical-alignment: center; }
                                VerticalLayout { horizontal-stretch: 1; spacing: 0px;
                                    Text { text: root.ui_lang == "bn" ? "লোকাল ভল্ট" : "Local vault"; color: PhantomTheme.text; font-size: 11px; font-weight: 700; }
                                    Text { text: root.vault_label; color: PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; overflow: elide; }
                                }
                                MonoChip { label: "LOCAL"; tone: PhantomTheme.text-dim; }
                            }
                        }
                    }
                }
                ScrollView { vertical-stretch: 1;
                    VerticalLayout { padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 8px; spacing: 3px;
                        if !root.sidebar_collapsed : Text { text: root.ui_lang == "bn" ? "ভল্ট স্টোরেজ" : "VAULT STORAGE"; color: PhantomTheme.text-dim; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.8px; }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e1a1}"; count: root.count_all; label: root.ui_lang == "bn" ? "সব আইটেম" : "All Items"; active: root.active_nav == 0 && root.type_filter == 0 && !root.show_fav_only && root.folder_filter == "All"; tapped => { root.active_nav = 0; root.type_filter = 0; root.type_filter_changed(0); root.folder_filter = "All"; root.folder_filter_changed("All"); root.fav_filter_changed(false); } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e73c}"; count: root.count_logins; label: root.ui_lang == "bn" ? "লগইন" : "Logins"; active: root.active_nav == 0 && !root.show_fav_only && root.type_filter == 1; tapped => { root.active_nav = 0; root.type_filter = 1; root.type_filter_changed(1); root.fav_filter_changed(false); } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{f87f}"; count: root.count_passkeys; label: root.ui_lang == "bn" ? "পাসকি" : "Passkeys"; tapped => { root.active_nav = 1; } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{f562}"; count: root.count_notes; label: root.ui_lang == "bn" ? "সিকিউর নোট" : "Secure Notes"; active: root.active_nav == 0 && !root.show_fav_only && root.type_filter == 3; tapped => { root.active_nav = 0; root.type_filter = 3; root.type_filter_changed(3); root.fav_filter_changed(false); } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e8a1}"; count: root.count_cards; label: "Cards"; active: root.active_nav == 0 && !root.show_fav_only && root.type_filter == 4; tapped => { root.active_nav = 0; root.type_filter = 4; root.type_filter_changed(4); root.fav_filter_changed(false); } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{ea67}"; count: root.count_identities; label: "Identities"; active: root.active_nav == 0 && !root.show_fav_only && root.type_filter == 5; tapped => { root.active_nav = 0; root.type_filter = 5; root.type_filter_changed(5); root.fav_filter_changed(false); } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e873}"; count: root.count_licenses; label: "Licenses"; active: root.active_nav == 0 && !root.show_fav_only && root.type_filter == 2; tapped => { root.active_nav = 0; root.type_filter = 2; root.type_filter_changed(2); root.fav_filter_changed(false); } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{eb8e}"; count: root.count_ssh; label: root.ui_lang == "bn" ? "SSH ও API কী" : "SSH & API Keys"; active: root.active_nav == 0 && !root.show_fav_only && root.type_filter == 6; tapped => { root.active_nav = 0; root.type_filter = 6; root.type_filter_changed(6); root.fav_filter_changed(false); } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{f09a}"; label: root.ui_lang == "bn" ? "প্রিয়" : "Favorites"; active: root.active_nav == 0 && root.show_fav_only && !root.showing_trash; tapped => { root.active_nav = 0; root.type_filter = 0; root.type_filter_changed(0); root.folder_filter = "All"; root.folder_filter_changed("All"); root.fav_filter_changed(true); } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e92e}"; label: root.trash_label; active: root.active_nav == 0 && root.showing_trash; tapped => { root.show_trash_view(); } }
                        Rectangle { height: 8px; }
                        if !root.sidebar_collapsed : Text { text: root.ui_lang == "bn" ? "নিরাপত্তা ও টুলস" : "SECURITY & TOOLS"; color: PhantomTheme.text-dim; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.8px; }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e9e0}"; label: root.ui_lang == "bn" ? "সিকিউরিটি অডিট" : "Security Audit"; tapped => { root.show_health = true; } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e65f}"; label: root.ui_lang == "bn" ? "পাসওয়ার্ড জেনারেটর" : "Password Generator"; active: root.active_nav == 4; tapped => { root.active_nav = 4; root.regenerate(); } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e425}"; label: root.ui_lang == "bn" ? "২এফএ হাব" : "2FA Hub"; active: root.active_nav == 1; tapped => { root.active_nav = 1; } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e9e0}"; label: "Recovery Kit"; active: root.active_nav == 5; tapped => { root.active_nav = 5; } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e425}"; label: "Audit & Duress"; active: root.active_nav == 6; tapped => { root.active_nav = 6; } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e250}"; label: "Secure Send"; active: root.active_nav == 7; tapped => { root.active_nav = 7; } }
                        Rectangle { height: 8px; }
                        if !root.sidebar_collapsed : Text { text: root.ui_lang == "bn" ? "ইন্টিগ্রেশন ও সিস্টেম" : "INTEGRATION & SYSTEM"; color: PhantomTheme.text-dim; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.8px; }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e250}"; label: root.ui_lang == "bn" ? "এক্সটেনশন ব্রিজ" : "Extension Bridge"; active: root.active_nav == 3; tapped => { root.active_nav = 3; } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e627}"; label: root.ui_lang == "bn" ? "লোকাল সিঙ্ক ও স্টোরেজ" : "Local Sync & Storage"; active: root.active_nav == 3; tapped => { root.active_nav = 3; } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "\u{f090}"; label: root.ui_lang == "bn" ? "ইমপোর্ট" : "Import"; active: root.active_nav == 2; tapped => { root.active_nav = 2; } }
                        NavItem { collapsed: root.sidebar_collapsed; icon: "⚙"; label: root.ui_lang == "bn" ? "সেটিংস" : "Settings"; active: root.active_nav == 3; tapped => { root.active_nav = 3; } }
                        if !root.sidebar_collapsed && root.filter_folders.length > 1 : Text { text: root.ui_lang == "bn" ? "ফোল্ডার" : "FOLDERS"; color: PhantomTheme.text-dim; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.8px; }
                        for f in root.filter_folders : NavItem { collapsed: root.sidebar_collapsed; icon: "\u{e2c7}"; label: f; active: root.active_nav == 0 && root.folder_filter == f; tapped => { root.active_nav = 0; root.folder_filter = f; root.folder_filter_changed(f); } }
                        if !root.sidebar_collapsed : LineEdit { placeholder-text: "+ New folder…"; text <=> root.new_folder_name; height: 28px; accepted(text) => { root.add_folder_requested(text); } }
                        if root.is_travel_mode : Rectangle { height: 26px; border-radius: 6px; background: #f59e0b1a; Text { text: root.ui_lang == "bn" ? "⚠ ট্রাভেল মোড চালু" : "⚠ TRAVEL MODE ON"; color: PhantomTheme.warning; font-size: 9px; font-weight: 800; font-family: "JetBrains Mono"; horizontal-alignment: center; vertical-alignment: center; } }
                        if root.offline_mode : Rectangle { height: 26px; border-radius: 6px; background: #f59e0b1a; Text { text: root.ui_lang == "bn" ? "⚠ অফলাইন" : "⚠ OFFLINE · NO NETWORK"; color: PhantomTheme.warning; font-size: 9px; font-weight: 800; font-family: "JetBrains Mono"; horizontal-alignment: center; vertical-alignment: center; } }
                    }
                }
                Rectangle { height: 1px; background: PhantomTheme.border; }
                if !root.sidebar_collapsed : HorizontalLayout { padding-left: 12px; padding-right: 12px; height: 24px; spacing: 6px;
                    Text { text: "\u{e9e0}"; font-size: 10px; vertical-alignment: center; }
                    Text { text: root.pq_paranoid_on ? "Argon2id + ML-KEM-768" : "Argon2id + XChaCha20"; color: PhantomTheme.text-dim; font-size: 8px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "READY"; color: PhantomTheme.success; font-size: 8px; font-weight: 700; font-family: "JetBrains Mono"; vertical-alignment: center; }
                }
                if !root.sidebar_collapsed : HorizontalLayout { padding-left: 12px; padding-right: 12px; height: 30px; spacing: 6px;
                    Text { text: "●"; color: PhantomTheme.success; font-size: 8px; vertical-alignment: center; }
                    Text { text: root.ui_lang == "bn" ? "লোকাল ইঞ্জিন" : "LOCAL ENGINE"; color: PhantomTheme.text-muted; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.5px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.pq_paranoid_on ? "PQ" : "READY"; color: PhantomTheme.success; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; vertical-alignment: center; }
                }
                HorizontalLayout { padding-left: 10px; padding-right: 10px; padding-bottom: 8px; spacing: 8px;
                    if !root.sidebar_collapsed : VerticalLayout { horizontal-stretch: 1; spacing: 0px;
                        Text { text: root.ui_lang == "bn" ? "লোকাল সেশন" : "LOCAL SESSION"; color: PhantomTheme.text; font-size: 10px; font-weight: 700; }
                        Text { text: root.ui_lang == "bn" ? "আনলকড · এই ডিভাইস" : "UNLOCKED · THIS DEVICE"; color: PhantomTheme.success; font-size: 8px; font-family: "JetBrains Mono"; }
                    }
                    AuraButton { label: "\u{e9e0}"; width: 30px; height: 30px; clicked => { root.lock_now(); } }
                }
                AuraButton { label: root.sidebar_collapsed ? "✈" : (root.is_travel_mode ? "✈ TRAVEL ON" : "✈ Travel: OFF"); primary: !root.is_travel_mode; danger: root.is_travel_mode; height: 28px; clicked => { root.set_travel_mode(!root.is_travel_mode); } }
                if root.portable_badge != "" && !root.sidebar_collapsed : Text { text: root.portable_badge; color: PhantomTheme.success; font-size: 9px; font-family: "JetBrains Mono"; horizontal-alignment: center; }
            }
        }

        // active_nav routing: 0=Vault 3-col, 1=2FA Hub grid, 2=Importer, 3=Settings center
        if root.active_nav == 1 : Rectangle {
            width: root.hub_w * 1px;
            background: PhantomTheme.canvas; horizontal-stretch: 1; vertical-stretch: 1;
            VerticalLayout { padding: 22px; spacing: 14px; horizontal-stretch: 1; vertical-stretch: 1;
                HorizontalLayout { spacing: 8px;
                    LineEdit { placeholder-text: "Search 2FA accounts, issuers…"; text <=> root.totp_search_query; height: 36px; horizontal-stretch: 1; edited(text) => { root.totp_search_changed(text); } }
                    if root.totp_search_query != "" : AuraButton { label: "✕"; width: 40px; height: 36px; clicked => { root.totp_search_query = ""; root.totp_search_changed(""); } }
                    MonoChip { label: "LOCAL CLOCK"; tone: PhantomTheme.success; }
                    AuraButton { label: root.show_totp_next ? "Hide NEXT" : "Show NEXT"; primary: root.show_totp_next; width: 110px; height: 36px; clicked => { root.toggle_totp_next(); } }
                    AuraButton { label: "Export"; width: 90px; height: 36px; clicked => { root.ga_export_start(); } }
                    AuraButton { label: "+ Add 2FA"; primary: true; width: 110px; height: 36px; clicked => { root.show_2fa_import = !root.show_2fa_import; } }
                }
                // KPI strip: real values only (no fake NTP/zero-leak claims).
                HorizontalLayout { spacing: 10px;
                    Rectangle { horizontal-stretch: 1; height: 74px; background: PhantomTheme.surface; border-radius: 10px; border-width: 1px; border-color: PhantomTheme.border; VerticalLayout { padding: 12px; spacing: 1px; Text { text: "ACTIVE 2FA KEYS"; color: PhantomTheme.text-dim; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.6px; } Text { text: root.auth_accounts.length; color: PhantomTheme.text; font-size: 20px; font-weight: 800; } Text { text: "Tokens"; color: PhantomTheme.primary; font-size: 9px; font-family: "JetBrains Mono"; } } }
                    Rectangle { horizontal-stretch: 1; height: 74px; background: PhantomTheme.surface; border-radius: 10px; border-width: 1px; border-color: PhantomTheme.border; VerticalLayout { padding: 12px; spacing: 1px; Text { text: "ALGORITHM STANDARD"; color: PhantomTheme.text-dim; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.6px; } Text { text: "RFC 6238"; color: PhantomTheme.text; font-size: 18px; font-weight: 800; } Text { text: "TOTP · 30s / SHA-1"; color: PhantomTheme.secondary; font-size: 9px; font-family: "JetBrains Mono"; } } }
                    Rectangle { horizontal-stretch: 1; height: 74px; background: PhantomTheme.surface; border-radius: 10px; border-width: 1px; border-color: PhantomTheme.border; VerticalLayout { padding: 12px; spacing: 1px; Text { text: "TIME DRIFT"; color: PhantomTheme.text-dim; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.6px; } Text { text: "LOCAL CLOCK"; color: PhantomTheme.text; font-size: 18px; font-weight: 800; } Text { text: "Offline · no NTP"; color: PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; } } }
                    Rectangle { horizontal-stretch: 1; height: 74px; background: PhantomTheme.surface; border-radius: 10px; border-width: 1px; border-color: PhantomTheme.border; VerticalLayout { padding: 12px; spacing: 1px; Text { text: "PROTECTION"; color: PhantomTheme.text-dim; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.6px; } Text { text: "EPHEMERAL"; color: PhantomTheme.primary; font-size: 18px; font-weight: 800; } Text { text: "Codes derived on demand"; color: PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; } } }
                }
                HorizontalLayout { spacing: 6px;
                    AuraButton { label: "All " + root.auth_accounts.length; primary: root.totp_filter == 0; width: 84px; height: 30px; clicked => { root.totp_filter_changed(0); } }
                    AuraButton { label: "Starred"; primary: root.totp_filter == 1; width: 92px; height: 30px; clicked => { root.totp_filter_changed(1); } }
                    AuraButton { label: "TOTP"; primary: root.totp_filter == 2; width: 72px; height: 30px; clicked => { root.totp_filter_changed(2); } }
                    AuraButton { label: "HOTP"; primary: root.totp_filter == 3; width: 72px; height: 30px; clicked => { root.totp_filter_changed(3); } }
                    AuraButton { label: "STEAM"; primary: root.totp_filter == 4; width: 78px; height: 30px; clicked => { root.totp_filter_changed(4); } }
                    if root.show_totp_next : MonoChip { label: "NEXT ON"; tone: PhantomTheme.success; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: "SORT"; color: PhantomTheme.text-dim; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.6px; vertical-alignment: center; }
                    AuraButton { label: "Vault"; primary: root.totp_sort == 0; width: 66px; height: 30px; clicked => { root.totp_sort_changed(0); } }
                    AuraButton { label: "A-Z"; primary: root.totp_sort == 1; width: 54px; height: 30px; clicked => { root.totp_sort_changed(1); } }
                    AuraButton { label: "Z-A"; primary: root.totp_sort == 2; width: 54px; height: 30px; clicked => { root.totp_sort_changed(2); } }
                }
                hub_scroll := ScrollView { vertical-stretch: 1; horizontal-stretch: 1; VerticalLayout { spacing: 14px;
                    // Landscape grid (rows from Rust, AUTH_GRID_COLS each).
                    // Card width is Rust-fed (hub_px_w) — viewport-capped,
                    // short rows left-align, no binding loop.
                    for row in root.auth_rows : HorizontalLayout { spacing: 14px; horizontal-stretch: 1; alignment: space-between;
                        for acc in row : Rectangle {
                            width: (Math.min(root.hub_px_w, hub_scroll.width / 1px) - 72) / 3 * 1px;
                            background: PhantomTheme.surface;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: PhantomTheme.border;
                            height: 192px;
                            clip: true;
                            TouchArea { mouse-cursor: pointer; clicked => { if acc.code != "" && acc.code != "------" { root.copy_totp_requested(acc.id); } } }
                            VerticalLayout { padding: 12px; spacing: 6px;
                                HorizontalLayout { spacing: 8px;
                                    Rectangle { width: 34px; height: 34px; border-radius: 8px; background: acc.tint;
                                        if acc.has_icon : Image { source: acc.icon_img; width: 24px; height: 24px; image-fit: contain; }
                                        if !acc.has_icon : Text { text: acc.icon; color: PhantomTheme.canvas; font-size: 15px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    VerticalLayout { horizontal-stretch: 1; spacing: 1px;
                                        Text { text: acc.issuer == "" ? acc.name : acc.issuer; color: PhantomTheme.text; font-size: 13px; font-weight: 800; overflow: elide; }
                                        Text { text: acc.name; color: PhantomTheme.text-muted; font-size: 10px; overflow: elide; }
                                    }
                                    if acc.is_dup : MonoChip { label: "DUP"; tone: PhantomTheme.warning; }
                                    MonoChip { label: acc.kind; tone: PhantomTheme.text-dim; }
                                    AuraButton { label: acc.fav ? "★" : "☆"; primary: acc.fav; width: 28px; height: 28px; clicked => { root.toggle_totp_favorite(acc.id); } }
                                }
                                HorizontalLayout { spacing: 8px;
                                    Text { text: acc.display; color: !acc.is_hotp && acc.secs <= 5 ? PhantomTheme.error : PhantomTheme.text; font-size: 26px; font-weight: 900; font-family: "JetBrains Mono"; letter-spacing: 2px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    Rectangle { width: 38px; height: 38px; border-radius: 19px; border-width: 2px; border-color: acc.is_hotp ? PhantomTheme.primary : (acc.secs > 15 ? PhantomTheme.primary : (acc.secs > 5 ? PhantomTheme.warning : PhantomTheme.error));
                                        Text { text: acc.countdown; color: acc.is_hotp ? PhantomTheme.primary : (acc.secs > 15 ? PhantomTheme.primary : (acc.secs > 5 ? PhantomTheme.warning : PhantomTheme.error)); font-size: acc.is_hotp ? 9px : 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                if root.show_totp_next : Text { text: acc.next_label; color: PhantomTheme.text-dim; font-size: 10px; font-family: "JetBrains Mono"; overflow: elide; }
                                Text { text: acc.params; color: PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; letter-spacing: 0.4px; overflow: elide; }
                                if !acc.is_hotp : Rectangle { background: PhantomTheme.surface-high; border-radius: 2px; height: 4px; clip: true;
                                    Rectangle { background: acc.secs > 15 ? PhantomTheme.primary : (acc.secs > 5 ? PhantomTheme.warning : PhantomTheme.error); border-radius: 2px; height: 4px; width: parent.width * acc.secs / 30; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                HorizontalLayout { spacing: 6px;
                                    AuraButton { label: root.last_copied == acc.code && root.last_copied != "" ? "✓ Copied" : "📋 Copy Code"; primary: root.last_copied == acc.code && root.last_copied != ""; enabled: acc.is_hotp || acc.secs > 3; height: 30px; horizontal-stretch: 1; clicked => { root.copy_totp_requested(acc.id); } }
                                    if acc.is_hotp : AuraButton { label: "🔄"; width: 34px; height: 30px; clicked => { root.hotp_next(acc.id); } }
                                    AuraButton { label: root.confirm_delete_auth_id == acc.id ? "Sure?" : "🗑"; width: root.confirm_delete_auth_id == acc.id ? 60px : 34px; height: 30px; danger: true; clicked => { if root.confirm_delete_auth_id == acc.id { root.confirm_delete_auth_id = ""; root.delete_auth_account(acc.id); } else { root.confirm_delete_auth_id = acc.id; } } }
                                }
                            }
                        }
                    }
                    if root.auth_rows.length == 0 : VerticalLayout { spacing: 8px; alignment: center; padding-top: 30px;
                        Text { text: "🔑"; font-size: 44px; horizontal-alignment: center; }
                        Text { text: root.auth_accounts.length == 0 ? "No 2FA accounts yet — scan a QR or paste a key." : "No accounts match this filter or search."; color: PhantomTheme.text-dim; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                        HorizontalLayout { alignment: center; AuraButton { label: "+ Add 2FA"; primary: true; width: 150px; height: 36px; clicked => { root.show_2fa_import = !root.show_2fa_import; } } }
                    }
                    Text { text: "🔑  Resident Passkeys (WebAuthn)"; color: PhantomTheme.text; font-size: 15px; font-weight: 900; }
                    HorizontalLayout { spacing: 8px; LineEdit { placeholder-text: "Relying party (github.com)"; text <=> root.pk_rp; height: 36px; horizontal-stretch: 1; accepted(text) => { if root.pk_rp != "" && root.pk_user != "" { root.register_passkey(root.pk_rp, root.pk_user); } } } LineEdit { placeholder-text: "Username"; text <=> root.pk_user; height: 36px; horizontal-stretch: 1; accepted(text) => { if root.pk_rp != "" && root.pk_user != "" { root.register_passkey(root.pk_rp, root.pk_user); } } } AuraButton { label: "+ Register"; primary: true; width: 130px; enabled: root.pk_rp != "" && root.pk_user != ""; clicked => { root.register_passkey(root.pk_rp, root.pk_user); } } }
                    VerticalLayout { spacing: 8px;
                        for pk in root.passkeys : Rectangle { background: PhantomTheme.surface; border-radius: 12px; border-width: 1px; border-color: PhantomTheme.border; height: 64px;
                            HorizontalLayout { padding: 12px; spacing: 10px; alignment: space-between;
                                VerticalLayout { spacing: 1px; Text { text: "🔑 " + pk.rp + " • " + pk.user; color: PhantomTheme.text; font-size: 13px; font-weight: 700; overflow: elide; } Text { text: pk.meta; color: PhantomTheme.text-dim; font-size: 11px; overflow: elide; } }
                                HorizontalLayout { spacing: 8px; alignment: center; AuraButton { label: pk.fav ? "⭐" : "☆"; width: 44px; height: 32px; clicked => { root.toggle_passkey_fav(pk.id); } } AuraButton { label: "📋 Copy key"; width: 110px; height: 32px; clicked => { root.copy_passkey_pub(pk.id); } } AuraButton { label: root.confirm_delete_pk_id == pk.id ? "Sure?" : "🗑"; width: root.confirm_delete_pk_id == pk.id ? 72px : 44px; height: 32px; danger: true; clicked => { if root.confirm_delete_pk_id == pk.id { root.confirm_delete_pk_id = ""; root.delete_passkey(pk.id); } else { root.confirm_delete_pk_id = pk.id; } } } }
                            }
                        }
                        if root.passkeys.length == 0 : Text { text: "No passkeys yet — register one above."; color: PhantomTheme.text-dim; font-size: 12px; horizontal-alignment: center; }
                        if root.passkeys_trash.length > 0 : VerticalLayout { spacing: 8px;
                            Text { text: "🗑️ Passkey Trash (shredded after 30 days)"; color: PhantomTheme.error; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                            for pk in root.passkeys_trash : Rectangle { background: PhantomTheme.surface; border-radius: 12px; border-width: 1px; border-color: #ffb4ab55; height: 64px;
                                HorizontalLayout { padding: 12px; spacing: 10px; alignment: space-between;
