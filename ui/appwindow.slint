import { Button, CheckBox, ComboBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-Black.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/NotoSansBengali-Regular.ttf";
import "fonts/MaterialSymbolsOutlined.ttf";

// =============================================================================
// PHANTOM VAULT — "Phantom Aura" design system
// Deep navy + mint + electric cyan. All property/callback names are a
// frozen contract with src/main.rs — NEVER rename them (UI-only redesign).
// =============================================================================

// Unified row for all item kinds. kind: 1 login, 2 license, 3 note,
// 4 card, 5 identity, 6 ssh, 8 standalone 2FA. user=subtitles,
// secret=protected value, meta=short aux (expiry/phone/fingerprint),
// url+notes as applicable.
struct CredentialView {
    id: string,
    kind: int,
    title: string,
    username: string,
    password: string,
    meta: string,
    url: string,
    notes: string,
    folder: string,
    totp: string,
    health: string,
    strength: float,
    badge: string,
    age: string,
    tags: string,
    ts: float,
    fav: bool,
    sel: bool,
    has_icon: bool,
    icon: image,
    verified: bool,
}

// Retired password row (secret rides along for the copy button; RAM-only).
struct HistoryView {
    password: string,
    when: string,
}

// Bitwarden-style custom field. ftype: 0 text, 1 hidden, 2 checkbox.
struct CustomFieldView {
    name: string,
    value: string,
    ftype: int,
}

// Sealed file attachment row.
struct AttachmentView {
    id: string,
    filename: string,
    size: string,
}

// Vault-health audit row. sev: -1 section header (id ""), 0 breached,
// 1 reused, 2 weak, 3 stale. flags = short chip text, never secrets.
// rotation = vault-side rotation-loop progress ("", pending, updated, done).
struct HealthRow {
    id: string,
    title: string,
    flags: string,
    sev: int,
    rotation: string,
}

// Authenticator account row. kind: "TOTP" | "HOTP" | "STEAM".
// display = grouped code for the big digits ("513 710"), next = upcoming
// code, icon = brand letter, tint = brand color (all preformatted in Rust).
struct AuthView {
    id: string,
    name: string,
    issuer: string,
    code: string,
    display: string,
    next: string,
    icon: string,
    // Favicon (same cache as the login list); letter circle fallback.
    has_icon: bool,
    icon_img: image,
    tint: color,
    kind: string,
    // Honest read-only parameters: "30s · SHA-1 · 6 digits".
    params: string,
    is_hotp: bool,
    // Per-card live countdown: seconds left (TOTP) / -1 (HOTP) + label.
    secs: int,
    countdown: string,
    fav: bool,
    // Self-describing revealed-next label, e.g. "NEXT in 12s · 481 902".
    // Kept as one string so Rust owns the wording and the two numbers on the
    // card can never be re-paired by a layout change.
    next_label: string,
    // Another card in the vault shares this (issuer, name) — the secrets differ.
    is_dup: bool,
    dup_of: string,
}

// Resident passkey row. meta is preformatted ("3 signs").
struct PasskeyView {
    id: string,
    rp: string,
    user: string,
    meta: string,
    fav: bool,
}

// LAN peer row (name + ip preformatted in Rust; detail = version • ephemeral id).
struct PeerView {
    name: string,
    ip: string,
    detail: string,
}

// A15b: paired-device row. `key` is the Ed25519 public key (forget handle).
struct PairedView {
    name: string,
    key: string,
    detail: string,
}

// A20: active outgoing share row (`id` is the revoke handle).
struct SendView {
    id: string,
    detail: string,
}

// --- Aegis palette: generated source is design/tokens.json ---
// Do not add new raw hex values here without updating that file and running
// scripts/check_ui_tokens.ps1. P0 will sweep components onto these tokens.
global PhantomTheme {
    // Design tokens (frontmatter palette, see docs/UI_PARITY_MAP.md §18).
    in-out property <color> canvas: #0b1326;
    in-out property <color> surface-lowest: #060e20;
    in-out property <color> surface-low: #131b2e;
    in-out property <color> surface: #171f33;
    in-out property <color> surface-high: #222a3d;
    in-out property <color> surface-highest: #2d3449;
    in-out property <color> border: #3c4a42;
    in-out property <color> border-strong: #86948a;
    in-out property <color> text: #dae2fd;
    in-out property <color> text-muted: #bbcabf;
    in-out property <color> text-dim: #86948a;
    in-out property <color> primary: #4edea3;
    in-out property <color> primary-container: #10b981;
    in-out property <color> on-primary: #003824;
    in-out property <color> secondary: #4cd7f6;
    in-out property <color> on-secondary: #003640;
    in-out property <color> success: #4edea3;
    in-out property <color> on-success: #003824;
    in-out property <color> error: #ffb4ab;
    in-out property <color> on-error: #690005;
    in-out property <color> warning: #f59e0b;

    // Compatibility aliases used by the current 624 raw-hex call sites.
    // They intentionally point at the new semantic tokens so a later sweep
    // can replace names without a second palette decision.
    in-out property <color> void: #0b1326;
    in-out property <color> abyss: #131b2e;
    in-out property <color> panel: #171f33;
    in-out property <color> card: #222a3d;
    in-out property <color> edge: #3c4a42;
    in-out property <color> aura: #4edea3;
    in-out property <color> pulse: #4cd7f6;
    in-out property <color> ink: #dae2fd;
    in-out property <color> mist: #bbcabf;
    in-out property <color> dim: #86948a;
    in-out property <color> good: #4edea3;
    in-out property <color> warn: #f59e0b;
    in-out property <color> bad: #ffb4ab;
}

// --- Small reusable atoms (pure visual, no logic) ---
component AuraButton inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> primary: false;
    in-out property <bool> danger: false;
    // Disabled state is VISIBLE, not just inert: a silently-ignored click on
    // a control the user can still see reads as a broken app. Defaults to true
    // so every existing call site is unchanged.
    in-out property <bool> enabled: true;
    callback clicked();
    height: 38px;
    border-radius: 10px;
    opacity: root.enabled ? 1.0 : 0.38;
    background: root.primary ? PhantomTheme.primary : (root.danger ? #ffb4ab1a : PhantomTheme.surface);
    border-width: 1px;
    border-color: root.primary ? PhantomTheme.primary-container : (root.danger ? #ffb4ab55 : PhantomTheme.border);
    drop-shadow-blur: root.primary ? 18px : 0px;
    drop-shadow-color: #4edea333;
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        // Belt and braces: even if a caller forgets the `enabled` guard in its
        // own `clicked` body, the callback cannot fire while disabled.
        clicked => { if root.enabled { root.clicked(); } }
    }
    Text {
        text: root.label;
        color: root.primary ? PhantomTheme.on-primary : (root.danger ? PhantomTheme.error : PhantomTheme.text);
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    states [
        pressed when area.pressed : {
            background: root.primary ? PhantomTheme.primary-container : PhantomTheme.surface-high;
        }
        hover when area.has-hover : {
            border-color: root.primary ? PhantomTheme.primary : PhantomTheme.secondary;
        }
    ]
}

// --- Login / cryptographic gateway atoms (design: login page mockup) ---
component MonoChip inherits Rectangle {
    in-out property <string> label;
    in-out property <color> tone: PhantomTheme.text-dim;
    in-out property <bool> outlined: true;
    height: 22px;
    border-radius: 6px;
    background: #ffffff08;
    border-width: root.outlined ? 1px : 0px;
    border-color: #ffffff14;
    HorizontalLayout { padding-left: 8px; padding-right: 8px; Text { text: root.label; color: root.tone; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.5px; vertical-alignment: center; } }
}

component GatewayTab inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> active: false;
    callback clicked();
    height: 34px;
    border-radius: 8px;
    background: root.active ? PhantomTheme.primary-container : transparent;
    Text { text: root.label; color: root.active ? #ffffff : PhantomTheme.text-dim; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component LinkAction inherits Rectangle {
    in-out property <string> label;
    callback clicked();
    background: transparent;
    height: 24px;
    Text { text: root.label; color: link_area.has-hover ? PhantomTheme.primary : PhantomTheme.text-dim; font-size: 12px; vertical-alignment: center; }
    link_area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component StatusRow inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> on: true;
    in-out property <string> chip: "";
    background: transparent;
    height: 26px;
    HorizontalLayout { spacing: 8px;
        Rectangle { width: 16px; height: 16px; border-radius: 4px; background: root.on ? PhantomTheme.primary-container : transparent; border-width: 1px; border-color: root.on ? PhantomTheme.primary : PhantomTheme.border; Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
        Text { text: root.label; color: PhantomTheme.text-muted; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if root.chip != "" : MonoChip { label: root.chip; tone: root.on ? PhantomTheme.success : PhantomTheme.text-dim; }
    }
}

component PrimaryGradientAction inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> enabled: true;
    in-out property <string> shortcut: "";
    in-out property <string> glyph: "";
    callback clicked();
    height: 46px;
    border-radius: 10px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: @linear-gradient(90deg, #4edea3 0%, #10b981 50%, #4edea3 100%);
    border-width: 1px;
    border-color: #4edea34d;
    drop-shadow-blur: 26px;
    drop-shadow-color: #10b98155;
    Text { text: root.glyph == "" ? root.label : root.glyph + "  " + root.label; color: #ffffff; font-size: 15px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    if root.shortcut != "" : Rectangle { x: parent.width - 72px; y: (parent.height - 20px) / 2; width: 56px; height: 20px; border-radius: 4px; background: #00000055; border-width: 1px; border-color: #ffffff1f;
        Text { text: root.shortcut; color: #dae2fd; font-size: 10px; font-family: "JetBrains Mono"; horizontal-alignment: center; vertical-alignment: center; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { if root.enabled { root.clicked(); } } }
}

component NavItem inherits Rectangle {
    in-out property <string> icon;
    in-out property <string> label;
    in-out property <bool> active: false;
    in-out property <bool> collapsed: false;
    in-out property <int> count: 0;
    callback tapped();
    height: 38px;
    border-radius: 4px;
    background: root.active ? PhantomTheme.primary-container : transparent;
    border-width: 0px;
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.tapped(); }
    }
    HorizontalLayout {
        padding-left: root.collapsed ? 0px : 10px;
        padding-right: root.collapsed ? 0px : 10px;
        spacing: 8px;
        alignment: root.collapsed ? center : start;
        Text {
            text: root.icon;
            color: root.active ? PhantomTheme.on-primary : PhantomTheme.text-muted;
            font-family: "Material Symbols Outlined";
            font-size: 18px;
            vertical-alignment: center;
        }
        if !root.collapsed : Text {
            text: root.label;
            color: root.active ? PhantomTheme.on-primary : PhantomTheme.text-muted;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if !root.collapsed && root.count > 0 : Text { text: root.count; color: root.active ? PhantomTheme.on-primary : PhantomTheme.text-dim; font-size: 11px; font-family: "JetBrains Mono"; vertical-alignment: center; }
    }
    states [
        hover when area.has-hover : {
            background: PhantomTheme.surface;
        }
    ]
}

component FieldLabel inherits Text {
    font-size: 11px;
    font-weight: 700;
    color: PhantomTheme.text-dim;
    letter-spacing: 1px;
}

// Phase 26: ephemeral secret field. Peep OFF → classic eye toggle (sticky).
// Peep ON → value exists ONLY while the HOLD pad is physically pressed;
// release/leave snaps back to dots instantly (no framing window for cameras).
component MoireVeil inherits Rectangle {
    background: transparent;
    clip: true;
    TouchArea { mouse-cursor: default; }
    for i in 72 : Rectangle {
        x: i * 8px;
        width: 1px;
        height: parent.height;
        background: #ffffff10;
    }
}

component GeneratorPanel inherits Rectangle {
    width: 460px;
    // height grows with content (no fixed height → never overflows taskbar)
    background: PhantomTheme.surface;
    border-radius: 16px;
    border-width: 1.5px;
    border-color: PhantomTheme.primary;
    drop-shadow-blur: 40px;
    drop-shadow-color: #4edea344;

    in-out property <int> gen_length;
    in-out property <bool> gen_uppercase;
    in-out property <bool> gen_lowercase;
    in-out property <bool> gen_digits;
    in-out property <bool> gen_symbols;
    in-out property <bool> gen_exclude_ambiguous;
    in-out property <bool> gen_diceware_mode;
    in-out property <int> gen_dice_lang;
    in-out property <int> gen_word_count;
    in-out property <string> gen_output;
    in-out property <float> gen_entropy_bits;
    // A26: passed down from MainWindow.
    in-out property <string> ui_lang: "en";

    callback regenerate();
    callback use_password(string);
    callback close_panel();

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        // Header
        HorizontalLayout {
            alignment: space-between;
            Text { text: "🎲  Generator"; font-size: 17px; font-weight: 800; color: PhantomTheme.text; vertical-alignment: center; }
            AuraButton {
                label: "✕";
                width: 34px;
                height: 34px;
                clicked => { root.close_panel(); }
            }
        }

        // Mode segmented control
        Rectangle {
            background: PhantomTheme.surface-low;
            border-radius: 10px;
            height: 42px;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    background: !root.gen_diceware_mode ? PhantomTheme.primary : transparent;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.gen_diceware_mode = false; root.regenerate(); }
                    }
                    Text { text: root.ui_lang == "bn" ? "কমপ্লেক্স" : "Complex"; color: !root.gen_diceware_mode ? PhantomTheme.on-primary : PhantomTheme.text-muted; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    background: root.gen_diceware_mode ? PhantomTheme.primary : transparent;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.gen_diceware_mode = true; root.regenerate(); }
                    }
                    Text { text: root.ui_lang == "bn" ? "ডাইসওয়্যার" : "Diceware"; color: root.gen_diceware_mode ? PhantomTheme.on-primary : PhantomTheme.text-muted; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        if !root.gen_diceware_mode : VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                alignment: space-between;
                FieldLabel { text: root.ui_lang == "bn" ? "দৈর্ঘ্য" : "LENGTH"; vertical-alignment: center; }
                HorizontalLayout {
                    spacing: 8px;
                    AuraButton { label: "−"; width: 34px; height: 32px; enabled: root.gen_length > 8; clicked => { if root.gen_length > 8 { root.gen_length -= 1; root.regenerate(); } } }
                    Text { text: root.gen_length; color: PhantomTheme.secondary; font-size: 15px; font-weight: 800; vertical-alignment: center; min-width: 36px; horizontal-alignment: center; }
                    AuraButton { label: "+"; width: 34px; height: 32px; enabled: root.gen_length < 128; clicked => { if root.gen_length < 128 { root.gen_length += 1; root.regenerate(); } } }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    AuraButton { label: root.gen_uppercase ? "A-Z ✓" : "A-Z"; width: 86px; height: 32px; primary: root.gen_uppercase; clicked => { root.gen_uppercase = !root.gen_uppercase; root.regenerate(); } }
                    AuraButton { label: root.gen_lowercase ? "a-z ✓" : "a-z"; width: 86px; height: 32px; primary: root.gen_lowercase; clicked => { root.gen_lowercase = !root.gen_lowercase; root.regenerate(); } }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    AuraButton { label: root.gen_digits ? "0-9 ✓" : "0-9"; width: 86px; height: 32px; primary: root.gen_digits; clicked => { root.gen_digits = !root.gen_digits; root.regenerate(); } }
                    AuraButton { label: root.gen_symbols ? "#$! ✓" : "#$!"; width: 86px; height: 32px; primary: root.gen_symbols; clicked => { root.gen_symbols = !root.gen_symbols; root.regenerate(); } }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    FieldLabel { text: root.ui_lang == "bn" ? "অস্পষ্ট নয়" : "NO AMBIGUOUS"; horizontal-alignment: center; }
                    AuraButton { label: root.gen_exclude_ambiguous ? "0/O/l ✓" : "0/O/l"; width: 86px; height: 32px; primary: root.gen_exclude_ambiguous; clicked => { root.gen_exclude_ambiguous = !root.gen_exclude_ambiguous; root.regenerate(); } }
                }
            }
        }

        if root.gen_diceware_mode : VerticalLayout { spacing: 8px;
        HorizontalLayout {
            spacing: 4px;
            en_keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == " " { root.gen_dice_lang = 0; root.regenerate(); return accept; }
                    return reject;
                }
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 8px;
                height: 34px;
                background: root.gen_dice_lang == 0 ? PhantomTheme.surface-high : transparent;
                border-width: 1px;
                border-color: root.gen_dice_lang == 0 ? PhantomTheme.secondary : PhantomTheme.border;
                TouchArea { mouse-cursor: pointer; clicked => { root.gen_dice_lang = 0; root.regenerate(); } }
                Text { text: "English (EFF 7776)"; color: root.gen_dice_lang == 0 ? #ffffff : PhantomTheme.text-muted; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            }
            bn_keys := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == " " { root.gen_dice_lang = 1; root.regenerate(); return accept; }
                    return reject;
                }
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 8px;
                height: 34px;
                background: root.gen_dice_lang == 1 ? PhantomTheme.surface-high : transparent;
                border-width: 1px;
                border-color: root.gen_dice_lang == 1 ? PhantomTheme.secondary : PhantomTheme.border;
                TouchArea { mouse-cursor: pointer; clicked => { root.gen_dice_lang = 1; root.regenerate(); } }
                Text { text: "বাংলা 🇧🇩"; color: root.gen_dice_lang == 1 ? #ffffff : PhantomTheme.text-muted; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            }
        }
        HorizontalLayout {
            alignment: space-between;
            FieldLabel { text: root.ui_lang == "bn" ? "শব্দ" : "WORDS"; vertical-alignment: center; }
            HorizontalLayout {
                spacing: 8px;
                AuraButton { label: "−"; width: 34px; height: 32px; enabled: root.gen_word_count > 4; clicked => { if root.gen_word_count > 4 { root.gen_word_count -= 1; root.regenerate(); } } }
                Text { text: root.gen_word_count; color: PhantomTheme.secondary; font-size: 15px; font-weight: 800; vertical-alignment: center; min-width: 30px; horizontal-alignment: center; }
                AuraButton { label: "+"; width: 34px; height: 32px; enabled: root.gen_word_count < 12; clicked => { if root.gen_word_count < 12 { root.gen_word_count += 1; root.regenerate(); } } }
            }
        }}

        // Output well
        Rectangle {
            background: PhantomTheme.surface-low;
            border-radius: 10px;
            border-width: 1px;
            border-color: PhantomTheme.border;
            height: 56px;
            Text {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                text: root.gen_output == "" ? "—" : root.gen_output;
                color: root.gen_output == "" ? PhantomTheme.text-dim : PhantomTheme.secondary;
                font-size: 14px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        // Entropy meter
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                FieldLabel { text: root.ui_lang == "bn" ? "এনট্রপি" : "ENTROPY"; }
                Text {
                    text: Math.round(root.gen_entropy_bits) + (root.ui_lang == "bn" ? " বিট" : " bits");
                    font-size: 12px;
                    font-weight: 800;
                    color: root.gen_entropy_bits > 80 ? PhantomTheme.success : (root.gen_entropy_bits > 60 ? PhantomTheme.warning : PhantomTheme.error);
                }
            }
            Rectangle {
                background: PhantomTheme.surface-low;
                border-radius: 4px;
                height: 8px;
                Rectangle {
                    x: 0;
                    width: Math.min(root.gen_entropy_bits / 128 * (parent.width), parent.width);
                    height: parent.height;
                    border-radius: 4px;
                    background: root.gen_entropy_bits > 80 ? PhantomTheme.success : (root.gen_entropy_bits > 60 ? PhantomTheme.warning : PhantomTheme.error);
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            AuraButton { label: root.ui_lang == "bn" ? "🔄  আবার তৈরি" : "🔄  Regenerate"; horizontal-stretch: 1; clicked => { root.regenerate(); } }
            AuraButton { label: root.ui_lang == "bn" ? "✅  এটি ব্যবহার করুন" : "✅  Use This"; primary: true; horizontal-stretch: 1; enabled: root.gen_output != ""; clicked => { root.use_password(root.gen_output); } }
        }
        if !root.gen_diceware_mode && !root.gen_uppercase && !root.gen_lowercase && !root.gen_digits && !root.gen_symbols : Text { text: root.ui_lang == "bn" ? "⚠️ উপরে অন্তত একটি character set বাছুন।" : "⚠️ Select at least one character set above."; color: PhantomTheme.warning; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
    }
}

export component MainWindow inherits Window {
    default-font-family: "Inter";
    title: "PhantomVault - Zero-Knowledge Native Vault";
    // Explicit default size: without it the window opens at content-minimum
    // width, which strands views narrow on wide screens. Layouts still
    // stretch, so maximize/resize stays fully responsive.
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 620px;
    background: PhantomTheme.canvas;

    // ==== Frozen Rust contract (do not rename) ====
    in-out property <bool> is_unlocked: false;
    in-out property <bool> show_add_form: false;
    in-out property <string> status_text: "Vault is locked. Enter Master Password:";
    // Cat 8: binary self-integrity tripwire (empty = verified clean).
    in-out property <string> integrity_warning: "";
    in-out property <string> live_totp_code: "------";
    in-out property <string> totp_countdown: "30s";
    in-out property <string> hero_account: "LIVE 2FA";
    // Phase 24: authenticator accounts (dynamic algo/digits/type)
    in-out property <[AuthView]> auth_accounts;
    // Grid rows of 3 for the authenticator page (nested model, rebuilt together).
    in-out property <[[AuthView]]> auth_rows;
    // Resident WebAuthn passkeys (hub list + register form + hub trash).
    in-out property <[PasskeyView]> passkeys;
    in-out property <[PasskeyView]> passkeys_trash;
    in-out property <string> pk_rp;
    in-out property <string> pk_user;
