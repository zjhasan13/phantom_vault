                    FieldLabel { text: root.ui_lang == "bn" ? "লোকাল এপিআই (pv CLI)" : "LOCAL API (pv CLI)"; }
                    Text { text: root.ui_lang == "bn" ? "শুধু 127.0.0.1-এ bind করে। আপনি Allow না চাপলে স্ক্রিপ্ট কোনো সিক্রেট পড়তে পারবে না; প্রতিটি read audit-logged, token DPAPI-sealed, ২৪ ঘণ্টায় মেয়াদ শেষ, বন্ধ করলে বাতিল।" : "Binds 127.0.0.1 only. A script reads a secret only after you press Allow in this window; every read is audit-logged, the token is DPAPI-sealed, expires in 24 hours and is revoked when you turn this off."; color: PhantomTheme.text-dim; font-size: 11px; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; Text { text: "Local API (read-only)"; color: PhantomTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } AuraButton { label: root.api_on ? "ON" : "OFF"; primary: root.api_on; width: 90px; clicked => { root.set_api(!root.api_on); } } }
                    if root.api_status != "" : Text { text: root.api_status; color: PhantomTheme.secondary; font-size: 11px; wrap: word-wrap; }
                    // A20: expiring shares (Send-style). Same store/format as the CLI.
                    share_anchor := Rectangle { height: 0px; }
