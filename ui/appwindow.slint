    in-out property <bool> duress_armed: false;
    in-out property <float> lock_bits: 0.0;
    in-out property <bool> show_master: false;
    in-out property <bool> show_login_hints: false;
    callback lock_entropy(string);
    // App PIN quick-unlock (DPAPI-bound, device-local). pin_available mirrors
    // pin.dpapi existence; show_pin_pad toggles the inline pad.
    in-out property <bool> pin_available: false;
    in-out property <bool> show_pin_pad: false;
    // Lock tabs: 0 password · 1 PIN · 2 shards. Slint drives show_pin_pad /
    // show_recover from the tab (Rust only ever hides them).
    in-out property <int> unlock_tab: 0;
    // Unlock busy: blocks double-Enter double-fire while Argon2id runs.
    // Set on submit, cleared on next keystroke or error arrival.
    in-out property <bool> unlock_busy: false;
    changed unlock_error_message => { root.unlock_busy = false; }
    changed is_unlocked => { if !root.is_unlocked { root.unlock_busy = false; } }
    // Lock-screen language: static labels only (Rust-driven status stays EN).
    in-out property <string> ui_lang: "en";
    // A26: compact translator for the many form placeholders below.
    function tr(en: string, bn: string) -> string { return root.ui_lang == "bn" ? bn : en; }
    in-out property <string> pin_error: "";
    in-out property <string> pin_status: "";
    // A5: master-password rotation status (Settings card).
    in-out property <string> rekey_status: "";
