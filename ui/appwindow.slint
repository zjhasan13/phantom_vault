                    Text { text: root.ui_lang == "bn" ? "শুধু সঠিক মাস্টার পাসওয়ার্ড এই ভল্ট খুলবে না। এই Windows প্রোফাইলের DPAPI-সিলড ML-KEM key (pq_device.dpapi)-ও লাগবে। ফাইল/প্রোফাইল হারালে স্থায়ী ডেটা ক্ষতি। Sync/P2P বন্ধ; portable ডিফল্ট। offline cache ও .pvx এখনো password-sealed।" : "Correct master password alone will NOT open this vault. This Windows profile's DPAPI-sealed ML-KEM key (pq_device.dpapi) is also required. Losing that file or this Windows profile = permanent data loss. Sync and P2P are disabled; portable remains the default. The offline cache and .pvx exports are still password-sealed copies."; color: PhantomTheme.text-dim; font-size: 11px; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; Text { text: "Container profile"; color: PhantomTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } Text { text: root.pq_paranoid_on ? "PARANOID" : "PORTABLE"; color: root.pq_paranoid_on ? PhantomTheme.success : PhantomTheme.text-dim; font-size: 11px; font-weight: 800; vertical-alignment: center; } }
                    Text { text: "Device key: " + root.pq_backend_detail; color: root.pq_backend == "tpm" ? PhantomTheme.success : PhantomTheme.text-muted; font-size: 11px; wrap: word-wrap; }
                    if root.pq_paranoid_on && root.pq_backend == "dpapi" : AuraButton { label: "Move device key to TPM"; width: 210px; height: 34px; clicked => { root.move_pq_key_to_tpm(); } }
                    Text { text: root.pq_backup_ready ? "✅ A backup was exported this session." : "⚠️ Export an encrypted .pvx backup first (Importer → Encrypted (.pvx)) — required before enabling."; color: root.pq_backup_ready ? PhantomTheme.success : PhantomTheme.warning; font-size: 11px; wrap: word-wrap; }
                    if !root.pq_paranoid_on : AuraButton { label: "Enable PQ-paranoid"; width: 190px; height: 34px; clicked => { root.convert_pq_profile(true); } }
                    if root.pq_paranoid_on : HorizontalLayout { spacing: 8px;
                        AuraButton { label: root.pq_confirm_off ? "Sure? Convert back" : "Disable (portable)"; primary: !root.pq_confirm_off; danger: root.pq_confirm_off; width: root.pq_confirm_off ? 200px : 180px; height: 34px; clicked => { if root.pq_confirm_off { root.pq_confirm_off = false; root.convert_pq_profile(false); } else { root.pq_confirm_off = true; } } }
                        if root.pq_confirm_off : AuraButton { label: "Cancel"; width: 90px; height: 34px; clicked => { root.pq_confirm_off = false; } }
                    }
