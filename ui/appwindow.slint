                    FieldLabel { text: root.ui_lang == "bn" ? "সময়সীমাবদ্ধ শেয়ার (সেন্ড)" : "EXPIRING SHARES (SEND)"; }
                    Text { text: root.ui_lang == "bn" ? "একটি লগইন শেয়ার করুন: encrypted bundle LAN (এই অ্যাপ চলাকালীন), ফাইল, বা GitHub secret gist (async) দিয়ে যায়; key শুধু link fragment-এ। LAN-এ TTL/one-view এই অ্যাপ enforce করে; gist-এ expiry best-effort। CLI: phantom_vault share ..." : "Share one login: the encrypted bundle travels over LAN (while this app serves), a file, or a secret GitHub gist (async); the key is only in the link fragment. LAN TTL/one-view are enforced by this app; gist expiry is best-effort. CLI: phantom_vault share ...."; color: PhantomTheme.text-dim; font-size: 11px; wrap: word-wrap; }
                    if root.ls_stage_count > 0 : HorizontalLayout { spacing: 6px;
                        Text { text: "📤 " + root.ls_stage_count + " selected login(s) staged — the title field is ignored."; color: PhantomTheme.secondary; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                        AuraButton { label: "Clear"; width: 80px; height: 30px; clicked => { root.clear_share_stage(); } }
                    }
                    HorizontalLayout { spacing: 6px;
                        LineEdit { placeholder-text: "Login title to share"; text <=> root.ls_title; height: 36px; horizontal-stretch: 1; enabled: root.ls_stage_count == 0; }
                    }
                    HorizontalLayout { spacing: 6px;
                        LineEdit { placeholder-text: "TTL (24h)"; text <=> root.ls_ttl; width: 110px; height: 36px; }
                        LineEdit { placeholder-text: "Views (1, 0=∞)"; text <=> root.ls_views; width: 130px; height: 36px; enabled: !root.ls_relay; }
                        AuraButton { label: root.ls_serve ? "LAN: ON" : "LAN: OFF"; primary: root.ls_serve; width: 100px; height: 34px; clicked => { root.ls_serve = !root.ls_serve; root.ls_relay = root.ls_serve ? false : root.ls_relay; } }
                        AuraButton { label: root.ls_relay ? "Async gist: ON" : "Async gist: OFF"; primary: root.ls_relay; width: 140px; height: 34px; clicked => { root.ls_relay = !root.ls_relay; root.ls_serve = root.ls_relay ? false : root.ls_serve; } }
                    }
                    HorizontalLayout { spacing: 6px;
                        AuraButton { label: root.ls_pass_on ? "Passphrase: ON" : "Passphrase: OFF"; primary: root.ls_pass_on; width: 150px; height: 34px; clicked => { root.ls_pass_on = !root.ls_pass_on; } }
                        Text { text: root.ls_relay ? "Secret gist — anyone with the link can fetch until you revoke; the link includes your GitHub login. Expiry is best-effort, not one-time." : ""; color: PhantomTheme.text-dim; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                    }
                    if root.ls_pass_on : HorizontalLayout { spacing: 6px;
                        LineEdit { placeholder-text: "Share passphrase (8+)"; input-type: password; text <=> root.ls_pass; height: 36px; horizontal-stretch: 1; }
                        LineEdit { placeholder-text: "Confirm passphrase"; input-type: password; text <=> root.ls_pass_confirm; height: 36px; horizontal-stretch: 1; }
                    }
                    AuraButton { label: "Create share"; primary: true; width: 140px; height: 34px; clicked => { root.login_share_create(root.ls_title, root.ls_ttl, root.ls_views, root.ls_serve, root.ls_relay, root.ls_pass_on, root.ls_pass, root.ls_pass_confirm); } }
                    if root.ls_link != "" : Text { text: root.ls_link; color: PhantomTheme.secondary; font-size: 11px; wrap: word-wrap; }
                    if root.ls_link != "" : Image { source: root.ls_qr; width: 150px; height: 150px; image-fit: contain; }
                    if root.ls_link != "" : AuraButton { label: "📋 Copy link"; width: 130px; height: 30px; clicked => { root.login_share_copy(); } }
                    if root.ls_status != "" : Text { text: root.ls_status; color: PhantomTheme.secondary; font-size: 11px; wrap: word-wrap; }
                    Text { text: "Open a share you received:"; color: PhantomTheme.text-muted; font-size: 11px; }
                    LineEdit { placeholder-text: "pvshare://…"; text <=> root.ls_open_link; height: 36px; }
                    HorizontalLayout { spacing: 6px;
                        LineEdit { placeholder-text: "…or bundle file (.pvsh)"; text <=> root.ls_open_file; height: 36px; horizontal-stretch: 1; }
                        LineEdit { placeholder-text: "Passphrase (if required)"; input-type: password; text <=> root.ls_pass_input; width: 190px; height: 36px; }
                        AuraButton { label: "Open"; width: 100px; height: 34px; clicked => { root.login_share_open(root.ls_open_link, root.ls_open_file, root.ls_pass_input); } }
                    }
                    if root.ls_preview != "" : Text { text: root.ls_preview; color: PhantomTheme.text; font-size: 11px; wrap: word-wrap; }
                    if root.ls_ready : AuraButton { label: "Add to my vault"; primary: true; width: 180px; height: 34px; clicked => { root.login_share_add(); } }
                    if root.ls_rows.length == 0 : Text { text: "No active shares."; color: PhantomTheme.text-dim; font-size: 11px; }
                    for s in root.ls_rows : Rectangle { background: PhantomTheme.surface-low; border-radius: 8px; height: 40px; HorizontalLayout { padding-left: 12px; padding-right: 6px; spacing: 8px; Text { text: s.detail; color: PhantomTheme.text; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; } AuraButton { label: "Revoke"; danger: true; width: 90px; height: 28px; y: 6px; clicked => { root.login_share_revoke(s.id); } } } }
                    AuraButton { label: "Refresh shares"; width: 140px; height: 30px; clicked => { root.login_share_refresh(); } }
                    FieldLabel { text: root.ui_lang == "bn" ? "অ্যাটাচমেন্ট স্টোরেজ" : "ATTACHMENT STORAGE"; }
                }}
                if root.settings_tab == 0 : Rectangle { background: PhantomTheme.surface; border-radius: 12px; border-width: 1px; border-color: PhantomTheme.border; VerticalLayout { padding: 16px; spacing: 10px;
                    Text { text: "Inline: " + root.att_inline_count + " • Sidecar: " + root.att_sidecar_count + " — inline files are re-encrypted with every vault save; sidecars are separate (50MB max, GitHub sync supported)."; color: PhantomTheme.text-dim; font-size: 11px; wrap: word-wrap; }
                    AuraButton { label: "Move inline to encrypted sidecars"; width: 260px; height: 34px; clicked => { root.migrate_attachments(); } }
                    HorizontalLayout { spacing: 8px; Text { text: "Extension PIN (managed here, enforced in browser)"; color: PhantomTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } Text { text: root.ext_pin_set ? "SET" : "OFF"; color: root.ext_pin_set ? PhantomTheme.success : PhantomTheme.text-dim; font-size: 11px; font-weight: 800; vertical-alignment: center; } }
                    HorizontalLayout { spacing: 8px;
                        ext_pin_new := LineEdit { placeholder-text: "New 4–8 digit PIN"; input-type: password; height: 36px; horizontal-stretch: 1; }
                        ext_pin_confirm := LineEdit { placeholder-text: "Confirm PIN"; input-type: password; height: 36px; horizontal-stretch: 1; }
                    }
                    HorizontalLayout { spacing: 8px;
                        AuraButton { label: "Set Ext PIN"; primary: true; width: 130px; height: 34px; clicked => { root.setup_ext_pin(ext_pin_new.text, ext_pin_confirm.text); ext_pin_new.text = ""; ext_pin_confirm.text = ""; } }
                        if root.ext_pin_set : AuraButton { label: root.confirm_ext_pin_remove ? "Sure?" : "Remove Ext PIN"; danger: true; width: root.confirm_ext_pin_remove ? 110px : 150px; height: 34px; clicked => { if root.confirm_ext_pin_remove { root.confirm_ext_pin_remove = false; root.disable_ext_pin(); } else { root.confirm_ext_pin_remove = true; } } }
                    }
