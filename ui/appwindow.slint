                    HorizontalLayout { spacing: 8px; Text { text: "Hold-to-Reveal Ephemeral Mode"; color: #eef1ff; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } AuraButton { label: root.peep_hole_mode ? "ON" : "OFF"; primary: root.peep_hole_mode; width: 90px; clicked => { root.set_peep_mode(!root.peep_hole_mode); } } }
                    HorizontalLayout { spacing: 8px; Text { text: "Moiré Optical Lens Jammer"; color: #eef1ff; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } AuraButton { label: root.moire_guard_active ? "ON" : "OFF"; primary: root.moire_guard_active; width: 90px; clicked => { root.set_moire(!root.moire_guard_active); } } }
