                    HorizontalLayout { spacing: 8px; Text { text: "SSH Agent"; color: #eef1ff; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } Text { text: root.ssh_status; color: #8e99c0; font-size: 11px; vertical-alignment: center; } if root.ssh_agent_running : AuraButton { label: "Stop"; danger: true; width: 90px; clicked => { root.stop_ssh_agent(); } } if !root.ssh_agent_running : AuraButton { label: "Start"; primary: true; width: 90px; clicked => { root.start_ssh_agent(); } } AuraButton { label: "Refresh"; width: 90px; clicked => { root.refresh_ssh_status(); } } }
                    HorizontalLayout { spacing: 8px; Text { text: "Offline audit (no network)"; color: #eef1ff; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; } AuraButton { label: root.offline_audit ? "ON" : "OFF"; primary: root.offline_audit; width: 90px; clicked => { root.offline_audit = !root.offline_audit; } } }
