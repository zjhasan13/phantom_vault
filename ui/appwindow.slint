                        // P0 audit timeline: global recent events, never per-item claims.
                        Rectangle { background: PhantomTheme.surface; border-radius: 8px; border-width: 1px; border-color: PhantomTheme.border; VerticalLayout { padding: 12px; spacing: 6px;
                            FieldLabel { text: root.ui_lang == "bn" ? "অডিট ট্রেইল (সাম্প্রতিক)" : "DECRYPTION AUDIT TRAIL (RECENT)"; }
                            Text { text: root.ui_lang == "bn" ? "ভল্ট-ওয়াইড ইভেন্ট · শুধু মেটাডেটা" : "Vault-wide events · metadata only"; color: PhantomTheme.text-dim; font-size: 10px; }
                            Text { text: root.d_audit_text == "" ? (root.ui_lang == "bn" ? "কোনো সাম্প্রতিক ইভেন্ট নেই।" : "No recent events.") : root.d_audit_text; color: PhantomTheme.text-muted; font-size: 11px; wrap: word-wrap; }
                        }}
                        // Bottom action bar
                        HorizontalLayout { spacing: 8px;
                            if root.d_trashed : AuraButton { label: root.ui_lang == "bn" ? "🔄 আইটেম ফিরিয়ে আনুন" : "🔄 Restore Item"; primary: true; horizontal-stretch: 1; height: 36px; clicked => { root.restore_item(root.d_kind, root.d_id); } }
                            if root.d_trashed : AuraButton { label: root.confirm_delete_detail ? (root.ui_lang == "bn" ? "নিশ্চিত? ধ্বংস" : "Sure? Shred") : (root.ui_lang == "bn" ? "🔥 স্থায়ীভাবে ধ্বংস" : "🔥 Permanently Shred"); danger: true; horizontal-stretch: 1; height: 36px; clicked => { if root.confirm_delete_detail { root.confirm_delete_detail = false; root.delete_item_requested(root.d_kind, root.d_id); } else { root.confirm_delete_detail = true; } } }
                            if !root.d_trashed && root.d_kind == 1 : AuraButton { label: "📤 Share"; width: 110px; height: 36px; clicked => { root.share_item(root.d_kind, root.d_id); } }
    
                            if !root.d_trashed : AuraButton { label: root.confirm_delete_detail ? (root.ui_lang == "bn" ? "নিশ্চিত? মুছুন" : "Sure? Delete") : (root.ui_lang == "bn" ? "🗑 মুছুন" : "🗑 Delete"); danger: true; horizontal-stretch: 1; height: 36px; clicked => { if root.confirm_delete_detail { root.confirm_delete_detail = false; root.delete_item_requested(root.d_kind, root.d_id); } else { root.confirm_delete_detail = true; } } }
                            AuraButton { label: "✕ Close"; width: 110px; height: 36px; clicked => { root.close_detail(); } }
                        }
                    }
                    if root.d_id == "" && !root.show_add_form : VerticalLayout { spacing: 8px; alignment: center; padding-top: 40px;
                        Text { text: "🛡️"; font-size: 44px; horizontal-alignment: center; }
                        Text { text: "Select an item from the list to view details"; color: PhantomTheme.text-dim; font-size: 13px; horizontal-alignment: center; }
                        AuraButton { label: "+ New Item"; primary: true; width: 170px; height: 36px; clicked => { root.open_new_form(1); } }
                        AuraButton { label: "🎲 Generator"; width: 170px; height: 36px; clicked => { root.show_generator = true; root.regenerate(); } }
                    }
                }}
                // Phase 26: moiré veil floats ABOVE the card content when armed.
                if root.moire_guard_active : MoireVeil {
                    x: (parent.width - 480px) / 2;
                    y: 12px;
                    width: 480px;
                    height: parent.height - 24px;
                }
            }
        }
            // Bottom status bar: real counts, no fabricated sync badge.
            Rectangle { height: 24px; background: PhantomTheme.surface-lowest;
                HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 8px;
                    Text { text: "● LOCAL ENCLAVE SYNCHRONIZED"; color: PhantomTheme.success; font-size: 9px; font-weight: 700; font-family: "JetBrains Mono"; letter-spacing: 0.6px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.credentials.length + " / " + root.total_matches_count + " ITEMS"; color: PhantomTheme.text-dim; font-size: 9px; font-family: "JetBrains Mono"; vertical-alignment: center; }
                }
            }
        }
    }

    // ==== Generator floating layer
    if root.show_autofill_pill : Rectangle {
        x: parent.width - 220px; y: parent.height - 70px; width: 200px; height: 44px;
        background: PhantomTheme.primary; border-radius: 12px; clip: true;
        TouchArea { mouse-cursor: pointer; clicked => { root.autofill_pill_clicked(); } }
        Text { text: "🔑 Fill " + root.pill_title; color: PhantomTheme.on-primary; font-size: 13px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    }
    // ==== Generator floating layer (window-level, never under taskbar) ====
    if root.show_generator : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #060e20cc;
        TouchArea {
            clicked => { root.close_panel(); }
        }
        GeneratorPanel {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            ui_lang: root.ui_lang;
            gen_length <=> root.gen_length;
            gen_uppercase <=> root.gen_uppercase;
            gen_lowercase <=> root.gen_lowercase;
            gen_digits <=> root.gen_digits;
            gen_symbols <=> root.gen_symbols;
            gen_exclude_ambiguous <=> root.gen_exclude_ambiguous;
            gen_diceware_mode <=> root.gen_diceware_mode;
            gen_dice_lang <=> root.gen_dice_lang;
            gen_word_count <=> root.gen_word_count;
            gen_output <=> root.gen_output;
            gen_entropy_bits <=> root.gen_entropy_bits;
            regenerate() => { root.regenerate(); }
            use_password(pwd) => { root.use_password(pwd); }
            close_panel() => { root.close_panel(); }
        }
    }

    // ==== + Add Field dialog (custom field builder) ====
    if root.show_cf_dialog : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #060e20cc;
        TouchArea {
            clicked => { root.show_cf_dialog = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 400px;
            background: PhantomTheme.surface;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: PhantomTheme.primary;
            drop-shadow-blur: 40px;
            drop-shadow-color: #4edea344;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "+ Add Custom Field"; font-size: 16px; font-weight: 800; color: PhantomTheme.text; horizontal-alignment: center; }
                HorizontalLayout {
                    spacing: 6px;
                    AuraButton { label: "📝 Text"; primary: root.cf_type == 0; horizontal-stretch: 1; clicked => { root.cf_type = 0; } }
                    AuraButton { label: "🔒 Hidden"; primary: root.cf_type == 1; horizontal-stretch: 1; clicked => { root.cf_type = 1; } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    AuraButton { label: "☑ Check"; primary: root.cf_type == 2; horizontal-stretch: 1; clicked => { root.cf_type = 2; } }
                    AuraButton { label: "🔗 Link"; primary: root.cf_type == 3; horizontal-stretch: 1; clicked => { root.cf_type = 3; root.cf_value = "password"; } }
                }
                Text { text: root.cf_type == 1 ? "Hidden fields mask secrets with an eye toggle." : (root.cf_type == 2 ? "Checkbox starts OFF — toggle anytime." : (root.cf_type == 3 ? "Linked field mirrors Username or Password live — no duplicated secret." : "Text fields fit security questions & extras.")); color: PhantomTheme.text-dim; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                FieldLabel { text: "FIELD LABEL *"; }
                LineEdit { placeholder-text: "e.g. Security question"; text <=> root.cf_name; height: 38px; }
                if root.cf_type == 0 || root.cf_type == 1 : VerticalLayout {
                    spacing: 10px;
                    FieldLabel { text: "VALUE"; }
                    LineEdit { placeholder-text: "Value…"; input-type: root.cf_type == 1 ? password : text; text <=> root.cf_value; height: 38px; }
                }
                if root.cf_type == 3 : VerticalLayout {
                    spacing: 10px;
                    FieldLabel { text: "MIRROR TARGET"; }
                    HorizontalLayout {
                        spacing: 6px;
                        AuraButton { label: "Username"; primary: root.cf_value == "username"; horizontal-stretch: 1; clicked => { root.cf_value = "username"; } }
                        AuraButton { label: "Password"; primary: root.cf_value == "password"; horizontal-stretch: 1; clicked => { root.cf_value = "password"; } }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    AuraButton { label: "Add"; primary: true; width: 130px; clicked => { root.add_custom_field(root.cf_type, root.cf_name, root.cf_value); } }
                    AuraButton { label: "Cancel"; width: 130px; clicked => { root.show_cf_dialog = false; } }
                }
            }
        }
    }

    // ==== Master-reprompt gate modal ====
    if root.rp_show : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #060e20cc;
        TouchArea { clicked => { root.rp_show = false; root.rp_error = ""; } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 400px;
            background: PhantomTheme.surface;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: PhantomTheme.warning;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000088;
            VerticalLayout {
                padding: 22px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    Rectangle {
                        width: 46px;
                        height: 46px;
                        border-radius: 23px;
                        background: #f59e0b1a;
                        border-width: 1.5px;
                        border-color: PhantomTheme.warning;
                        Text { text: "🔒"; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: root.ui_lang == "bn" ? "মাস্টার রিপ্রম্পট" : "Master Reprompt"; font-size: 16px; font-weight: 800; color: PhantomTheme.text; }
                        Text { text: root.ui_lang == "bn" ? (root.rp_action == 2 ? "এই লগইন অটোফিল" : (root.rp_action == 3 ? "এই আইটেম মুছুন" : (root.rp_action == 5 ? (root.rp_export_fmt == 3 ? "ভল্ট এনক্রিপ্টেড এক্সপোর্ট" : (root.rp_export_fmt == 5 ? "KeePass KDBX-এ এক্সপোর্ট" : "ভল্ট প্লেইনটেক্সট এক্সপোর্ট")) : "এই সিক্রেট দেখান"))) : (root.rp_action == 2 ? "Auto-fill this login" : (root.rp_action == 3 ? "Delete this item" : (root.rp_action == 5 ? (root.rp_export_fmt == 3 ? "Export vault ENCRYPTED" : (root.rp_export_fmt == 5 ? "Export to KeePass KDBX" : "Export vault PLAINTEXT")) : "Reveal this secret"))); color: PhantomTheme.warning; font-size: 12px; font-weight: 700; }
                    }
                }
                Text { text: root.ui_lang == "bn" ? "এই আইটেমের জন্য মাস্টার পাসওয়ার্ড নিশ্চিত করতে হবে।" : "This item demands master-password confirmation."; color: PhantomTheme.text-muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                if root.rp_user != "" : Text { text: root.ui_lang == "bn" ? "জন্য " + root.rp_user : "for " + root.rp_user; color: PhantomTheme.text-dim; font-size: 11px; horizontal-alignment: center; overflow: elide; }
                rp_input := LineEdit { placeholder-text: root.ui_lang == "bn" ? "মাস্টার পাসওয়ার্ড…" : "Master password…"; input-type: password; height: 46px; font-size: 15px; accepted(text) => { root.reprompt_confirm(text, root.rp_backup_pass, root.rp_backup_confirm); } }
                if root.rp_action == 5 && (root.rp_export_fmt == 3 || root.rp_export_fmt == 5) : VerticalLayout { spacing: 6px;
                    Text { text: root.rp_export_fmt == 5 ? "A13: this .kdbx opens in KeePassXC with THIS password — never your master password. 12+ characters; it cannot be recovered." : "A6: this .pvx is sealed with THIS passphrase — never with your master password. Store it separately; it cannot be recovered."; color: PhantomTheme.warning; font-size: 11px; wrap: word-wrap; }
                    LineEdit { placeholder-text: root.rp_export_fmt == 5 ? "KDBX password (12+ characters)" : "Backup passphrase (12+ characters)"; input-type: password; height: 40px; text: root.rp_backup_pass; edited(v) => { root.rp_backup_pass = v; } }
                    LineEdit { placeholder-text: "Confirm password"; input-type: password; height: 40px; text: root.rp_backup_confirm; edited(v) => { root.rp_backup_confirm = v; } }
                }
                if root.rp_error != "" : Text { text: root.rp_error; color: PhantomTheme.error; font-size: 12px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    AuraButton { label: root.ui_lang == "bn" ? "নিশ্চিত করুন" : "Confirm"; primary: true; width: 150px; height: 42px; clicked => { root.reprompt_confirm(rp_input.text, root.rp_backup_pass, root.rp_backup_confirm); } }
                    AuraButton { label: root.ui_lang == "bn" ? "✕ বাতিল" : "✕ Cancel"; width: 130px; height: 42px; clicked => { root.rp_show = false; root.rp_error = ""; } }
                }
            }
        }
    }

    // ==== A23: local API approval (pending request from the pv CLI) ====
    if root.api_prompt_show : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #060e20cc;
        Rectangle {
            width: 470px;
            height: 210px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #0d1430;
            border-radius: 14px;
            border-width: 1.5px;
            border-color: PhantomTheme.warning;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: root.ui_lang == "bn" ? "🔐 pv CLI অনুরোধ" : "🔐 pv CLI request"; color: PhantomTheme.text; font-size: 16px; font-weight: 800; horizontal-alignment: center; }
                Text { text: root.api_prompt_text; color: PhantomTheme.text; font-size: 13px; wrap: word-wrap; horizontal-alignment: center; }
                Text { text: root.ui_lang == "bn" ? "একটি লোকাল স্ক্রিপ্ট একটি ভল্ট ফিল্ড পড়তে চায়। আপনি শুরু না করলে অস্বীকার করুন। ৬০ সেকেন্ডে মেয়াদ শেষ; CLI ৫০ সেকেন্ডে থেমে যায়।" : "A local script wants to read one vault field. Deny if you did not start it. This prompt expires after 60 seconds; the CLI gives up at 50."; color: PhantomTheme.text-muted; font-size: 11px; wrap: word-wrap; horizontal-alignment: center; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    AuraButton { label: root.ui_lang == "bn" ? "একবার অনুমতি" : "Allow once"; primary: true; width: 150px; height: 40px; clicked => { root.api_allow(); } }
                    AuraButton { label: root.ui_lang == "bn" ? "অস্বীকার" : "Deny"; danger: true; width: 130px; height: 40px; clicked => { root.api_deny(); } }
                }
            }
        }
    }

    // ==== What's New changelog (GitHub release notes, read-only) ====
    if root.show_changelog : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #060e20cc;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 480px;
            background: PhantomTheme.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: PhantomTheme.primary;
            clip: true;
            VerticalLayout { padding: 20px; spacing: 10px;
                Text { text: "🎉 What's New in " + root.update_tag; color: PhantomTheme.success; font-size: 15px; font-weight: 900; horizontal-alignment: center; wrap: word-wrap; }
                Rectangle { background: PhantomTheme.surface; border-radius: 8px; height: 300px; clip: true;
                    ScrollView { VerticalLayout { padding: 12px; Text { text: root.update_notes; color: PhantomTheme.text; font-size: 12px; wrap: word-wrap; } } }
                }
                HorizontalLayout { spacing: 8px; alignment: center;
                    if !root.update_ready : AuraButton { label: "⬇️ Download & Stage"; primary: true; width: 190px; height: 38px; clicked => { root.show_changelog = false; root.download_update(); } }
                    if root.update_ready : AuraButton { label: "🔄 Restart to Update"; primary: true; width: 190px; height: 38px; clicked => { root.show_changelog = false; root.restart_update(); } }
                    AuraButton { label: "✕ Close"; width: 120px; height: 38px; clicked => { root.show_changelog = false; } }
                }
            }
        }
    }

    // ==== Attachment RAM preview (images decoded to pixels, text to string —
    // plaintext never touches disk) ====
    if root.att_preview : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #060e20cc;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 480px;
            background: PhantomTheme.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: PhantomTheme.primary;
            clip: true;
            VerticalLayout { padding: 16px; spacing: 10px;
                Text { text: "📎 " + root.att_preview_name; color: PhantomTheme.text; font-size: 14px; font-weight: 800; horizontal-alignment: center; overflow: elide; }
                Text { text: root.att_preview_info; color: PhantomTheme.text-dim; font-size: 11px; horizontal-alignment: center; }
                if root.att_preview_kind == "image" : HorizontalLayout { alignment: center;
                    Image { source: root.att_preview_image; width: 440px; height: 320px; image-fit: contain; }
                }
                if root.att_preview_kind == "text" : Rectangle { background: PhantomTheme.surface; border-radius: 8px; height: 320px; clip: true;
                    ScrollView { VerticalLayout { padding: 10px; Text { text: root.att_preview_text; color: PhantomTheme.text; font-size: 12px; wrap: word-wrap; } } }
                }
                if root.att_preview_kind == "other" : Text { text: "No in-app preview for this file type — export to view."; color: PhantomTheme.warning; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout { spacing: 8px; alignment: center;
                    AuraButton { label: "💾 Export File"; width: 140px; height: 36px; clicked => { root.att_preview = false; root.download_attachment(root.d_kind, root.d_id, root.att_preview_id); } }
                    AuraButton { label: root.confirm_delete_att_id == root.att_preview_id ? "Sure?" : "🗑️ Delete"; width: root.confirm_delete_att_id == root.att_preview_id ? 110px : 120px; height: 36px; danger: true; clicked => { if root.confirm_delete_att_id == root.att_preview_id { root.confirm_delete_att_id = ""; root.att_preview = false; root.delete_attachment(root.d_kind, root.d_id, root.att_preview_id); } else { root.confirm_delete_att_id = root.att_preview_id; } } }
                    AuraButton { label: "✕ Close Preview"; width: 150px; height: 36px; clicked => { root.att_preview = false; } }
                }
            }
        }
    }

    // ==== Factory reset triple-gate (Danger Zone + lock recovery link) ====
    if root.show_factory_reset : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #060e20cc;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 480px;
            background: PhantomTheme.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: PhantomTheme.error;
            clip: true;
            VerticalLayout { padding: 20px; spacing: 10px;
                Text { text: "🔥 Factory Reset — shred EVERYTHING?"; color: PhantomTheme.error; font-size: 16px; font-weight: 900; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: "Vault file, all backup generations, decoy container, and machine seals are DoD-shredded. Recovery is IMPOSSIBLE afterwards."; color: PhantomTheme.text-muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                if root.fr_preview != "" : Text { text: root.fr_preview; color: PhantomTheme.warning; font-size: 12px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                FieldLabel { text: "MASTER PASSWORD"; }
                LineEdit { placeholder-text: "Confirm master password…"; input-type: password; text <=> root.fr_password; height: 40px; }
                FieldLabel { text: "TYPE DELETE IN CAPS TO CONTINUE"; }
                LineEdit { placeholder-text: "DELETE"; text <=> root.fr_delete_text; height: 40px; }
                if root.fr_error != "" : Text { text: root.fr_error; color: PhantomTheme.error; font-size: 12px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                if root.fr_countdown > 0 : Text { text: "💣 " + root.fr_countdown + "…"; color: PhantomTheme.error; font-size: 30px; font-weight: 900; horizontal-alignment: center; }
                if !root.fr_armed : AuraButton { label: "⏳ Verify & Start 5s Countdown"; primary: true; horizontal-stretch: 1; height: 40px; clicked => { root.factory_reset_arm(); } }
                if root.fr_armed : AuraButton { label: "🔥 DELETE EVERYTHING NOW"; danger: true; horizontal-stretch: 1; height: 40px; clicked => { root.factory_reset_confirm(); } }
                AuraButton { label: "✕ Cancel (keep my vault)"; horizontal-stretch: 1; height: 36px; clicked => { root.factory_reset_cancel(); } }
            }
        }
    }

    // ==== PR-1: New-device modal (blocking; re-shows every unlock until enrolled) ====
    if root.show_new_device_modal : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #060e20cc;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 460px;
            background: PhantomTheme.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: PhantomTheme.warning;
            clip: true;
            VerticalLayout { padding: 20px; spacing: 10px;
                Text { text: "🖥️ New PC detected"; color: PhantomTheme.warning; font-size: 16px; font-weight: 900; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: root.new_device_reason == "hello-token" ? "Windows Hello credential can't be read on this PC. You unlocked with your Master Password. Re-enroll Hello for this machine?" : "This vault was bound to a different machine (normal for portable USB). You unlocked with your Master Password. Re-enroll Windows Hello for this PC?"; color: PhantomTheme.text-muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                if root.new_device_error != "" : Text { text: root.new_device_error; color: PhantomTheme.error; font-size: 12px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                AuraButton { label: "🖐 Re-enroll Hello"; primary: true; horizontal-stretch: 1; height: 40px; clicked => { root.reenroll_hello_requested(); } }
                AuraButton { label: "Later (asks again next unlock)"; horizontal-stretch: 1; height: 36px; clicked => { root.dismiss_new_device_modal(); } }
            }
        }
    }

    // ==== Webcam QR scan modal (live camera, 60s budget) ====
    if root.show_webcam_scan : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #060e20cc;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 440px;
            background: PhantomTheme.surface;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: PhantomTheme.secondary;
            drop-shadow-blur: 40px;
            drop-shadow-color: #4cd7f644;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "📷  Scanning webcam for QR…"; font-size: 16px; font-weight: 800; color: PhantomTheme.text; horizontal-alignment: center; }
                Text { text: "Hold the code steady in front of " + (root.webcam_cam_current == "" ? "the camera" : root.webcam_cam_current) + ". Auto-imports on detection (60s budget)."; color: PhantomTheme.text-muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                if root.webcam_cams.length > 1 : HorizontalLayout { alignment: center; spacing: 8px;
                    Text { text: "Camera:"; color: PhantomTheme.text-muted; font-size: 12px; vertical-alignment: center; }
                    ComboBox { model: root.webcam_cams; current-value <=> root.webcam_cam_current; selected(name) => { root.webcam_camera_picked(name); } width: 280px; height: 34px; }
                }
                Rectangle { background: #000000; border-radius: 12px; border-width: 1px; border-color: PhantomTheme.border; clip: true;
                    height: 300px;
                    Image { source: root.webcam_frame; width: 100%; height: 100%; image-fit: contain; }
                }
                if root.webcam_hint != "" : Text { text: root.webcam_hint; color: PhantomTheme.warning; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: center;
                    AuraButton { label: "✕  Cancel Scan"; width: 160px; clicked => { root.cancel_webcam_scan(); } }
                }
            }
        }
    }

    // ==== Health audit report modal (HaveIBeenPwned k-anonymity) ====
    if root.show_health : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #060e20cc;
        TouchArea {
            clicked => { root.show_health = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 520px;
            background: PhantomTheme.surface;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: PhantomTheme.primary;
            drop-shadow-blur: 40px;
            drop-shadow-color: #4edea344;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "🛡️  Vault Health Report"; font-size: 16px; font-weight: 800; color: PhantomTheme.text; horizontal-alignment: center; }
                // Score + count chips (props already published by the audit).
                HorizontalLayout { spacing: 8px; alignment: center;
                    Text { text: root.health_score + " / 100"; color: root.health_score >= 90 ? PhantomTheme.success : (root.health_score >= 70 ? PhantomTheme.warning : PhantomTheme.error); font-size: 22px; font-weight: 900; vertical-alignment: center; }
                    VerticalLayout { spacing: 0px;
                        Text { text: root.health_headline; color: PhantomTheme.text-muted; font-size: 11px; wrap: word-wrap; }
                        HorizontalLayout { spacing: 10px;
                            Text { text: "🚨 " + root.health_breached; color: PhantomTheme.error; font-size: 11px; font-weight: 700; }
                            Text { text: "🔁 " + root.health_reused; color: PhantomTheme.warning; font-size: 11px; font-weight: 700; }
                            Text { text: "🔓 " + root.health_weak; color: PhantomTheme.warning; font-size: 11px; font-weight: 700; }
                            Text { text: "🕰️ " + root.health_stale; color: PhantomTheme.text-muted; font-size: 11px; font-weight: 700; }
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    min-height: 220px;
                    VerticalLayout { spacing: 4px; padding-left: 2px; padding-right: 2px;
                        if root.health_rows.length == 0 : Text { text: "✅ All passwords look healthy — no breaches, reuse, or weakness found."; color: PhantomTheme.success; font-size: 12px; wrap: word-wrap; }
                        for row in root.health_rows : Rectangle {
                            background: row.sev == -1 ? transparent : PhantomTheme.surface-low;
                            border-radius: 8px;
                            height: row.sev == -1 ? 24px : 58px;
                            clip: true;
                            // Row tap FIRST (under content): buttons above keep their own clicks.
                            if row.sev >= 0 : TouchArea { mouse-cursor: pointer; clicked => { root.open_detail(row.id); root.show_health = false; } }
                            if row.sev == -1 : Text { text: row.title; color: PhantomTheme.primary; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                            if row.sev >= 0 : HorizontalLayout { padding-left: 10px; padding-right: 6px; spacing: 8px;
                                Text { text: row.sev == 0 ? "🔴" : (row.sev == 1 ? "🟠" : (row.sev == 2 ? "🟡" : "⚪")); font-size: 12px; vertical-alignment: center; }
                                VerticalLayout { horizontal-stretch: 1; spacing: 0px;
                                    Text { text: row.title; color: PhantomTheme.text; font-size: 12px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                    Text { text: row.flags; color: PhantomTheme.text-muted; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                    if row.rotation != "" : Text { text: row.rotation; color: PhantomTheme.secondary; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                }
                                Text { text: "›"; color: PhantomTheme.text-dim; font-size: 16px; vertical-alignment: center; }
                                AuraButton { label: "↗ Open"; width: 76px; height: 28px; clicked => { root.open_health_url(row.id); } }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    AuraButton { label: "✕  Close"; width: 140px; clicked => { root.show_health = false; } }
                }
            }
        }
    }

    // ==== Access log modal (hash-chained, metadata only) ====
    if root.show_access_log : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #060e20cc;
        TouchArea {
            clicked => { root.show_access_log = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 520px;
            background: PhantomTheme.surface;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: PhantomTheme.primary;
            drop-shadow-blur: 40px;
            drop-shadow-color: #4edea344;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "📜  Access Log (tamper-evident)"; font-size: 16px; font-weight: 800; color: PhantomTheme.text; horizontal-alignment: center; }
                ScrollView {
                    vertical-stretch: 1;
                    min-height: 220px;
                    Text { text: root.access_log_text; color: PhantomTheme.text-muted; font-size: 12px; wrap: word-wrap; }
                }
                HorizontalLayout {
                    alignment: center;
                    AuraButton { label: root.access_log_hide_bridge ? "🔇 Bridge hidden" : "🔊 Bridge shown"; width: 180px; height: 32px; clicked => { root.toggle_log_bridge(); } }
                    AuraButton { label: "✕  Close"; width: 140px; height: 32px; clicked => { root.show_access_log = false; } }
                }
            }
        }
    }

    // ==== Import-source shred confirm (plaintext export hygiene) ====
    if root.show_shred_source : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #060e20cc;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 480px;
            background: PhantomTheme.surface;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: PhantomTheme.error;
            drop-shadow-blur: 40px;
            drop-shadow-color: #ffb4ab44;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "🔥  Shred plaintext source?"; font-size: 16px; font-weight: 800; color: PhantomTheme.error; horizontal-alignment: center; }
                Text { text: "The imported file still holds UNENCRYPTED passwords:"; color: PhantomTheme.text-muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: root.shred_source_path; color: PhantomTheme.text; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: "DoD 3-pass shred makes recovery impossible. Do it unless you need the file."; color: PhantomTheme.text-dim; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    AuraButton { label: "🔥 Shred it"; danger: true; width: 150px; clicked => { root.confirm_shred_source(); } }
                    AuraButton { label: "Keep file"; width: 130px; clicked => { root.cancel_shred_source(); } }
                }
            }
        }
    }

    // ==== Emergency recovery sheet modal (Shamir 3-of-5) ====
    if root.show_shards : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #060e20cc;
        TouchArea { clicked => { root.show_shards = false; } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 520px;
            background: PhantomTheme.surface;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: PhantomTheme.warning;
            drop-shadow-blur: 40px;
            drop-shadow-color: #f59e0b44;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text { text: "📄  Emergency Recovery Sheet (3-of-5)"; font-size: 16px; font-weight: 800; color: PhantomTheme.warning; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: "Save or print these 5 shards on paper. Any 3 shards will recover your vault."; color: PhantomTheme.text-muted; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout { spacing: 8px; Text { text: root.shard_1; color: PhantomTheme.secondary; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; } AuraButton { label: "📋"; width: 52px; height: 30px; clicked => { root.copy_password_requested(root.shard_1); } } }
                HorizontalLayout { spacing: 8px; Text { text: root.shard_2; color: PhantomTheme.secondary; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; } AuraButton { label: "📋"; width: 52px; height: 30px; clicked => { root.copy_password_requested(root.shard_2); } } }
                HorizontalLayout { spacing: 8px; Text { text: root.shard_3; color: PhantomTheme.secondary; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; } AuraButton { label: "📋"; width: 52px; height: 30px; clicked => { root.copy_password_requested(root.shard_3); } } }
                HorizontalLayout { spacing: 8px; Text { text: root.shard_4; color: PhantomTheme.secondary; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; } AuraButton { label: "📋"; width: 52px; height: 30px; clicked => { root.copy_password_requested(root.shard_4); } } }
                HorizontalLayout { spacing: 8px; Text { text: root.shard_5; color: PhantomTheme.secondary; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; } AuraButton { label: "📋"; width: 52px; height: 30px; clicked => { root.copy_password_requested(root.shard_5); } } }
                HorizontalLayout {
                    alignment: center;
                    AuraButton { label: "🖨️ Export PDF"; primary: true; width: 160px; clicked => { root.export_recovery_sheet(); } }
                    AuraButton { label: "✕  Close Modal"; width: 160px; clicked => { root.show_shards = false; } }
                }
                Rectangle { background: PhantomTheme.surface-low; border-radius: 10px; VerticalLayout { padding: 12px; spacing: 8px;
                    Text { text: "🎯 Recovery drill — type word #2 and #4 of shard #1 above"; color: PhantomTheme.text; font-size: 12px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px;
                        drill_w2 := LineEdit { placeholder-text: "word #2"; height: 36px; horizontal-stretch: 1; }
                        drill_w4 := LineEdit { placeholder-text: "word #4"; height: 36px; horizontal-stretch: 1; }
                    }
                    if root.drill_status != "" : Text { text: root.drill_status; color: PhantomTheme.secondary; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                    HorizontalLayout { alignment: center;
                        AuraButton { label: "✅ Verify Drill"; primary: true; width: 160px; height: 36px; clicked => { root.verify_shard_drill(drill_w2.text, drill_w4.text); } }
                    }
                } }
            }
        }
    }
}

// Phase 9: Raycast / Spotlight-Style Global Quick-Bar (Alt + Space)
export component QuickBarWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    width: 640px;
    height: 380px;
    background: transparent;
    title: "PhantomVault Quick Bar";
    // A26: mirrors MainWindow.ui_lang.
    in-out property <string> ui_lang: "en";

    in-out property <string> quick_query;
    in-out property <[CredentialView]> filtered_results;
    // Keyboard pick: ↑↓ move, Enter copies the highlighted hit (default 0).
    in-out property <int> qb_index: 0;

    callback query_changed(string);
    // kind+id ride along so Rust can enforce the master-reprompt gate
    // (password strings alone cannot identify the item).
    callback item_selected(int, string, string);
    callback copy_totp_selected(int, string);
    callback type_selected(int, string, string, string, string);
    callback qb_open_url(string);
    callback dismiss();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #060e20f2;
        border-radius: 18px;
        border-color: PhantomTheme.primary;
        border-width: 1.5px;
        drop-shadow-blur: 48px;
        drop-shadow-color: #4edea366;
        clip: true;

        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.dismiss();
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.qb_index = Math.max(root.qb_index - 1, 0);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.qb_index = Math.min(root.qb_index + 1, Math.max(root.filtered_results.length - 1, 0));
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        background: PhantomTheme.primary;
                        Text { text: "⚡"; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text { text: "Phantom Quick Bar"; color: PhantomTheme.text; font-size: 14px; font-weight: 800; }
                        Text { text: root.ui_lang == "bn" ? "Alt+Space • সাথে সাথে কপি" : "Alt+Space  •  instant copy"; color: PhantomTheme.text-dim; font-size: 11px; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.filtered_results.length + " hits"; color: PhantomTheme.text-dim; font-size: 11px; vertical-alignment: center; }
                }

                quick_input := LineEdit {
                    placeholder-text: "Type to filter — ↑↓ pick, Enter copies…";
                    text <=> root.quick_query;
                    height: 44px;
                    font-size: 15px;
                    edited(text) => { root.qb_index = 0; root.query_changed(text); }
                    accepted(text) => {
                        root.query_changed(text);
                        if root.filtered_results.length > 0 {
                            root.qb_index = Math.min(root.qb_index, root.filtered_results.length - 1);
                            root.item_selected(root.filtered_results[root.qb_index].kind, root.filtered_results[root.qb_index].id, root.filtered_results[root.qb_index].password);
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        for item[idx] in root.filtered_results : Rectangle {
                            background: idx == root.qb_index ? PhantomTheme.surface-high : PhantomTheme.surface;
                            border-radius: 12px;
                            border-width: idx == root.qb_index ? 2px : 1px;
                            border-color: idx == root.qb_index ? PhantomTheme.secondary : PhantomTheme.border;
                            height: 62px;
                            row_touch := TouchArea { mouse-cursor: pointer; clicked => { root.item_selected(item.kind, item.id, item.password); } }
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 10px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle {
                                        width: 40px;
                                        height: 40px;
                                        border-radius: 10px;
                                        background: PhantomTheme.surface-high;
                                        Text { text: item.kind == 1 ? "🔑" : (item.kind == 2 ? "📜" : (item.kind == 3 ? "📝" : (item.kind == 4 ? "💳" : (item.kind == 5 ? "🪪" : (item.kind == 8 ? "⏱️" : "🖥️"))))); font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;
                                        Text { text: item.title; color: PhantomTheme.text; font-size: 13px; font-weight: 700; overflow: elide; }
                                        Text { text: item.username; color: PhantomTheme.text-muted; font-size: 11px; overflow: elide; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;
                                    if row_touch.has-hover || idx == root.qb_index : HorizontalLayout { spacing: 6px; alignment: center;
                                    if item.kind == 1 : AuraButton { label: "⌨️ Type"; width: 88px; y: 2px; clicked => { root.type_selected(item.kind, item.id, item.username, item.password, item.totp); } }
                                    if item.totp != "" : AuraButton { label: "⏱️"; width: 44px; y: 2px; clicked => { root.copy_totp_selected(item.kind, item.id); } }
                                    if item.url != "" : AuraButton { label: "🌐"; width: 44px; y: 2px; clicked => { root.qb_open_url(item.url); } }
                                    }
                                    AuraButton { label: root.ui_lang == "bn" ? "📋 কপি" : "📋 Copy"; width: 88px; y: 2px; clicked => { root.item_selected(item.kind, item.id, item.password); } }
                                }
                            }
                        }
                        if root.filtered_results.length == 0 : Text { text: root.ui_lang == "bn" ? "কিছু মেলেনি — Esc, তারপর ভল্টে + New।" : "No matches — Esc, then + New in the vault."; color: PhantomTheme.text-muted; font-size: 12px; horizontal-alignment: center; }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "↑↓: pick  •  Enter: copy highlighted  •  🌐: open site  •  Esc: dismiss"; color: PhantomTheme.text-muted; font-size: 11px; vertical-alignment: center; }
                    AuraButton { label: root.ui_lang == "bn" ? "✕ বন্ধ করুন" : "✕ Dismiss"; width: 110px; height: 32px; clicked => { root.dismiss(); } }
                }
            }
        }
    }
}

// Phase 22 (+23): Smart-Grab quick-capture overlay (Alt + S)
export component QuickCaptureWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    width: 520px;
    height: 430px;
    background: transparent;
    title: "PhantomVault Quick Capture";

    in-out property <string> cap_title;
    in-out property <string> cap_user;
    in-out property <string> cap_pass;
    in-out property <string> cap_totp;
    in-out property <string> cap_hint: "";
    in-out property <string> cap_app: "";
    in-out property <bool> cap_show_pass: false;
    // A26: mirrors MainWindow.ui_lang so this separate window can localize.
    in-out property <string> ui_lang: "en";

    callback capture_save(string, string, string, string);
    callback capture_generate();
    callback capture_cancel();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #060e20f2;
        border-radius: 18px;
        border-color: PhantomTheme.primary;
        border-width: 1.5px;
        drop-shadow-blur: 48px;
        drop-shadow-color: #4edea366;
        clip: true;

        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.capture_cancel();
                    return accept;
                }
                if event.text == Key.Return {
                    root.capture_save(root.cap_title, root.cap_user, root.cap_pass, root.cap_totp);
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        background: PhantomTheme.primary;
                        Text { text: "⚡"; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text { text: root.ui_lang == "bn" ? "কুইক ক্যাপচার লগইন" : "Quick Capture Login"; color: PhantomTheme.text; font-size: 14px; font-weight: 800; }
                        Text { text: root.cap_hint == "" ? "Alt+S grabbed this app" : root.cap_hint; color: PhantomTheme.text-dim; font-size: 11px; }
                    }
                }

                FieldLabel { text: root.ui_lang == "bn" ? "সার্ভিসের নাম" : "SERVICE TITLE"; }
                LineEdit { placeholder-text: root.ui_lang == "bn" ? "যেমন Discord" : "e.g. Discord"; text <=> root.cap_title; height: 36px; }
                FieldLabel { text: root.ui_lang == "bn" ? "ইউজারনেম / ইমেইল" : "USERNAME / EMAIL"; }
                LineEdit { placeholder-text: root.ui_lang == "bn" ? "সম্ভব হলে স্বয়ংক্রিয়ভাবে শনাক্ত হবে" : "Detected automatically when possible"; text <=> root.cap_user; height: 36px; }
                FieldLabel { text: root.ui_lang == "bn" ? "পাসওয়ার্ড" : "PASSWORD"; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { placeholder-text: root.ui_lang == "bn" ? "পেস্ট করুন, টাইপ করুন, বা 🎲…" : "Paste, type, or 🎲…"; input-type: root.cap_show_pass ? text : password; text <=> root.cap_pass; height: 36px; horizontal-stretch: 1; accepted(text) => { root.capture_save(root.cap_title, root.cap_user, text, root.cap_totp); } }
                    AuraButton { label: root.cap_show_pass ? "🙈" : "👁"; width: 52px; height: 36px; clicked => { root.cap_show_pass = !root.cap_show_pass; } }
                    AuraButton { label: "🎲"; width: 56px; clicked => { root.capture_generate(); } }
                }
                FieldLabel { text: root.ui_lang == "bn" ? "2FA সিক্রেট (ঐচ্ছিক)" : "2FA SECRET (OPTIONAL)"; }
                LineEdit { placeholder-text: root.ui_lang == "bn" ? "2FA সেটআপ: otpauth সিক্রেট পেস্ট করুন" : "Paste otpauth secret when setting up 2FA"; text <=> root.cap_totp; height: 36px; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    AuraButton { label: root.ui_lang == "bn" ? "💾  ভল্টে সংরক্ষণ" : "💾  Save to Vault"; primary: true; width: 200px; clicked => { root.capture_save(root.cap_title, root.cap_user, root.cap_pass, root.cap_totp); } }
                    AuraButton { label: root.ui_lang == "bn" ? "✕ বন্ধ করুন" : "✕ Dismiss"; width: 130px; clicked => { root.capture_cancel(); } }
                }
            }
        }
    }
}
