                        Text { text: "🛡️ 2FA Coverage"; color: #eef1ff; font-size: 12px; vertical-alignment: center; width: 120px; }
                        Rectangle { background: #1a2450; border-radius: 6px; height: 12px; horizontal-stretch: 1; clip: true;
                            Rectangle { background: #10b981; border-radius: 6px; height: 12px; width: parent.width * root.health_coverage / 100; }
                        }
                        Text { text: root.health_coverage + "%"; color: #38e1ff; font-size: 12px; font-weight: 700; width: 44px; horizontal-alignment: right; }
                    }
                }}
            }}
        }
        if root.active_nav == 0 : HorizontalLayout {
            spacing: 0px; horizontal-stretch: 1;
            // 2. Column 2: Middle Items List (340px)
            Rectangle {
                width: 340px; background: #0b1226; clip: true;
                // Column-2 power shortcuts: / focuses search, ↑↓ cycle
                // selection, Esc deselects (idle unless a card/button inside
                // holds focus — typing in fields takes precedence).
                col2_keys := FocusScope {
                    key-pressed(event) => {
                            if event.text == "/" { search_input.focus(); return accept; }
                            if event.text == Key.UpArrow { root.cycle_select(-1); return accept; }
                            if event.text == Key.DownArrow { root.cycle_select(1); return accept; }
                            if event.text == Key.Escape { root.close_detail(); return accept; }
                        return reject;
                    }
                VerticalLayout { padding: 14px; spacing: 10px;
                    AuraButton { label: "+ New Item"; primary: true; height: 38px; clicked => { root.active_nav = 0; root.show_new_menu = !root.show_new_menu; } }
                    if root.show_shard_nudge : Rectangle { background: #2a1f08; border-radius: 10px; border-width: 1px; border-color: #fbbf24; VerticalLayout { padding: 10px; spacing: 6px;
                        Text { text: "📄 Print your recovery sheet?"; color: #fbbf24; font-size: 12px; font-weight: 800; horizontal-alignment: center; }
                        Text { text: "Lose your password without shards = vault gone forever."; color: #8e99c0; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                        HorizontalLayout { spacing: 6px; alignment: center;
                            AuraButton { label: "📄 Generate Now"; primary: true; width: 140px; height: 32px; clicked => { root.shard_nudge_generate(); } }
                            AuraButton { label: "Later"; width: 80px; height: 32px; clicked => { root.shard_nudge_later(); } }
                        }
                    }}
                    if root.show_new_menu : VerticalLayout { spacing: 4px;
                        HorizontalLayout { spacing: 6px;
                            AuraButton { label: "Login"; horizontal-stretch: 1; clicked => { root.open_new_form(1); } }
                            AuraButton { label: "Card"; horizontal-stretch: 1; clicked => { root.open_new_form(4); } }
                            AuraButton { label: "Identity"; horizontal-stretch: 1; clicked => { root.open_new_form(5); } }
                        }
                        HorizontalLayout { spacing: 6px;
                            AuraButton { label: "Note"; horizontal-stretch: 1; clicked => { root.open_new_form(3); } }
                            AuraButton { label: "License"; horizontal-stretch: 1; clicked => { root.open_new_form(2); } }
                            AuraButton { label: "SSH Key"; horizontal-stretch: 1; clicked => { root.open_new_form(6); } }
                        }
                    }
                    search_input := LineEdit { placeholder-text: "🔍 Search vault..."; text <=> root.search_query; height: 38px; edited(text) => { root.search_changed(text); } }
                    HorizontalLayout { spacing: 8px; alignment: center;
                        AuraButton { label: root.select_mode ? "☑️ Selecting…" : "☑️ Select"; width: 130px; height: 32px; primary: root.select_mode; clicked => { if root.select_mode { root.select_mode = false; root.clear_selection(); } else { root.select_mode = true; } } }
                    }
                    if root.show_fav_only && !root.showing_trash : Text { text: "⭐ Showing favorites only"; color: #fbbf24; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                    if root.showing_trash : VerticalLayout { spacing: 8px;
                        Text { text: "🗑️ Trash (items shredded after 30 days)"; color: #fb7185; font-size: 12px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                        if !root.show_empty_confirm : AuraButton { label: "🔥 Empty Trash & Shred All"; danger: true; height: 34px; clicked => { root.show_empty_confirm = true; } }
                        if root.show_empty_confirm : VerticalLayout { spacing: 6px;
                            Text { text: "Shred EVERYTHING in Trash? No undo."; color: #fb7185; font-size: 11px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                            HorizontalLayout { spacing: 8px; alignment: center;
                                AuraButton { label: "Yes, shred all"; danger: true; width: 140px; height: 32px; clicked => { root.empty_trash(); } }
                                AuraButton { label: "Cancel"; width: 100px; height: 32px; clicked => { root.show_empty_confirm = false; } }
                            }
                        }
                    }
                    ScrollView { vertical-stretch: 1; VerticalLayout { spacing: 8px;
                        for cred in root.credentials : Rectangle { background: root.d_id == cred.id ? #1a2450 : (touch.has-hover ? #1a2333 : #101834); border-radius: 10px; border-width: 1px; border-color: root.d_id == cred.id ? #38bdf8 : (touch.has-hover ? #38bdf855 : #26315c); height: 62px;
                            touch := TouchArea { mouse-cursor: pointer; clicked => { root.open_detail(cred.id); } }
                            if root.d_id == cred.id : Rectangle { width: 3px; height: 40px; x: 0; y: 11px; border-radius: 2px; background: #38bdf8; drop-shadow-blur: 8px; drop-shadow-color: #38bdf888; }
                            HorizontalLayout { padding-left: 14px; padding-right: 12px; padding-top: 10px; padding-bottom: 10px; spacing: 8px; alignment: space-between;
                                if root.select_mode : AuraButton { label: cred.sel ? "☑️" : "☐"; width: 36px; height: 30px; clicked => { root.toggle_select(cred.kind, cred.id); } }
                                if cred.has_icon : Image { source: cred.icon; width: 26px; height: 26px; image-fit: contain; vertical-alignment: center; }
                                if !cred.has_icon : Text { text: cred.kind == 1 ? "🔑" : (cred.kind == 2 ? "📜" : (cred.kind == 3 ? "📝" : (cred.kind == 4 ? "💳" : (cred.kind == 5 ? "🪪" : (cred.kind == 8 ? "⏱️" : "🔑"))))); font-size: 18px; vertical-alignment: center; }
                                VerticalLayout { horizontal-stretch: 1; spacing: 1px; Text { text: cred.title; color: #eef1ff; font-size: 13px; font-weight: 700; overflow: elide; } HorizontalLayout { spacing: 4px; Text { text: cred.username + " • " + cred.folder; color: #5b6589; font-size: 11px; overflow: elide; } if cred.verified : Text { text: "✅"; font-size: 11px; vertical-alignment: center; } } }
                                if cred.kind == 1 : AuraButton { label: root.last_copied_id == cred.id ? "✓" : "📋"; primary: root.last_copied_id == cred.id; width: 36px; height: 30px; clicked => { root.quick_copy(cred.kind, cred.id); } }
                                if cred.kind == 4 : AuraButton { label: root.last_copied_id == cred.id ? "✓" : "💳"; primary: root.last_copied_id == cred.id; width: 36px; height: 30px; clicked => { root.quick_copy(cred.kind, cred.id); } }
                                if cred.kind == 8 : AuraButton { label: root.last_copied_id == cred.id ? "✓" : "⏱️"; primary: root.last_copied_id == cred.id; width: 36px; height: 30px; clicked => { root.quick_copy(cred.kind, cred.id); } }
                                AuraButton { label: cred.fav ? "⭐" : "☆"; width: 36px; height: 30px; clicked => { root.toggle_favorite(cred.kind, cred.id); } }
                                Text { text: cred.health == "breached" ? "🔴" : cred.health == "weak" ? "🟡" : cred.health == "reused" ? "♻️" : cred.health == "stale" ? "🕰️" : ""; font-size: 12px; vertical-alignment: center; }
                            }
                        }
                        if root.credentials.length == 0 : VerticalLayout { spacing: 8px; alignment: center; padding-top: 40px;
                            Text { text: root.showing_trash ? "🗑️✨" : (root.show_fav_only ? "⭐" : "📭"); font-size: 44px; horizontal-alignment: center; }
                            Text { text: root.showing_trash ? "Trash is empty — shredded items are gone for good." : (root.show_fav_only ? "No favorites yet — tap ⭐ on any item." : "Vault is empty — add your first login."); color: #5b6589; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                            if !root.showing_trash && !root.show_fav_only : AuraButton { label: "+ New Login"; primary: true; width: 170px; height: 36px; clicked => { root.open_new_form(1); } }
                        }
                        if root.total_matches_count > root.credentials.length : AuraButton { label: "⬇️ Load 50 More (" + (root.total_matches_count - root.credentials.length) + " remaining)"; horizontal-stretch: 1; height: 36px; clicked => { root.load_more_items(); } }
                        if root.total_matches_count > 0 : Text { text: "Showing " + Math.min(root.credentials.length, root.total_matches_count) + " of " + root.total_matches_count; color: #5b6589; font-size: 11px; horizontal-alignment: center; }
                    }}
                    // Floating bulk action bar (Select mode, non-empty selection)
                    if root.select_mode && root.selected_count > 0 : Rectangle { background: #0d131f; border-radius: 12px; border-width: 1px; border-color: #8b7cf6; VerticalLayout { padding: 10px; spacing: 8px;
                        Text { text: root.selected_label; color: #eef1ff; font-size: 12px; font-weight: 800; horizontal-alignment: center; }
                        HorizontalLayout { spacing: 6px;
                            AuraButton { label: "⭐ Favorite All"; horizontal-stretch: 1; height: 34px; clicked => { root.bulk_favorite(); } }
                            AuraButton { label: "🗑️ Trash"; horizontal-stretch: 1; height: 34px; danger: true; clicked => { root.bulk_trash(); } }
                        }
                        HorizontalLayout { spacing: 6px;
                            ComboBox { model: root.filter_folders; current-value <=> root.bulk_folder; horizontal-stretch: 1; height: 34px; }
                            AuraButton { label: "📁 Move"; width: 90px; height: 34px; clicked => { root.bulk_move(root.bulk_folder); } }
                        }
                        AuraButton { label: "✕ Deselect All"; height: 32px; clicked => { root.clear_selection(); } }
                    }}
                }
                }
            }
            // 3. Column 3: Right Inspection Detail Panel (stretch)
            Rectangle {
                background: #080c14; horizontal-stretch: 1; clip: true;
                ScrollView { VerticalLayout { padding: 18px; spacing: 12px;
                    // NEW FORM (when +New active)
                    if root.show_add_form : Rectangle { background: #0d131f; border-radius: 12px; border-width: 1px; border-color: #8b7cf6; VerticalLayout { padding: 14px; spacing: 8px;
                        HorizontalLayout { spacing: 6px; AuraButton { label: "Login"; primary: root.new_kind==1; width: 70px; clicked => { root.new_kind=1; } } AuraButton { label: "Card"; primary: root.new_kind==4; width: 70px; clicked => { root.new_kind=4; } } AuraButton { label: "Note"; primary: root.new_kind==3; width: 70px; clicked => { root.new_kind=3; } } AuraButton { label: "✕"; width: 40px; clicked => { root.cancel_form(); } } }
                        FieldLabel { text: "ITEM DETAILS"; }
                        LineEdit { placeholder-text: "Item name (required)"; text <=> root.f_title; height: 36px; }
                        ComboBox { model: root.folders_list; current-value <=> root.f_folder; }
                        FieldLabel { text: "LOGIN CREDENTIALS"; }
                        HorizontalLayout { spacing: 6px; LineEdit { placeholder-text: root.new_kind == 1 ? "Username / Email" : "Field A"; text <=> root.f_a; height: 36px; horizontal-stretch: 1; } if root.new_kind == 1 : AuraButton { label: "🎭 Alias"; width: 90px; height: 36px; clicked => { root.generate_alias_for_form(); } } }
                        HorizontalLayout { spacing: 6px; LineEdit { placeholder-text: root.new_kind == 1 ? "Password" : "Field B (secret)"; input-type: password; text <=> root.f_b; height: 36px; horizontal-stretch: 1; } AuraButton { label: "🎲"; width: 52px; height: 36px; clicked => { root.show_generator = true; root.regenerate(); } } }
                        Text { text: "Use the generator 🎲 to create a strong unique password"; color: #5b6589; font-size: 11px; }
                        // Non-login kinds: Field C/D/E have NO inputs elsewhere
                        // (f_d/f_e were unwritable) — per-kind labels here.
                        if root.new_kind == 4 || root.new_kind == 5 || root.new_kind == 6 : VerticalLayout { spacing: 8px;
                            FieldLabel { text: "EXTRA FIELDS"; }
                            LineEdit { placeholder-text: root.new_kind == 4 ? "Expiry MM/YY" : (root.new_kind == 5 ? "Email" : "Fingerprint"); text <=> root.f_c; height: 36px; }
                        }
                        if root.new_kind == 4 || root.new_kind == 5 : VerticalLayout { spacing: 8px;
                            LineEdit { placeholder-text: root.new_kind == 4 ? "CVV" : "Phone"; text <=> root.f_d; height: 36px; }
                        }
                        if root.new_kind == 5 : LineEdit { placeholder-text: "Address"; text <=> root.f_e; height: 36px; }
                        if root.new_kind == 1 : VerticalLayout { spacing: 8px;
                            FieldLabel { text: "AUTHENTICATOR KEY (TOTP)"; }
                            LineEdit { placeholder-text: "Paste otpauth secret…"; text <=> root.f_totp; height: 36px; }
                            FieldLabel { text: "BACKUP / RECOVERY CODES"; }
                            TextEdit { placeholder-text: "Paste one-time recovery / backup codes here (one per line)..."; text <=> root.f_backup; height: 56px; wrap: word-wrap; }
                            FieldLabel { text: "AUTOFILL OPTIONS"; }
                            LineEdit { placeholder-text: "Website (URI), e.g. https://example.com/login"; text <=> root.f_c; height: 36px; }
                            for url[idx] in root.f_urls : HorizontalLayout { spacing: 6px; LineEdit { placeholder-text: "Additional website (URI)…"; text: url; height: 36px; horizontal-stretch: 1; edited(text) => { root.update_url(idx, text); } } AuraButton { label: "🗑️"; width: 44px; height: 36px; danger: true; clicked => { root.remove_url(idx); } } }
                            AuraButton { label: "+ Add website"; height: 34px; clicked => { root.add_url(); } }
                            FieldLabel { text: "SECRET KEYS / API TOKENS"; }
                            for cf[idx] in root.custom_fields : Rectangle { background: #121927; border-radius: 8px; height: 36px; HorizontalLayout { padding-left: 10px; padding-right: 6px; spacing: 8px; Text { text: (cf.ftype == 1 ? "🔒 " : (cf.ftype == 2 ? "☑ " : (cf.ftype == 3 ? "🔗 " : "📝 "))) + cf.name; color: #8e99c0; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; } if cf.ftype == 1 : Text { text: "••••"; color: #eef1ff; font-size: 12px; vertical-alignment: center; } if cf.ftype == 2 : Text { text: cf.value == "true" ? "☑" : "☐"; color: #eef1ff; font-size: 14px; vertical-alignment: center; } if cf.ftype == 3 : Text { text: "→ " + cf.value; color: #8b7cf6; font-size: 12px; vertical-alignment: center; overflow: elide; } if cf.ftype == 0 : Text { text: cf.value; color: #8b7cf6; font-size: 12px; vertical-alignment: center; overflow: elide; } AuraButton { label: "🗑"; width: 40px; height: 24px; y: 6px; danger: true; clicked => { root.delete_custom_field(idx); } } } }
                            AuraButton { label: "+ Add Custom Field"; height: 34px; clicked => { root.show_cf_dialog = true; } }
                        }
                        FieldLabel { text: "NOTES"; }
                        TextEdit { text <=> root.f_notes; height: 64px; wrap: word-wrap; }
                        HorizontalLayout { spacing: 12px;
                            CheckBox { text: "Master password re-prompt"; checked <=> root.f_reprompt; }
                            CheckBox { text: "⭐ Favorite"; checked <=> root.f_fav; }
                            CheckBox { text: "✈️ Travel safe"; checked <=> root.f_travel; }
                        }
                        HorizontalLayout { spacing: 8px;
                            AuraButton { label: "💾 Save"; primary: true; horizontal-stretch: 1; height: 38px; clicked => { root.add_item_requested(root.new_kind, root.f_title, root.f_a, root.f_b, root.f_c, root.f_d, root.f_e, root.f_notes, root.f_folder, root.f_totp, root.f_backup, root.f_reprompt, root.f_fav, root.f_travel); } }
                            AuraButton { label: "Cancel"; width: 120px; height: 38px; clicked => { root.cancel_form(); } }
                        }
                    }}
                    if root.notification_text != "" : Rectangle { background: #101834; border-radius: 8px; height: 32px; HorizontalLayout { padding-left: 12px; padding-right: 4px; spacing: 8px; Text { text: root.notification_text; color: #38e1ff; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; } AuraButton { label: "✕"; width: 36px; height: 24px; y: 4px; clicked => { root.notification_text = ""; } } } }
                    if root.is_travel_mode : Rectangle { background: #2a1f08; border-radius: 8px; height: 28px; Text { text: "✈️ TRAVEL MODE"; color: #fbbf24; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
                    // SELECTED ITEM DETAIL
                    // Peep pad stays instantiated (detail rows bind
                    // peep_hold_col.pressed) but visible:false collapses it
                    // from layout AND skips rendering: a zero-height
                    // Rectangle + border + Text child bleeds a half-clipped
                    // ghost line under the hero on some backends.
                    Rectangle {
                        visible: root.peep_hole_mode;
                        height: 40px;
                        background: peep_hold_col.pressed ? #8b7cf6 : #1a2450;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #8b7cf6;
                        clip: true;
                        peep_hold_col := TouchArea { }
                        Text { text: peep_hold_col.pressed ? "👁 REVEALING — release to mask" : "👁 HOLD TO PEEK (ephemeral)"; color: #ffffff; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.d_id != "" : VerticalLayout { spacing: 12px;
                        // CARD 1: header + primary action (Bitwarden style)
                        Rectangle { background: #111827; border-radius: 8px; border-width: 1px; border-color: #1e293b; VerticalLayout { padding: 14px; spacing: 10px;
                            HorizontalLayout { spacing: 10px;
                                if root.d_has_icon : Image { source: root.d_icon; width: 30px; height: 30px; image-fit: contain; vertical-alignment: center; }
                                if !root.d_has_icon : Text { text: root.d_kind == 1 ? "🔑" : (root.d_kind == 2 ? "📜" : (root.d_kind == 3 ? "📝" : (root.d_kind == 4 ? "💳" : (root.d_kind == 5 ? "🪪" : (root.d_kind == 8 ? "⏱️" : "🔑"))))); font-size: 26px; vertical-alignment: center; }
                                VerticalLayout { horizontal-stretch: 1; spacing: 2px;
                                    HorizontalLayout { spacing: 6px; Text { text: root.d_title; color: #eef1ff; font-size: 16px; font-weight: 800; overflow: elide; } if root.d_verified : Text { text: "✅"; font-size: 14px; vertical-alignment: center; } }
                                    HorizontalLayout { spacing: 6px; Text { text: "📁 " + root.d_folder; color: #8b7cf6; font-size: 11px; font-weight: 700; vertical-alignment: center; } if root.d_reprompt : Text { text: "🔒"; font-size: 12px; vertical-alignment: center; } }
                                }
                                AuraButton { label: root.d_fav ? "⭐" : "☆"; width: 44px; height: 34px; clicked => { root.toggle_favorite(root.d_kind, root.d_id); } }
                                if root.d_kind == 1 : AuraButton { label: "🖼️"; width: 44px; height: 34px; clicked => { root.override_favicon(root.d_id); } }
                            }
                            if !root.d_trashed : AuraButton { label: "⚡ Autofill / Type"; primary: true; horizontal-stretch: 1; height: 40px; clicked => { root.type_item_requested(root.d_kind, root.d_id); } }
                        }}
                        if root.d_trashed : Rectangle { background: #2a1f08; border-radius: 8px; height: 30px; Text { text: "⚠️ This item is in Trash"; color: #fbbf24; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                        if root.d_stale : Text { text: "⚠️ Password is over 6 months old (Consider rotating)"; color: #fbbf24; font-size: 12px; font-weight: 700; wrap: word-wrap; }
                        // CARD 2: login credentials
                        if root.d_kind != 8 : Rectangle { background: #111827; border-radius: 8px; border-width: 1px; border-color: #1e293b; VerticalLayout { padding: 12px; spacing: 8px;
                            FieldLabel { text: "LOGIN CREDENTIALS"; }
                            FieldLabel { text: "USERNAME"; }
                            if root.d_user != "" : HorizontalLayout { spacing: 8px; Text { text: root.d_user; color: #eef1ff; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; } AuraButton { label: root.last_copied == root.d_user && root.last_copied != "" ? "✓ Copied" : "📋 Copy"; primary: root.last_copied == root.d_user && root.last_copied != ""; width: 76px; height: 30px; clicked => { root.copy_password_requested(root.d_user); } } }
                            Rectangle { height: 1px; background: #1e293b; }
                            FieldLabel { text: "PASSWORD"; }
                            HorizontalLayout { spacing: 8px; Text { text: root.peep_hole_mode && !peep_hold_col.pressed ? "••••••••" : (root.d_secret_visible ? root.d_secret : "••••••••"); color: #38e1ff; font-size: 14px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; } AuraButton { label: root.d_secret_visible ? "🙈" : "👁️"; width: 44px; height: 30px; clicked => { if !root.peep_hole_mode { root.d_secret_visible = !root.d_secret_visible; } } } AuraButton { label: root.last_copied == root.d_secret && root.last_copied != "" ? "✓" : "📋"; primary: root.last_copied == root.d_secret && root.last_copied != ""; width: 44px; height: 30px; clicked => { root.copy_password_requested(root.d_secret); } } AuraButton { label: "🎲"; width: 44px; height: 30px; clicked => { root.show_generator = true; root.regenerate(); } } }
                            if root.d_kind == 1 && root.d_secret != "" && root.d_pw_strength_label != "" : VerticalLayout { spacing: 4px;
                                HorizontalLayout { spacing: 8px;
                                    Rectangle { background: #1e293b; border-radius: 4px; height: 8px; horizontal-stretch: 1; y: 4px;
                                        Rectangle { background: root.d_pw_strength >= 1.0 ? #34d399 : (root.d_pw_strength >= 0.75 ? #a3e635 : (root.d_pw_strength >= 0.5 ? #fbbf24 : #fb7185)); border-radius: 4px; width: parent.width * root.d_pw_strength; height: 8px; }
                                    }
                                }
                                Text { text: "🛡️ " + root.d_pw_strength_label; color: #8e99c0; font-size: 11px; wrap: word-wrap; }
                            }
                            if root.d_kind == 1 && root.d_history.length > 0 : VerticalLayout { spacing: 6px;
                                AuraButton { label: root.show_history ? "📜 Hide Password History (" + root.d_history.length + ")" : "📜 Password History (" + root.d_history.length + ")"; width: 250px; height: 30px; clicked => { root.show_history = !root.show_history; } }
                                if root.show_history : VerticalLayout { spacing: 4px;
                                    for h in root.d_history : Rectangle { background: #121927; border-radius: 8px; height: 36px; HorizontalLayout { padding-left: 10px; padding-right: 6px; spacing: 8px; Text { text: h.when; color: #5b6589; font-size: 11px; width: 90px; vertical-alignment: center; } Text { text: root.peep_hole_mode && !peep_hold_col.pressed ? "••••" : h.password; color: #8e99c0; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; } AuraButton { label: "📋"; width: 40px; height: 24px; y: 6px; clicked => { root.copy_password_requested(h.password); } } } }
                                }
                            }
                        }}
                        // Embedded / standalone 2FA live card
                        if root.d_totp != "" : Rectangle { background: #0d131f; border-radius: 8px; border-width: 1px; border-color: #8b7cf655; HorizontalLayout { padding: 12px; spacing: 10px; alignment: space-between; VerticalLayout { spacing: 2px; Text { text: "2FA CODE — " + root.d_title; color: #8e99c0; font-size: 11px; font-weight: 700; overflow: elide; } Text { text: root.live_totp_code; color: #38e1ff; font-size: 26px; font-weight: 900; } } HorizontalLayout { spacing: 8px; Rectangle { width: 52px; height: 52px; border-radius: 26px; border-width: 2px; border-color: #fbbf24; Text { text: root.totp_countdown; color: #fbbf24; font-size: 12px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } } AuraButton { label: root.last_copied == root.live_totp_code && root.last_copied != "" ? "✓ Copied" : "📋 Copy 2FA"; primary: root.last_copied == root.live_totp_code && root.last_copied != ""; width: 84px; height: 30px; y: 11px; clicked => { root.copy_password_requested(root.live_totp_code); } } } } }
                        // CARD 3: auto-fill options — single-line elided URL, never wraps
                        if root.d_url != "" : Rectangle { background: #111827; border-radius: 8px; border-width: 1px; border-color: #1e293b; VerticalLayout { padding: 12px; spacing: 8px;
                            FieldLabel { text: "AUTO-FILL OPTIONS"; }
                            HorizontalLayout { spacing: 8px; Text { text: root.d_url; color: #8e99c0; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; } AuraButton { label: "↗️"; width: 44px; height: 30px; clicked => { root.open_url(root.d_url); } } AuraButton { label: root.last_copied == root.d_url && root.last_copied != "" ? "✓" : "📋"; primary: root.last_copied == root.d_url && root.last_copied != ""; width: 44px; height: 30px; clicked => { root.copy_password_requested(root.d_url); } } }
                            if root.d_urls_extra != "" : Text { text: root.d_urls_extra; color: #5b6589; font-size: 11px; overflow: elide; }
                        }}
                        // CARD 4: additional options (only when populated)
                        if root.d_backup != "" : Rectangle { background: #111827; border-radius: 8px; border-width: 1px; border-color: #1e293b; VerticalLayout { padding: 12px; spacing: 8px;
                            FieldLabel { text: "BACKUP / RECOVERY CODES"; }
                            Rectangle { background: #121927; border-radius: 8px; height: 64px; clip: true; Text { x: 10px; y: 6px; width: parent.width - 20px; height: parent.height - 12px; text: root.peep_hole_mode && !peep_hold_col.pressed ? "••••" : root.d_backup; color: #eef1ff; font-size: 12px; wrap: word-wrap; overflow: elide; } }
                            HorizontalLayout { alignment: center; AuraButton { label: "📋  Copy All Codes"; width: 190px; height: 30px; clicked => { root.copy_password_requested(root.d_backup); } } }
                        }}
                        if root.d_custom.length > 0 : Rectangle { background: #111827; border-radius: 8px; border-width: 1px; border-color: #1e293b; VerticalLayout { padding: 12px; spacing: 6px;
                            FieldLabel { text: "CUSTOM FIELDS"; }
                            for cf[idx] in root.d_custom : Rectangle { background: #121927; border-radius: 8px; height: 36px; HorizontalLayout { padding-left: 10px; padding-right: 6px; spacing: 8px; Text { text: (cf.ftype == 1 ? "🔒 " : (cf.ftype == 2 ? "☑ " : (cf.ftype == 3 ? "🔗 " : "📝 "))) + cf.name; color: #8e99c0; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; } if cf.ftype == 0 : Text { text: cf.value; color: #eef1ff; font-size: 12px; vertical-alignment: center; overflow: elide; } if cf.ftype == 0 : AuraButton { label: "📋"; width: 40px; height: 24px; y: 6px; clicked => { root.copy_password_requested(cf.value); } } if cf.ftype == 1 : Text { text: root.peep_hole_mode && !peep_hold_col.pressed ? "••••" : (root.d_revealed == idx ? cf.value : "••••"); color: #38e1ff; font-size: 12px; vertical-alignment: center; overflow: elide; } if cf.ftype == 1 : AuraButton { label: root.d_revealed == idx ? "👁️‍🗨️" : "👁️"; width: 40px; height: 24px; y: 6px; clicked => { if !root.peep_hole_mode { root.d_revealed = root.d_revealed == idx ? -1 : idx; } } } if cf.ftype == 1 : AuraButton { label: "📋"; width: 40px; height: 24px; y: 6px; clicked => { root.copy_password_requested(cf.value); } } if cf.ftype == 2 : AuraButton { label: cf.value == "true" ? "✓ ON" : "✕ OFF"; primary: cf.value == "true"; width: 76px; height: 24px; y: 6px; clicked => { root.toggle_saved_field(root.d_kind, root.d_id, idx); } } if cf.ftype == 3 : Text { text: root.peep_hole_mode && !peep_hold_col.pressed ? "••••" : (cf.value == "username" ? root.d_user : root.d_secret); color: #38e1ff; font-size: 12px; vertical-alignment: center; overflow: elide; } if cf.ftype == 3 : AuraButton { label: "📋"; width: 40px; height: 24px; y: 6px; clicked => { root.copy_password_requested(cf.value == "username" ? root.d_user : root.d_secret); } } } }
                        }}
                        if root.d_notes != "" : Rectangle { background: #111827; border-radius: 8px; border-width: 1px; border-color: #1e293b; VerticalLayout { padding: 12px; spacing: 8px;
                            FieldLabel { text: "NOTES"; }
                            Text { text: root.d_notes; color: #8e99c0; font-size: 12px; wrap: word-wrap; }
                        }}
                        if root.d_attachments.length > 0 : Rectangle { background: #111827; border-radius: 8px; border-width: 1px; border-color: #1e293b; VerticalLayout { padding: 12px; spacing: 6px;
                            FieldLabel { text: "ATTACHMENTS"; }
                            for att in root.d_attachments : Rectangle { background: #121927; border-radius: 8px; height: 36px; HorizontalLayout { padding-left: 10px; padding-right: 6px; spacing: 8px; Text { text: att.filename + " (" + att.size + ")"; color: #eef1ff; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; } AuraButton { label: "👁"; width: 40px; height: 24px; y: 6px; clicked => { root.preview_attachment(root.d_kind, root.d_id, att.id); } } AuraButton { label: "💾"; width: 40px; height: 24px; y: 6px; clicked => { root.download_attachment(root.d_kind, root.d_id, att.id); } } AuraButton { label: "🗑"; width: 36px; height: 24px; y: 6px; danger: true; clicked => { root.delete_attachment(root.d_kind, root.d_id, att.id); } } } }
                            HorizontalLayout { alignment: center; AuraButton { label: "📎  Attach File"; width: 180px; height: 32px; clicked => { root.pick_attachment(root.d_kind, root.d_id); } } }
                        }}
                        // CARD 5: item history & safety
                        Rectangle { background: #111827; border-radius: 8px; border-width: 1px; border-color: #1e293b; VerticalLayout { padding: 12px; spacing: 8px;
                            FieldLabel { text: "ITEM HISTORY"; }
                            // d_health carries the full audit badge TEXT
                            // ("🚨 Leaked in N breaches!.." / "⚠️ Reused password" /
                            // "⚠️ Weak password" / "🕰️ Over 6 months old").
                            if root.d_health != "" : Text { text: root.d_health; color: #fbbf24; font-size: 12px; font-weight: 800; wrap: word-wrap; }
                            if root.d_age_info != "" : Text { text: root.d_age_info; color: #8e99c0; font-size: 12px; wrap: word-wrap; }
                            if root.d_fill_info != "" : Text { text: "📊 " + root.d_fill_info; color: #8e99c0; font-size: 12px; wrap: word-wrap; }
                            if root.d_kind == 1 && !root.d_trashed : HorizontalLayout { spacing: 8px; alignment: center;
                                AuraButton { label: root.d_verified ? "✅ Verified working" : "Mark as working ✓"; primary: !root.d_verified; width: 200px; height: 32px; clicked => { root.toggle_verified(root.d_kind, root.d_id); } }
                            }
                            HorizontalLayout { spacing: 8px; FieldLabel { text: "✈️ SAFE FOR TRAVEL"; vertical-alignment: center; } Text { text: root.d_travel ? "ON ✓" : "OFF"; color: root.d_travel ? #34d399 : #5b6589; font-size: 12px; font-weight: 700; vertical-alignment: center; } }
                        }}
                        // Bottom action bar
                        if root.d_trashed : HorizontalLayout { spacing: 8px; AuraButton { label: "♻️ Restore Item"; primary: true; horizontal-stretch: 1; height: 36px; clicked => { root.restore_item(root.d_kind, root.d_id); } } AuraButton { label: "🔥 Permanently Shred"; danger: true; horizontal-stretch: 1; height: 36px; clicked => { root.delete_item_requested(root.d_kind, root.d_id); } } AuraButton { label: "✕ Close Selection"; width: 140px; height: 36px; clicked => { root.close_detail(); } } }
                        if !root.d_trashed : HorizontalLayout { spacing: 8px; if root.d_kind != 8 : AuraButton { label: "✏️ Edit"; primary: true; horizontal-stretch: 1; height: 36px; clicked => { root.edit_item_requested(root.d_kind, root.d_id); } } AuraButton { label: "🗑️ Delete"; danger: true; horizontal-stretch: 1; height: 36px; clicked => { root.delete_item_requested(root.d_kind, root.d_id); } } AuraButton { label: "✕ Close Selection"; width: 140px; height: 36px; clicked => { root.close_detail(); } } }
                    }
                    if root.d_id == "" && !root.show_add_form : Text { text: "🛡️ Select an item from the list to view details"; color: #5b6589; font-size: 13px; horizontal-alignment: center; }
                }}
                // Phase 26: moiré veil floats ABOVE the card content when armed.
                if root.moire_guard_active : MoireVeil {
                    x: (parent.width - 480px) / 2;
                    y: 12px;
                    width: 480px;
                    height: parent.height - 24px;
                }
            }
        }
    }

    // ==== Generator floating layer
    if root.show_autofill_pill : Rectangle {
        x: parent.width - 220px; y: parent.height - 70px; width: 200px; height: 44px;
        background: #8b7cf6; border-radius: 12px;
        TouchArea { mouse-cursor: pointer; clicked => { root.autofill_pill_clicked(); } }
        Text { text: "🔑 Fill " + root.pill_title; color: #ffffff; font-size: 13px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    }
    // ==== Generator floating layer (window-level, never under taskbar) ====
    if root.show_generator : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060ecc;
        TouchArea {
            clicked => { root.close_panel(); }
        }
        GeneratorPanel {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            gen_length <=> root.gen_length;
            gen_uppercase <=> root.gen_uppercase;
            gen_lowercase <=> root.gen_lowercase;
            gen_digits <=> root.gen_digits;
            gen_symbols <=> root.gen_symbols;
            gen_exclude_ambiguous <=> root.gen_exclude_ambiguous;
            gen_diceware_mode <=> root.gen_diceware_mode;
            gen_dice_lang <=> root.gen_dice_lang;
            gen_word_count <=> root.gen_word_count;
            gen_output <=> root.gen_output;
            gen_entropy_bits <=> root.gen_entropy_bits;
            regenerate() => { root.regenerate(); }
            use_password(pwd) => { root.use_password(pwd); }
            close_panel() => { root.close_panel(); }
        }
    }

    // ==== + Add Field dialog (custom field builder) ====
    if root.show_cf_dialog : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060ecc;
        TouchArea {
            clicked => { root.show_cf_dialog = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 400px;
            background: #0d131f;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: #8b7cf6;
            drop-shadow-blur: 40px;
            drop-shadow-color: #8b7cf644;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "+ Add Custom Field"; font-size: 16px; font-weight: 800; color: #eef1ff; horizontal-alignment: center; }
                HorizontalLayout {
                    spacing: 6px;
                    AuraButton { label: "📝 Text"; primary: root.cf_type == 0; horizontal-stretch: 1; clicked => { root.cf_type = 0; } }
                    AuraButton { label: "🔒 Hidden"; primary: root.cf_type == 1; horizontal-stretch: 1; clicked => { root.cf_type = 1; } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    AuraButton { label: "☑ Check"; primary: root.cf_type == 2; horizontal-stretch: 1; clicked => { root.cf_type = 2; } }
                    AuraButton { label: "🔗 Link"; primary: root.cf_type == 3; horizontal-stretch: 1; clicked => { root.cf_type = 3; root.cf_value = "password"; } }
                }
                Text { text: root.cf_type == 1 ? "Hidden fields mask secrets with an eye toggle." : (root.cf_type == 2 ? "Checkbox starts OFF — toggle anytime." : (root.cf_type == 3 ? "Linked field mirrors Username or Password live — no duplicated secret." : "Text fields fit security questions & extras.")); color: #5b6589; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                FieldLabel { text: "FIELD LABEL *"; }
                LineEdit { placeholder-text: "e.g. Security question"; text <=> root.cf_name; height: 38px; }
                if root.cf_type == 0 || root.cf_type == 1 : VerticalLayout {
                    spacing: 10px;
                    FieldLabel { text: "VALUE"; }
                    LineEdit { placeholder-text: "Value…"; input-type: root.cf_type == 1 ? password : text; text <=> root.cf_value; height: 38px; }
                }
                if root.cf_type == 3 : VerticalLayout {
                    spacing: 10px;
                    FieldLabel { text: "MIRROR TARGET"; }
                    HorizontalLayout {
                        spacing: 6px;
                        AuraButton { label: "Username"; primary: root.cf_value == "username"; horizontal-stretch: 1; clicked => { root.cf_value = "username"; } }
                        AuraButton { label: "Password"; primary: root.cf_value == "password"; horizontal-stretch: 1; clicked => { root.cf_value = "password"; } }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    AuraButton { label: "Add"; primary: true; width: 130px; clicked => { root.add_custom_field(root.cf_type, root.cf_name, root.cf_value); } }
                    AuraButton { label: "Cancel"; width: 130px; clicked => { root.show_cf_dialog = false; } }
                }
            }
        }
    }

    // ==== Master-reprompt gate modal ====
    if root.rp_show : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060ecc;
        TouchArea { clicked => { root.rp_show = false; root.rp_error = ""; } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 400px;
            background: #0d131f;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: #fbbf24;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000088;
            VerticalLayout {
                padding: 22px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    Rectangle {
                        width: 46px;
                        height: 46px;
                        border-radius: 23px;
                        background: #2a1f08;
                        border-width: 1.5px;
                        border-color: #fbbf24;
                        Text { text: "🔒"; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Master Reprompt"; font-size: 16px; font-weight: 800; color: #eef1ff; }
                        Text { text: root.rp_action == 2 ? "Auto-fill this login" : (root.rp_action == 3 ? "Delete this item" : (root.rp_action == 5 ? "Export vault PLAINTEXT" : "Reveal this secret")); color: #fbbf24; font-size: 12px; font-weight: 700; }
                    }
                }
                Text { text: "This item demands master-password confirmation."; color: #8e99c0; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                if root.rp_user != "" : Text { text: "for " + root.rp_user; color: #5b6589; font-size: 11px; horizontal-alignment: center; overflow: elide; }
                rp_input := LineEdit { placeholder-text: "Master password…"; input-type: password; height: 46px; font-size: 15px; accepted(text) => { root.reprompt_confirm(text); } }
                if root.rp_error != "" : Text { text: root.rp_error; color: #fb7185; font-size: 12px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    AuraButton { label: "Confirm"; primary: true; width: 150px; height: 42px; clicked => { root.reprompt_confirm(rp_input.text); } }
                    AuraButton { label: "✕ Cancel"; width: 130px; height: 42px; clicked => { root.rp_show = false; root.rp_error = ""; } }
                }
            }
        }
    }

    // ==== What's New changelog (GitHub release notes, read-only) ====
    if root.show_changelog : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060ecc;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 480px;
            background: #0d131f;
            border-radius: 16px;
            border-width: 1px;
            border-color: #8b7cf6;
            clip: true;
            VerticalLayout { padding: 20px; spacing: 10px;
                Text { text: "🎉 What's New in " + root.update_tag; color: #34d399; font-size: 15px; font-weight: 900; horizontal-alignment: center; wrap: word-wrap; }
                Rectangle { background: #111827; border-radius: 8px; height: 300px; clip: true;
                    ScrollView { VerticalLayout { padding: 12px; Text { text: root.update_notes; color: #eef1ff; font-size: 12px; wrap: word-wrap; } } }
                }
                HorizontalLayout { spacing: 8px; alignment: center;
                    if !root.update_ready : AuraButton { label: "⬇️ Download & Stage"; primary: true; width: 190px; height: 38px; clicked => { root.show_changelog = false; root.download_update(); } }
                    if root.update_ready : AuraButton { label: "🔄 Restart to Update"; primary: true; width: 190px; height: 38px; clicked => { root.show_changelog = false; root.restart_update(); } }
                    AuraButton { label: "✕ Close"; width: 120px; height: 38px; clicked => { root.show_changelog = false; } }
                }
            }
        }
    }

    // ==== Attachment RAM preview (images decoded to pixels, text to string —
    // plaintext never touches disk) ====
    if root.att_preview : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060ecc;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 480px;
            background: #0d131f;
            border-radius: 16px;
            border-width: 1px;
            border-color: #8b7cf6;
            clip: true;
            VerticalLayout { padding: 16px; spacing: 10px;
                Text { text: "📎 " + root.att_preview_name; color: #eef1ff; font-size: 14px; font-weight: 800; horizontal-alignment: center; overflow: elide; }
                Text { text: root.att_preview_info; color: #5b6589; font-size: 11px; horizontal-alignment: center; }
                if root.att_preview_kind == "image" : HorizontalLayout { alignment: center;
                    Image { source: root.att_preview_image; width: 440px; height: 320px; image-fit: contain; }
                }
                if root.att_preview_kind == "text" : Rectangle { background: #111827; border-radius: 8px; height: 320px; clip: true;
                    ScrollView { VerticalLayout { padding: 10px; Text { text: root.att_preview_text; color: #eef1ff; font-size: 12px; wrap: word-wrap; } } }
                }
                if root.att_preview_kind == "other" : Text { text: "No in-app preview for this file type — export to view."; color: #fbbf24; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout { spacing: 8px; alignment: center;
                    AuraButton { label: "💾 Export File"; width: 140px; height: 36px; clicked => { root.att_preview = false; root.download_attachment(root.d_kind, root.d_id, root.att_preview_id); } }
                    AuraButton { label: "🗑️ Delete"; width: 120px; height: 36px; danger: true; clicked => { root.att_preview = false; root.delete_attachment(root.d_kind, root.d_id, root.att_preview_id); } }
                    AuraButton { label: "✕ Close Preview"; width: 150px; height: 36px; clicked => { root.att_preview = false; } }
                }
            }
        }
    }

    // ==== Factory reset triple-gate (Danger Zone + lock recovery link) ====
    if root.show_factory_reset : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060ecc;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 480px;
            background: #0d131f;
            border-radius: 16px;
            border-width: 1px;
            border-color: #fb7185;
            clip: true;
            VerticalLayout { padding: 20px; spacing: 10px;
                Text { text: "🔥 Factory Reset — shred EVERYTHING?"; color: #fb7185; font-size: 16px; font-weight: 900; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: "Vault file, all backup generations, decoy container, and machine seals are DoD-shredded. Recovery is IMPOSSIBLE afterwards."; color: #8e99c0; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                FieldLabel { text: "MASTER PASSWORD"; }
                LineEdit { placeholder-text: "Confirm master password…"; input-type: password; text <=> root.fr_password; height: 40px; }
                FieldLabel { text: "TYPE DELETE TO CONTINUE"; }
                LineEdit { placeholder-text: "DELETE"; text <=> root.fr_delete_text; height: 40px; }
                if root.fr_error != "" : Text { text: root.fr_error; color: #fbbf24; font-size: 12px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                if root.fr_countdown > 0 : Text { text: "💣 " + root.fr_countdown + "…"; color: #fb7185; font-size: 30px; font-weight: 900; horizontal-alignment: center; }
                if !root.fr_armed : AuraButton { label: "⏳ Verify & Start 5s Countdown"; primary: true; horizontal-stretch: 1; height: 40px; clicked => { root.factory_reset_arm(); } }
                if root.fr_armed : AuraButton { label: "🔥 DELETE EVERYTHING NOW"; danger: true; horizontal-stretch: 1; height: 40px; clicked => { root.factory_reset_confirm(); } }
                AuraButton { label: "✕ Cancel (keep my vault)"; horizontal-stretch: 1; height: 36px; clicked => { root.factory_reset_cancel(); } }
            }
        }
    }

    // ==== PR-1: New-device modal (blocking; re-shows every unlock until enrolled) ====
    if root.show_new_device_modal : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060ecc;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 460px;
            background: #0d131f;
            border-radius: 16px;
            border-width: 1px;
            border-color: #fbbf24;
            clip: true;
            VerticalLayout { padding: 20px; spacing: 10px;
                Text { text: "🖥️ New PC detected"; color: #fbbf24; font-size: 16px; font-weight: 900; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: root.new_device_reason == "hello-token" ? "Windows Hello credential can't be read on this PC. You unlocked with your Master Password. Re-enroll Hello for this machine?" : "This vault was bound to a different machine (normal for portable USB). You unlocked with your Master Password. Re-enroll Windows Hello for this PC?"; color: #8e99c0; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                if root.new_device_error != "" : Text { text: root.new_device_error; color: #fb7185; font-size: 12px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                AuraButton { label: "🖐 Re-enroll Hello"; primary: true; horizontal-stretch: 1; height: 40px; clicked => { root.reenroll_hello_requested(); } }
                AuraButton { label: "Later"; horizontal-stretch: 1; height: 36px; clicked => { root.dismiss_new_device_modal(); } }
            }
        }
    }

    // ==== Webcam QR scan modal (live camera, 60s budget) ====
    if root.show_webcam_scan : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060ecc;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 440px;
            background: #0d131f;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: #38e1ff;
            drop-shadow-blur: 40px;
            drop-shadow-color: #38e1ff44;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "📷  Scanning webcam for QR…"; font-size: 16px; font-weight: 800; color: #eef1ff; horizontal-alignment: center; }
                Text { text: "Hold the code steady in front of " + (root.webcam_cam_current == "" ? "the camera" : root.webcam_cam_current) + ". Auto-imports on detection (60s budget)."; color: #8e99c0; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                if root.webcam_cams.length > 1 : HorizontalLayout { alignment: center; spacing: 8px;
                    Text { text: "Camera:"; color: #8e99c0; font-size: 12px; vertical-alignment: center; }
                    ComboBox { model: root.webcam_cams; current-value <=> root.webcam_cam_current; selected(name) => { root.webcam_camera_picked(name); } width: 280px; height: 34px; }
                }
                Rectangle { background: #000000; border-radius: 12px; border-width: 1px; border-color: #26315c; clip: true;
                    height: 300px;
                    Image { source: root.webcam_frame; width: 100%; height: 100%; image-fit: contain; }
                }
                if root.webcam_hint != "" : Text { text: root.webcam_hint; color: #fbbf24; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: root.notification_text; color: #38e1ff; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: center;
                    AuraButton { label: "✕  Cancel Scan"; width: 160px; clicked => { root.cancel_webcam_scan(); } }
                }
            }
        }
    }

    // ==== Health audit report modal (HaveIBeenPwned k-anonymity) ====
    if root.show_health : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060ecc;
        TouchArea {
            clicked => { root.show_health = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 520px;
            background: #0d131f;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: #8b7cf6;
            drop-shadow-blur: 40px;
            drop-shadow-color: #8b7cf644;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "🛡️  Vault Health Report"; font-size: 16px; font-weight: 800; color: #eef1ff; horizontal-alignment: center; }
                // Score + count chips (props already published by the audit).
                HorizontalLayout { spacing: 8px; alignment: center;
                    Text { text: root.health_score + " / 100"; color: root.health_score >= 90 ? #10b981 : (root.health_score >= 70 ? #fbbf24 : #fb7185); font-size: 22px; font-weight: 900; vertical-alignment: center; }
                    VerticalLayout { spacing: 0px;
                        Text { text: root.health_headline; color: #8e99c0; font-size: 11px; wrap: word-wrap; }
                        HorizontalLayout { spacing: 10px;
                            Text { text: "🚨 " + root.health_breached; color: #fb7185; font-size: 11px; font-weight: 700; }
                            Text { text: "🔁 " + root.health_reused; color: #fbbf24; font-size: 11px; font-weight: 700; }
                            Text { text: "🔓 " + root.health_weak; color: #fbbf24; font-size: 11px; font-weight: 700; }
                            Text { text: "🕰️ " + root.health_stale; color: #8e99c0; font-size: 11px; font-weight: 700; }
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    min-height: 220px;
                    VerticalLayout { spacing: 4px; padding-left: 2px; padding-right: 2px;
                        if root.health_rows.length == 0 : Text { text: "✅ All passwords look healthy — no breaches, reuse, or weakness found."; color: #34d399; font-size: 12px; wrap: word-wrap; }
                        for row in root.health_rows : Rectangle {
                            background: row.sev == -1 ? transparent : #121927;
                            border-radius: 8px;
                            height: row.sev == -1 ? 24px : 40px;
                            clip: true;
                            if row.sev == -1 : Text { text: row.title; color: #8b7cf6; font-size: 11px; font-weight: 800; vertical-alignment: center; }
                            if row.sev >= 0 : HorizontalLayout { padding-left: 10px; padding-right: 6px; spacing: 8px;
                                Text { text: row.sev == 0 ? "🔴" : (row.sev == 1 ? "🟠" : (row.sev == 2 ? "🟡" : "⚪")); font-size: 12px; vertical-alignment: center; }
                                VerticalLayout { horizontal-stretch: 1; spacing: 0px;
                                    Text { text: row.title; color: #eef1ff; font-size: 12px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                    Text { text: row.flags; color: #8e99c0; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                }
                                Text { text: "›"; color: #5b6589; font-size: 16px; vertical-alignment: center; }
                            }
                            if row.sev >= 0 : TouchArea { mouse-cursor: pointer; clicked => { root.open_detail(row.id); root.show_health = false; } }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    AuraButton { label: "✕  Close"; width: 140px; clicked => { root.show_health = false; } }
                }
            }
        }
    }

    // ==== Access log modal (hash-chained, metadata only) ====
    if root.show_access_log : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060ecc;
        TouchArea {
            clicked => { root.show_access_log = false; }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 520px;
            background: #0d131f;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: #8b7cf6;
            drop-shadow-blur: 40px;
            drop-shadow-color: #8b7cf644;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "📜  Access Log (tamper-evident)"; font-size: 16px; font-weight: 800; color: #eef1ff; horizontal-alignment: center; }
                ScrollView {
                    vertical-stretch: 1;
                    min-height: 220px;
                    Text { text: root.access_log_text; color: #8e99c0; font-size: 12px; wrap: word-wrap; }
                }
                HorizontalLayout {
                    alignment: center;
                    AuraButton { label: "✕  Close"; width: 140px; clicked => { root.show_access_log = false; } }
                }
            }
        }
    }

    // ==== Import-source shred confirm (plaintext export hygiene) ====
    if root.show_shred_source : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060ecc;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 480px;
            background: #0d131f;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: #fb7185;
            drop-shadow-blur: 40px;
            drop-shadow-color: #fb718544;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: "🔥  Shred plaintext source?"; font-size: 16px; font-weight: 800; color: #fb7185; horizontal-alignment: center; }
                Text { text: "The imported file still holds UNENCRYPTED passwords:"; color: #8e99c0; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: root.shred_source_path; color: #eef1ff; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: "DoD 3-pass shred makes recovery impossible. Do it unless you need the file."; color: #5b6589; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    AuraButton { label: "🔥 Shred it"; danger: true; width: 150px; clicked => { root.confirm_shred_source(); } }
                    AuraButton { label: "Keep file"; width: 130px; clicked => { root.cancel_shred_source(); } }
                }
            }
        }
    }

    // ==== Emergency recovery sheet modal (Shamir 3-of-5) ====
    if root.show_shards : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060ecc;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
            width: 520px;
            background: #0d131f;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: #fbbf24;
            drop-shadow-blur: 40px;
            drop-shadow-color: #fbbf2444;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text { text: "📄  Emergency Recovery Sheet (3-of-5)"; font-size: 16px; font-weight: 800; color: #fbbf24; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: "Save or print these 5 shards on paper. Any 3 shards will recover your vault."; color: #8e99c0; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout { spacing: 8px; Text { text: root.shard_1; color: #38e1ff; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; } AuraButton { label: "📋"; width: 52px; height: 30px; clicked => { root.copy_password_requested(root.shard_1); } } }
                HorizontalLayout { spacing: 8px; Text { text: root.shard_2; color: #38e1ff; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; } AuraButton { label: "📋"; width: 52px; height: 30px; clicked => { root.copy_password_requested(root.shard_2); } } }
                HorizontalLayout { spacing: 8px; Text { text: root.shard_3; color: #38e1ff; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; } AuraButton { label: "📋"; width: 52px; height: 30px; clicked => { root.copy_password_requested(root.shard_3); } } }
                HorizontalLayout { spacing: 8px; Text { text: root.shard_4; color: #38e1ff; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; } AuraButton { label: "📋"; width: 52px; height: 30px; clicked => { root.copy_password_requested(root.shard_4); } } }
                HorizontalLayout { spacing: 8px; Text { text: root.shard_5; color: #38e1ff; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; } AuraButton { label: "📋"; width: 52px; height: 30px; clicked => { root.copy_password_requested(root.shard_5); } } }
                HorizontalLayout {
                    alignment: center;
                    AuraButton { label: "✕  Close Modal"; width: 160px; clicked => { root.show_shards = false; } }
                }
            }
        }
    }
}

// Phase 9: Raycast / Spotlight-Style Global Quick-Bar (Alt + Space)
export component QuickBarWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    width: 640px;
    height: 380px;
    background: transparent;
    title: "PhantomVault Quick Bar";

    in-out property <string> quick_query;
    in-out property <[CredentialView]> filtered_results;

    callback query_changed(string);
    // kind+id ride along so Rust can enforce the master-reprompt gate
    // (password strings alone cannot identify the item).
    callback item_selected(int, string, string);
    callback copy_totp_selected(int, string);
    callback type_selected(int, string, string, string, string);
    callback dismiss();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #0b1226f2;
        border-radius: 18px;
        border-color: #8b7cf6;
        border-width: 1.5px;
        drop-shadow-blur: 48px;
        drop-shadow-color: #8b7cf666;
        clip: true;

        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.dismiss();
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        background: #8b7cf6;
                        Text { text: "⚡"; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text { text: "Phantom Quick Bar"; color: #eef1ff; font-size: 14px; font-weight: 800; }
                        Text { text: "Alt+Space  •  instant copy"; color: #5b6589; font-size: 10px; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.filtered_results.length + " hits"; color: #5b6589; font-size: 11px; vertical-alignment: center; }
                }

                quick_input := LineEdit {
                    placeholder-text: "Type to filter — Enter copies first hit…";
                    text <=> root.quick_query;
                    height: 44px;
                    font-size: 15px;
                    edited(text) => { root.query_changed(text); }
                    accepted(text) => {
                        root.query_changed(text);
                        if root.filtered_results.length > 0 {
                            root.item_selected(root.filtered_results[0].kind, root.filtered_results[0].id, root.filtered_results[0].password);
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        for item in root.filtered_results : Rectangle {
                            background: #131d3d;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: #26315c;
                            height: 62px;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 10px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle {
                                        width: 40px;
                                        height: 40px;
                                        border-radius: 10px;
                                        background: #1a2450;
                                        Text { text: item.kind == 1 ? "🔑" : (item.kind == 2 ? "📜" : (item.kind == 3 ? "📝" : (item.kind == 4 ? "💳" : (item.kind == 5 ? "🪪" : "🔑")))); font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;
                                        Text { text: item.title; color: #eef1ff; font-size: 13px; font-weight: 700; overflow: elide; }
                                        Text { text: item.username; color: #5b6589; font-size: 11px; overflow: elide; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: center;
                                    if item.kind == 1 : AuraButton { label: "⌨️ Type"; width: 88px; y: 2px; clicked => { root.type_selected(item.kind, item.id, item.username, item.password, item.totp); } }
                                    if item.totp != "" : AuraButton { label: "⏱️"; width: 44px; y: 2px; clicked => { root.copy_totp_selected(item.kind, item.id); } }
                                    AuraButton { label: "📋 Copy"; width: 88px; y: 2px; clicked => { root.item_selected(item.kind, item.id, item.password); } }
                                }
                            }
                        }
                        if root.filtered_results.length == 0 : Text { text: "No matches — keep typing."; color: #5b6589; font-size: 12px; horizontal-alignment: center; }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Enter: copy first  •  Type: keystroke fill  •  Esc: dismiss"; color: #5b6589; font-size: 10px; vertical-alignment: center; }
                    AuraButton { label: "✕ Dismiss"; width: 110px; height: 32px; clicked => { root.dismiss(); } }
                }
            }
        }
    }
}

// Phase 22 (+23): Smart-Grab quick-capture overlay (Alt + S)
export component QuickCaptureWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    width: 520px;
    height: 430px;
    background: transparent;
    title: "PhantomVault Quick Capture";

    in-out property <string> cap_title;
    in-out property <string> cap_user;
    in-out property <string> cap_pass;
    in-out property <string> cap_totp;
    in-out property <string> cap_hint: "";

    callback capture_save(string, string, string, string);
    callback capture_generate();
    callback capture_cancel();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #0b1226f2;
        border-radius: 18px;
        border-color: #8b7cf6;
        border-width: 1.5px;
        drop-shadow-blur: 48px;
        drop-shadow-color: #8b7cf666;
        clip: true;

        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.capture_cancel();
                    return accept;
                }
                if event.text == Key.Return {
                    root.capture_save(root.cap_title, root.cap_user, root.cap_pass, root.cap_totp);
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        background: #8b7cf6;
                        Text { text: "⚡"; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text { text: "Quick Capture Login"; color: #eef1ff; font-size: 14px; font-weight: 800; }
                        Text { text: root.cap_hint == "" ? "Alt+S grabbed this app" : root.cap_hint; color: #5b6589; font-size: 10px; }
                    }
                }

                FieldLabel { text: "SERVICE TITLE"; }
                LineEdit { placeholder-text: "e.g. Discord"; text <=> root.cap_title; height: 36px; }
                FieldLabel { text: "USERNAME / EMAIL"; }
                LineEdit { placeholder-text: "Detected automatically when possible"; text <=> root.cap_user; height: 36px; }
                FieldLabel { text: "PASSWORD"; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { placeholder-text: "Paste, type, or 🎲…"; input-type: password; text <=> root.cap_pass; height: 36px; horizontal-stretch: 1; accepted(text) => { root.capture_save(root.cap_title, root.cap_user, text, root.cap_totp); } }
                    AuraButton { label: "🎲"; width: 56px; clicked => { root.capture_generate(); } }
                }
                FieldLabel { text: "2FA SECRET (OPTIONAL)"; }
                LineEdit { placeholder-text: "Paste otpauth secret when setting up 2FA…"; text <=> root.cap_totp; height: 36px; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    AuraButton { label: "💾  Save to Vault"; primary: true; width: 200px; clicked => { root.capture_save(root.cap_title, root.cap_user, root.cap_pass, root.cap_totp); } }
                    AuraButton { label: "✕ Dismiss"; width: 130px; clicked => { root.capture_cancel(); } }
                }
            }
        }
    }
}
