    in-out property <bool> show_totp_next: false;
    callback toggle_totp_next();
    // Copy by ACCOUNT ID, not by value. The handler regenerates at click time
    // and enforces the remaining-seconds guard, so a code that was valid when
    // the grid was drawn can never be copied after its window closed.
    callback copy_totp_requested(string);
    // Manual clock correction, in signed seconds. Deliberately NOT auto-probed:
    // a wrong code is fixable in 5 seconds, an outbound request from a 2FA tool
