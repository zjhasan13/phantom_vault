    in-out property <string> share_output: "";
    in-out property <string> share_item_id: "";
    in-out property <string> share_pubkey: "";
    in-out property <string> share_grant_id: "";
    in-out property <string> share_priv: "";
    in-out property <string> share_env: "";
    in-out property <string> bridge_status: "";
