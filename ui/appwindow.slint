                    HorizontalLayout { spacing: 8px; Text { text: "Automatic backups"; color: #eef1ff; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } AuraButton { label: root.backup_enabled ? "ON" : "OFF"; primary: root.backup_enabled; width: 90px; clicked => { root.set_backup_enabled(!root.backup_enabled); } } }
                    HorizontalLayout { spacing: 6px;
                        AuraButton { label: "Daily"; primary: root.backup_interval == 1; width: 80px; height: 30px; clicked => { root.set_backup_interval(1); } }
                        AuraButton { label: "Weekly"; primary: root.backup_interval == 7; width: 80px; height: 30px; clicked => { root.set_backup_interval(7); } }
                        AuraButton { label: "Monthly"; primary: root.backup_interval == 30; width: 80px; height: 30px; clicked => { root.set_backup_interval(30); } }
                        AuraButton { label: "📁 Browse"; width: 110px; height: 30px; clicked => { root.browse_backup_dir(); } }
                        AuraButton { label: "💾 Back Up Now"; width: 140px; height: 30px; clicked => { root.backup_now(); } }
                    }
                    Text { text: root.backup_dir; color: #8e99c0; font-size: 11px; wrap: word-wrap; }
                    Text { text: root.backup_status; color: #38e1ff; font-size: 11px; wrap: word-wrap; }
                }}
                Rectangle { background: #0d131f; border-radius: 12px; border-width: 1px; border-color: #26315c; VerticalLayout { padding: 16px; spacing: 10px;
                    Text { text: "Paranoia & Recovery"; color: #8b7cf6; font-size: 12px; font-weight: 800; }
                    // PR-3: persistent backup badge — survives nudge dismissal.
