import { Button, CheckBox, ComboBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";

// =============================================================================
// PHANTOM VAULT — "Phantom Aura" design system
// Deep void-navy + phantom violet aura. All property/callback names are a
// frozen contract with src/main.rs — NEVER rename them (UI-only redesign).
// =============================================================================

// Unified row for all 6 item kinds. kind: 1 login, 2 license, 3 note,
// 4 card, 5 identity, 6 ssh. user=subtitles, secret=protected value,
// meta=short aux (expiry/phone/fingerprint), url+notes as applicable.
struct CredentialView {
    id: string,
    kind: int,
    title: string,
    username: string,
    password: string,
    meta: string,
    url: string,
    notes: string,
    folder: string,
    totp: string,
    health: string,
    fav: bool,
}

// Retired password row (secret rides along for the copy button; RAM-only).
struct HistoryView {
    password: string,
    when: string,
}

// Bitwarden-style custom field. ftype: 0 text, 1 hidden, 2 checkbox.
struct CustomFieldView {
    name: string,
    value: string,
    ftype: int,
}

// Sealed file attachment row.
struct AttachmentView {
    id: string,
    filename: string,
    size: string,
}

// Authenticator account row. kind: "TOTP" | "HOTP" | "STEAM".
// display = grouped code for the big digits ("513 710"), next = upcoming
// code, icon = brand letter, tint = brand color (all preformatted in Rust).
struct AuthView {
    id: string,
    name: string,
    issuer: string,
    code: string,
    display: string,
    next: string,
    icon: string,
    tint: color,
    kind: string,
    is_hotp: bool,
    // Per-card live countdown: seconds left (TOTP) / -1 (HOTP) + label.
    secs: int,
    countdown: string,
}

// Resident passkey row. meta is preformatted ("3 signs").
struct PasskeyView {
    id: string,
    rp: string,
    user: string,
    meta: string,
    fav: bool,
}

// LAN peer row (name + ip preformatted in Rust; detail = version • head).
struct PeerView {
    name: string,
    ip: string,
    detail: string,
}

// --- Phantom palette (single source of truth) ---
global PhantomTheme {
    in-out property <color> void: #080c14;
    in-out property <color> abyss: #0b1226;
    in-out property <color> panel: #101834;
    in-out property <color> card: #131d3d;
    in-out property <color> edge: #26315c;
    in-out property <color> aura: #8b7cf6;
    in-out property <color> pulse: #38e1ff;
    in-out property <color> ink: #eef1ff;
    in-out property <color> mist: #8e99c0;
    in-out property <color> dim: #5b6589;
    in-out property <color> good: #34d399;
    in-out property <color> warn: #fbbf24;
    in-out property <color> bad: #fb7185;
}

// --- Small reusable atoms (pure visual, no logic) ---
component AuraButton inherits Rectangle {
    in-out property <string> label;
    in-out property <bool> primary: false;
    in-out property <bool> danger: false;
    callback clicked();
    height: 38px;
    border-radius: 10px;
    background: root.primary ? #8b7cf6 : (root.danger ? #3a1730 : #1a2450);
    border-width: 1px;
    border-color: root.primary ? #a99bff : (root.danger ? #fb7185 : #2c3a6e);
    drop-shadow-blur: root.primary ? 18px : 0px;
    drop-shadow-color: #8b7cf655;
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.label;
        color: root.primary ? #ffffff : (root.danger ? #fb7185 : #cfd7ff);
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    states [
        pressed when area.pressed : {
            background: root.primary ? #7464e8 : #232e63;
        }
        hover when area.has-hover : {
            border-color: root.primary ? #c4b8ff : #8b7cf6;
        }
    ]
}

component NavItem inherits Rectangle {
    in-out property <string> icon;
    in-out property <string> label;
    in-out property <bool> active: false;
    callback tapped();
    height: 44px;
    border-radius: 10px;
    background: root.active ? #1a2450 : transparent;
    border-width: 1px;
    border-color: root.active ? #8b7cf6 : transparent;
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.tapped(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        alignment: start;
        Text {
            text: root.icon;
            font-size: 15px;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.active ? #ffffff : #8e99c0;
            font-size: 13px;
            font-weight: root.active ? 700 : 400;
            vertical-alignment: center;
        }
    }
    states [
        hover when area.has-hover : {
            background: #151d42;
        }
    ]
}

component FieldLabel inherits Text {
    font-size: 11px;
    font-weight: 700;
    color: #8e99c0;
}

// Phase 26: ephemeral secret field. Peep OFF → classic eye toggle (sticky).
// Peep ON → value exists ONLY while the HOLD pad is physically pressed;
// release/leave snaps back to dots instantly (no framing window for cameras).
component MoireVeil inherits Rectangle {
    background: transparent;
    clip: true;
    TouchArea { mouse-cursor: default; }
    for i in 72 : Rectangle {
        x: i * 8px;
        width: 1px;
        height: parent.height;
        background: #ffffff10;
    }
}

component GeneratorPanel inherits Rectangle {
    width: 460px;
    // height grows with content (no fixed height → never overflows taskbar)
    background: #0d131f;
    border-radius: 16px;
    border-width: 1.5px;
    border-color: #8b7cf6;
    drop-shadow-blur: 40px;
    drop-shadow-color: #8b7cf644;

    in-out property <int> gen_length;
    in-out property <bool> gen_uppercase;
    in-out property <bool> gen_lowercase;
    in-out property <bool> gen_digits;
    in-out property <bool> gen_symbols;
    in-out property <bool> gen_exclude_ambiguous;
    in-out property <bool> gen_diceware_mode;
    in-out property <int> gen_dice_lang;
    in-out property <int> gen_word_count;
    in-out property <string> gen_output;
    in-out property <float> gen_entropy_bits;

    callback regenerate();
    callback use_password(string);
    callback close_panel();

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        // Header
        HorizontalLayout {
            alignment: space-between;
            Text { text: "🎲  Generator"; font-size: 17px; font-weight: 800; color: #eef1ff; vertical-alignment: center; }
            AuraButton {
                label: "✕";
                width: 34px;
                height: 34px;
                clicked => { root.close_panel(); }
            }
        }

        // Mode segmented control
        Rectangle {
            background: #121927;
            border-radius: 10px;
            height: 42px;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    background: !root.gen_diceware_mode ? #8b7cf6 : transparent;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.gen_diceware_mode = false; root.regenerate(); }
                    }
                    Text { text: "Complex"; color: !root.gen_diceware_mode ? #ffffff : #8e99c0; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 8px;
                    background: root.gen_diceware_mode ? #8b7cf6 : transparent;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.gen_diceware_mode = true; root.regenerate(); }
                    }
                    Text { text: "Diceware"; color: root.gen_diceware_mode ? #ffffff : #8e99c0; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        if !root.gen_diceware_mode : VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                alignment: space-between;
                FieldLabel { text: "LENGTH"; vertical-alignment: center; }
                HorizontalLayout {
                    spacing: 8px;
                    AuraButton { label: "−"; width: 34px; height: 32px; clicked => { if root.gen_length > 8 { root.gen_length -= 1; root.regenerate(); } } }
                    Text { text: root.gen_length; color: #38e1ff; font-size: 15px; font-weight: 800; vertical-alignment: center; min-width: 36px; horizontal-alignment: center; }
                    AuraButton { label: "+"; width: 34px; height: 32px; clicked => { if root.gen_length < 128 { root.gen_length += 1; root.regenerate(); } } }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    AuraButton { label: root.gen_uppercase ? "A-Z ✓" : "A-Z"; width: 86px; height: 32px; primary: root.gen_uppercase; clicked => { root.gen_uppercase = !root.gen_uppercase; root.regenerate(); } }
                    AuraButton { label: root.gen_lowercase ? "a-z ✓" : "a-z"; width: 86px; height: 32px; primary: root.gen_lowercase; clicked => { root.gen_lowercase = !root.gen_lowercase; root.regenerate(); } }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    AuraButton { label: root.gen_digits ? "0-9 ✓" : "0-9"; width: 86px; height: 32px; primary: root.gen_digits; clicked => { root.gen_digits = !root.gen_digits; root.regenerate(); } }
                    AuraButton { label: root.gen_symbols ? "#$! ✓" : "#$!"; width: 86px; height: 32px; primary: root.gen_symbols; clicked => { root.gen_symbols = !root.gen_symbols; root.regenerate(); } }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    FieldLabel { text: "NO AMBIGUOUS"; horizontal-alignment: center; }
                    AuraButton { label: root.gen_exclude_ambiguous ? "0/O/l ✓" : "0/O/l"; width: 86px; height: 32px; primary: root.gen_exclude_ambiguous; clicked => { root.gen_exclude_ambiguous = !root.gen_exclude_ambiguous; root.regenerate(); } }
                }
            }
        }

        if root.gen_diceware_mode : VerticalLayout { spacing: 8px;
        HorizontalLayout {
            spacing: 4px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 8px;
                height: 34px;
                background: root.gen_dice_lang == 0 ? #1a2450 : transparent;
                border-width: 1px;
                border-color: root.gen_dice_lang == 0 ? #38e1ff : #26315c;
                TouchArea { mouse-cursor: pointer; clicked => { root.gen_dice_lang = 0; root.regenerate(); } }
                Text { text: "English (EFF 7776)"; color: root.gen_dice_lang == 0 ? #ffffff : #8e99c0; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 8px;
                height: 34px;
                background: root.gen_dice_lang == 1 ? #1a2450 : transparent;
                border-width: 1px;
                border-color: root.gen_dice_lang == 1 ? #38e1ff : #26315c;
                TouchArea { mouse-cursor: pointer; clicked => { root.gen_dice_lang = 1; root.regenerate(); } }
                Text { text: "বাংলা 🇧🇩"; color: root.gen_dice_lang == 1 ? #ffffff : #8e99c0; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        HorizontalLayout {
            alignment: space-between;
            FieldLabel { text: "WORDS"; vertical-alignment: center; }
            HorizontalLayout {
                spacing: 8px;
                AuraButton { label: "−"; width: 34px; height: 32px; clicked => { if root.gen_word_count > 4 { root.gen_word_count -= 1; root.regenerate(); } } }
                Text { text: root.gen_word_count; color: #38e1ff; font-size: 15px; font-weight: 800; vertical-alignment: center; min-width: 30px; horizontal-alignment: center; }
                AuraButton { label: "+"; width: 34px; height: 32px; clicked => { if root.gen_word_count < 12 { root.gen_word_count += 1; root.regenerate(); } } }
            }
        }}

        // Output well
        Rectangle {
            background: #121927;
            border-radius: 10px;
            border-width: 1px;
            border-color: #26315c;
            height: 56px;
            Text {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                text: root.gen_output == "" ? "—" : root.gen_output;
                color: root.gen_output == "" ? #5b6589 : #38e1ff;
                font-size: 14px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        // Entropy meter
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: space-between;
                FieldLabel { text: "ENTROPY"; }
                Text {
                    text: Math.round(root.gen_entropy_bits) + " bits";
                    font-size: 12px;
                    font-weight: 800;
                    color: root.gen_entropy_bits > 80 ? #34d399 : (root.gen_entropy_bits > 60 ? #fbbf24 : #fb7185);
                }
            }
            Rectangle {
                background: #121927;
                border-radius: 4px;
                height: 8px;
                Rectangle {
                    x: 0;
                    width: Math.min(root.gen_entropy_bits / 128 * (parent.width), parent.width);
                    height: parent.height;
                    border-radius: 4px;
                    background: root.gen_entropy_bits > 80 ? #34d399 : (root.gen_entropy_bits > 60 ? #fbbf24 : #fb7185);
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            AuraButton { label: "🔄  Regenerate"; horizontal-stretch: 1; clicked => { root.regenerate(); } }
            AuraButton { label: "✅  Use This"; primary: true; horizontal-stretch: 1; clicked => { root.use_password(root.gen_output); } }
        }
    }
}

export component MainWindow inherits Window {
    title: "PhantomVault — Zero-Knowledge Native Vault";
    min-width: 960px;
    min-height: 620px;
    background: #080c14;

    // ==== Frozen Rust contract (do not rename) ====
    in-out property <bool> is_unlocked: false;
    in-out property <bool> show_add_form: false;
    in-out property <string> status_text: "Vault is locked. Enter Master Password:";
    // Cat 8: binary self-integrity tripwire (empty = verified clean).
    in-out property <string> integrity_warning: "";
    in-out property <string> live_totp_code: "------";
    in-out property <string> totp_countdown: "30s";
    in-out property <string> hero_account: "LIVE 2FA";
    // Phase 24: authenticator accounts (dynamic algo/digits/type)
    in-out property <[AuthView]> auth_accounts;
    // Grid rows of 3 for the authenticator page (nested model, rebuilt together).
    in-out property <[[AuthView]]> auth_rows;
    // Resident WebAuthn passkeys (hub list + register form + hub trash).
    in-out property <[PasskeyView]> passkeys;
    in-out property <[PasskeyView]> passkeys_trash;
    in-out property <string> pk_rp;
    in-out property <string> pk_user;
    callback register_passkey(string, string);
    callback delete_passkey(string);
    callback restore_passkey(string);
    callback toggle_passkey_fav(string);
    callback copy_passkey_pub(string);
    callback export_recovery_sheet();
    in-out property <string> notification_text: "";
    in-out property <[CredentialView]> credentials;
    in-out property <string> search_query;
    // Isolated 2FA Hub query — never touches the vault search above.
    in-out property <string> totp_search_query: "";
    // Bitwarden-parity item management
    in-out property <int> new_kind: 1;
    in-out property <int> type_filter: 0;
    in-out property <string> folder_filter: "All";
    in-out property <string> f_title;
    in-out property <string> f_a;
    in-out property <string> f_b;
    in-out property <string> f_c;
    in-out property <string> f_d;
    in-out property <string> f_e;
    in-out property <string> f_notes;
    in-out property <string> f_folder: "General";
    in-out property <string> f_totp;
    in-out property <string> f_backup;
    in-out property <bool> f_reprompt: false;
    in-out property <bool> f_fav: false;
    in-out property <bool> f_travel: false;
    // Folder engine
    in-out property <[string]> folders_list;
    in-out property <[string]> filter_folders;
    in-out property <string> new_folder_name;
    // Custom fields (pending form list + add dialog)
    in-out property <[CustomFieldView]> custom_fields;
    in-out property <bool> show_cf_dialog: false;
    in-out property <int> cf_type: 0;
    in-out property <string> cf_name;
    in-out property <string> cf_value;
    in-out property <int> cf_revealed: -1;
    in-out property <bool> show_new_menu: false;
    in-out property <bool> show_detail: false;
    in-out property <string> d_id;
    in-out property <int> d_kind: 1;
    in-out property <string> d_title;
    in-out property <string> d_user;
    in-out property <string> d_secret;
    in-out property <string> d_meta;
    in-out property <string> d_url;
    in-out property <string> d_notes;
    in-out property <string> d_urls_extra;
    in-out property <string> d_folder;
    in-out property <bool> d_secret_visible: false;
    in-out property <bool> d_reprompt: false;
    in-out property <bool> d_stale: false;
    in-out property <bool> d_fav: false;
    in-out property <[HistoryView]> d_history;
    in-out property <bool> show_history: false;
    in-out property <bool> show_fav_only: false;
    in-out property <bool> showing_trash: false;
    in-out property <string> trash_label: "Trash";
    in-out property <bool> show_empty_confirm: false;
    in-out property <bool> d_trashed: false;
    callback restore_item(int, string);
    callback empty_trash();
    in-out property <bool> d_travel: false;
    in-out property <bool> exp_confirm: false;
    in-out property <string> exp_att_id: "";
    in-out property <[AttachmentView]> d_attachments;
    // Travel Mode (border-crossing minimal vault)
    in-out property <bool> is_travel_mode: false;
    in-out property <string> d_totp;
    in-out property <string> d_backup;
    in-out property <[CustomFieldView]> d_custom;
    in-out property <int> d_revealed: -1;
    // Reprompt gate modal
    in-out property <bool> rp_show: false;
    in-out property <int> rp_action: 0;
    in-out property <int> rp_kind: 1;
    in-out property <string> rp_id;
    in-out property <string> rp_user;
    in-out property <string> rp_secret;
    in-out property <string> rp_error: "";
    in-out property <bool> show_2fa_import: false;
    // GA reverse-export modal state (image set from Rust PNG bytes).
    in-out property <bool> ga_show: false;
    in-out property <image> ga_image;
    in-out property <string> ga_page: "";
    in-out property <string> ga_warn: "";
    in-out property <bool> show_webcam_scan: false;
    in-out property <int> alias_provider: 0;
    in-out property <string> alias_domain;
    in-out property <string> alias_token;
    in-out property <string> import_input;
    in-out property <string> import_2fa_status: "";
    // Phase 11: Windows Hello
    in-out property <bool> hello_available: false;
    in-out property <string> hello_status: "Checking…";
    in-out property <string> ssh_status: "Not checked";
    callback refresh_ssh_status();
    in-out property <bool> and_mode: false;
    callback set_and_mode(bool);
    in-out property <string> unlock_error_message: "";
    // Phase 27: optional vault-unlock TOTP gate (DEFAULT OFF)
    in-out property <bool> show_totp_step: false;
    in-out property <string> totp_step_error: "";
    in-out property <bool> totp2fa_on: false;
    in-out property <string> totp2fa_secret: "";
    callback verify_totp_unlock(string);
    callback cancel_totp_step();
    callback setup_totp_unlock();
    callback confirm_totp_unlock(string);
    callback disable_totp_unlock();
    // Phase 26: anti-photography lens guard (both DEFAULT OFF)
    in-out property <bool> peep_hole_mode: false;
    in-out property <bool> moire_guard_active: false;
    callback set_peep_mode(bool);
    callback set_moire(bool);
    // Phase 17: Shamir recovery sheet (unlocked) + shard recovery (lock)
    in-out property <bool> show_shards: false;
    in-out property <string> shard_1;
    in-out property <string> shard_2;
    in-out property <string> shard_3;
    in-out property <string> shard_4;
    in-out property <string> shard_5;
    in-out property <bool> show_recover: false;
    in-out property <string> recover_1;
    in-out property <string> recover_2;
    in-out property <string> recover_3;
    callback generate_shards();
    callback recover_with_shards(string, string, string);
    callback stego_hide();
    callback stego_restore();
    // Phase 15 (Option 1): paranoia suite
    in-out property <bool> is_decoy: false;
    in-out property <string> duress_input;
    // Phase 25: breach + health audit
    in-out property <bool> show_health: false;
    in-out property <string> health_report: "Not audited yet.";
    in-out property <bool> offline_audit: false;
    callback audit_vault();
    callback filter_health(string);
    // Cat 8: kill-switch + tamper-evident access log
    in-out property <bool> offline_mode: false;
    in-out property <bool> show_access_log: false;
    in-out property <string> access_log_text: "No events yet.";
    callback set_offline_mode(bool);
    callback view_access_log();
    callback set_tray_minimize(bool);
    callback set_backup_enabled(bool);
    callback set_backup_interval(int);
    callback browse_backup_dir();
    callback backup_now();
    // Phase 25: BLE proximity auto-lock (0 Close/-75, 1 Medium/-85, 2 Far/-95)
    in-out property <bool> prox_enabled: false;
    in-out property <string> prox_device: "";
    in-out property <int> prox_sensitivity: 1;
    in-out property <string> prox_status: "⚪ Proximity Inactive";
    callback set_prox_enabled(bool);
    callback save_prox_device(string);
    callback set_prox_sensitivity(int);
    // Phase 18: Omni-Importer vault view
    in-out property <string> import_status: "No import yet — pick any export file.";
    // Cat 8: plaintext import-source shred offer
    in-out property <bool> show_shred_source: false;
    in-out property <string> shred_source_path: "";
    callback confirm_shred_source();
    callback cancel_shred_source();
    in-out property <int> active_nav: 0;
    in-out property <bool> blackout_enabled: false;
    in-out property <string> health_status: "Not audited yet.";
    // Scoreboard dashboard (set by the audit worker; filter drives the list).
    in-out property <int> health_score: 100;
    in-out property <string> health_headline: "Not audited yet.";
    in-out property <int> health_breached: 0;
    in-out property <int> health_reused: 0;
    in-out property <int> health_weak: 0;
    in-out property <int> health_stale: 0;
    in-out property <int> health_coverage: 0;
    in-out property <string> health_filter: "";
    in-out property <int> clipboard_timeout: 15;
    in-out property <int> autolock_timeout: 0;
    in-out property <bool> show_autofill_pill: false;
    in-out property <string> pill_title: "";
    // Phase 12: zero-knowledge GitHub sync
    in-out property <bool> show_sync: false;
    in-out property <string> sync_owner;
    in-out property <string> sync_repo;
    in-out property <string> sync_token_input;
    in-out property <string> sync_status: "";
    in-out property <string> bridge_status: "";
    // Local Wi-Fi P2P sync (default OFF) + GitHub Releases updater.
    in-out property <bool> p2p_enabled: false;
    in-out property <string> p2p_status: "P2P discovery is OFF — enable to find LAN devices.";
    in-out property <[PeerView]> p2p_peers;
    in-out property <string> p2p_pin: "";
    in-out property <string> p2p_peer_pin: "";
    in-out property <string> update_status: "";
    in-out property <string> update_tag: "";
    in-out property <bool> update_ready: false;
    in-out property <string> app_version: "";
    in-out property <string> ext_host_id: "";
    in-out property <string> export_status: "";
    in-out property <int> rp_export_fmt: 0;
    in-out property <bool> tray_minimize: true;
    in-out property <bool> backup_enabled: true;
    in-out property <int> backup_interval: 7;
    in-out property <string> backup_dir: "";
    in-out property <string> backup_status: "";
    in-out property <bool> show_generator: false;
    in-out property <int> gen_length: 20;
    in-out property <bool> gen_uppercase: true;
    in-out property <bool> gen_lowercase: true;
    in-out property <bool> gen_digits: true;
    in-out property <bool> gen_symbols: true;
    in-out property <bool> gen_exclude_ambiguous: true;
    in-out property <bool> gen_diceware_mode: false;
    in-out property <int> gen_dice_lang: 0;
    in-out property <int> gen_word_count: 6;
    in-out property <string> gen_output: "";
    in-out property <float> gen_entropy_bits: 0.0;
    callback unlock_requested(string);
    callback copy_password_requested(string);
    callback add_item_requested(int, string, string, string, string, string, string, string, string, string, string, bool, bool, bool);
    callback delete_item_requested(int, string);
    callback type_filter_changed(int);
    callback folder_filter_changed(string);
    callback fav_filter_changed(bool);
    callback toggle_favorite(int, string);
    callback show_trash_view();
    callback open_url(string);
    callback open_new_form(int);
    callback cancel_form();
    callback add_folder_requested(string);
    callback add_custom_field(int, string, string);
    callback delete_custom_field(int);
    callback toggle_pending_field(int);
    callback toggle_saved_field(int, string, int);
    callback edit_item_requested(int, string);
    callback open_detail(string);
    callback reprompt_confirm(string);
    callback search_changed(string);
    callback totp_search_changed(string);
    callback scan_qr_requested();
    callback scan_webcam_requested();
    callback cancel_webcam_scan();
    callback generate_alias_for_form();
    callback save_alias_config(int, string, string);
    callback import_url_requested(string);
    callback import_2fa_file();
    callback hotp_next(string);
    callback delete_auth_account(string);
    callback request_biometric_unlock();
    callback type_credential_requested(string, string, string);
    callback type_item_requested(int, string);
    callback save_sync_config(string, string, string);
    callback sync_now();
    callback set_p2p(bool);
    callback scan_p2p();
    callback sync_peer(string, string);
    callback regen_p2p_pin();
    callback check_updates();
    callback download_update();
    callback restart_update();
    callback pick_import_file();
    callback install_browser_host(string);
    // Zero-lockin reverse exporters (2FA hub QR + full-vault files).
    callback ga_export_start();
    callback ga_export_page(int);
    callback ga_copy_uri();
    callback export_vault(int);
    callback set_blackout(bool);
    callback set_clipboard_timeout(int);
    callback set_autolock_timeout(int);
    callback autofill_pill_clicked();
    callback lock_now();
    callback scan_secrets();
    callback set_duress_password(string);
    callback plant_canary();
    callback set_travel_mode(bool);
    callback pick_attachment(int, string);
    callback download_attachment(int, string, string);
    callback delete_attachment(int, string, string);
    callback toggle_travel(int, string);
    callback regenerate();
    callback use_password(string);
    callback close_panel();

    // ================= LOCK SCREEN =================
    if !root.is_unlocked : Rectangle {
        // Invisible focus grabber: conditional ids aren't visible to root init,
        // so focus is requested from inside the lock-screen scope itself.
        FocusScope {
            width: 0;
            height: 0;
            init => { password_input.focus(); }
        }
        background: #080c14;
        // aura glows
        Rectangle { x: parent.width * 0.12; y: parent.height * 0.08; width: 340px; height: 340px; border-radius: 170px; background: #8b7cf622; }
        Rectangle { x: parent.width * 0.72; y: parent.height * 0.55; width: 300px; height: 300px; border-radius: 150px; background: #38e1ff18; }
        VerticalLayout {
            alignment: center;
            // brand
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 14px;
                    background: #8b7cf6;
                    drop-shadow-blur: 30px;
                    drop-shadow-color: #8b7cf688;
                    Text { text: "P"; color: #ffffff; font-size: 26px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                }
                VerticalLayout {
                    spacing: 0px;
                    alignment: center;
                    Text { text: "PHANTOM VAULT"; font-size: 24px; font-weight: 900; color: #eef1ff; }
                    Text { text: "ZERO-KNOWLEDGE  •  NATIVE  •  QUANTUM-READY"; font-size: 10px; font-weight: 700; color: #5b6589; }
                }
            }
            Rectangle { height: 26px; }
            // unlock card (wrapped to force perfect horizontal centering)
            HorizontalLayout {
                alignment: center;
                Rectangle {
                width: 440px;
                background: #0d131f;
                border-radius: 18px;
                border-width: 1px;
                border-color: #26315c;
                drop-shadow-blur: 36px;
                drop-shadow-color: #00000088;
                VerticalLayout {
                    padding: 28px;
                    spacing: 14px;
                    Text { text: root.status_text; font-size: 13px; color: #8e99c0; horizontal-alignment: center; wrap: word-wrap; }
                    if root.integrity_warning != "" : Rectangle {
                        background: #3a1730;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #fb7185;
                        clip: true;
                        VerticalLayout { padding: 10px; spacing: 0px;
                        Text { text: root.integrity_warning; color: #fb7185; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                        }
                    }
                    password_input := LineEdit {
                        placeholder-text: "Master password…";
                        input-type: password;
                        height: 46px;
                        font-size: 15px;
                        accepted(text) => { root.unlock_requested(text); }
                    }
                    AuraButton {
                        label: "🔓  Unlock Vault";
                        primary: true;
                        height: 46px;
                        clicked => { root.unlock_requested(password_input.text); }
                    }
                    if root.hello_available : AuraButton {
                        label: "🖐  Quick Unlock with Windows Hello";
                        height: 42px;
                        clicked => { root.request_biometric_unlock(); }
                    }
                    if root.unlock_error_message != "" : HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text { text: root.unlock_error_message; font-size: 12px; font-weight: 600; color: #fb7185; horizontal-alignment: center; wrap: word-wrap; }
                        AuraButton { label: "✕"; width: 26px; height: 24px; danger: true; clicked => { root.unlock_error_message = ""; } }
                    }
                    // Phase 27: second factor — only when the vault armed it.
                    if root.show_totp_step : VerticalLayout {
                        spacing: 8px;
                        Text { text: "🔐 Second factor required"; font-size: 14px; font-weight: 800; color: #eef1ff; horizontal-alignment: center; }
                        totp_step_input := LineEdit {
                            placeholder-text: "6-digit code";
                            height: 46px;
                            font-size: 18px;
                            horizontal-alignment: center;
                            accepted(text) => { root.verify_totp_unlock(text); }
                        }
                        if root.totp_step_error != "" : Text { text: root.totp_step_error; font-size: 12px; font-weight: 600; color: #fb7185; horizontal-alignment: center; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            AuraButton { label: "✅ Verify & Unlock"; primary: true; height: 42px; horizontal-stretch: 1; clicked => { root.verify_totp_unlock(totp_step_input.text); } }
                            AuraButton { label: "Back"; height: 42px; width: 90px; clicked => { root.cancel_totp_step(); } }
                        }
                    }
                    // Phase 17: shard recovery (lost master password)
                    AuraButton {
                        label: root.show_recover ? "🔑  Back to Password" : "🆘  Recover via Shards";
                        height: 38px;
                        clicked => { root.show_recover = !root.show_recover; }
                    }
                    if root.show_recover : VerticalLayout {
                        spacing: 8px;
                        FieldLabel { text: "PASTE ANY 3 SHARDS"; horizontal-alignment: center; }
                        LineEdit { placeholder-text: "Shard A (PHANTOM-n …)"; text <=> root.recover_1; height: 38px; }
                        LineEdit { placeholder-text: "Shard B (PHANTOM-n …)"; text <=> root.recover_2; height: 38px; }
                        LineEdit { placeholder-text: "Shard C (PHANTOM-n …)"; text <=> root.recover_3; height: 38px; }
                        AuraButton {
                            label: "🔓  Rebuild & Unlock";
                            primary: true;
                            height: 42px;
                            clicked => { root.recover_with_shards(root.recover_1, root.recover_2, root.recover_3); }
                        }
                    }
                    Text { text: "First run creates a new encrypted vault  •  Alt+Space for Quick Bar"; font-size: 10px; color: #5b6589; horizontal-alignment: center; wrap: word-wrap; }
                }
                }
            }
        }
    }

    // ================= APP SHELL — STRICT 3-COLUMN =================
    if root.is_unlocked : HorizontalLayout {
        spacing: 0px;

        // 1. Column 1: Sidebar (220px)
        Rectangle {
            width: 220px;
            background: #121927;
            VerticalLayout {
            padding: 16px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 10px;
                padding-bottom: 12px;
                Rectangle { width: 38px; height: 38px; border-radius: 11px; background: #8b7cf6; Text { text: "P"; color: #ffffff; font-size: 19px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } }
                VerticalLayout { alignment: center; spacing: 0px; Text { text: "PHANTOM"; font-size: 14px; font-weight: 900; color: #eef1ff; } Text { text: "VAULT"; font-size: 10px; font-weight: 700; color: #8b7cf6; } }
            }
            FieldLabel { text: "VAULT"; }
            ScrollView { vertical-stretch: 1;
            VerticalLayout { spacing: 6px;
            NavItem { icon: "🔍"; label: "All items"; active: root.active_nav == 0 && root.type_filter == 0 && !root.show_fav_only && root.folder_filter == "All"; tapped => { root.active_nav = 0; root.type_filter = 0; root.type_filter_changed(0); root.folder_filter = "All"; root.folder_filter_changed("All"); root.fav_filter_changed(false); } }
            NavItem { icon: "⭐"; label: "Favorites"; active: root.active_nav == 0 && root.show_fav_only && !root.showing_trash; tapped => { root.active_nav = 0; root.type_filter = 0; root.type_filter_changed(0); root.folder_filter = "All"; root.folder_filter_changed("All"); root.fav_filter_changed(true); } }
            NavItem { icon: "🗑️"; label: root.trash_label; active: root.active_nav == 0 && root.showing_trash; tapped => { root.show_trash_view(); } }
            Rectangle { height: 10px; }
            FieldLabel { text: "TYPES"; }
            NavItem { icon: "🔑"; label: "Login"; active: root.active_nav == 0 && !root.show_fav_only && root.type_filter == 1; tapped => { root.active_nav = 0; root.type_filter = 1; root.type_filter_changed(1); root.fav_filter_changed(false); } }
            NavItem { icon: "💳"; label: "Card"; active: root.active_nav == 0 && !root.show_fav_only && root.type_filter == 4; tapped => { root.active_nav = 0; root.type_filter = 4; root.type_filter_changed(4); root.fav_filter_changed(false); } }
            NavItem { icon: "🪪"; label: "Identity"; active: root.active_nav == 0 && !root.show_fav_only && root.type_filter == 5; tapped => { root.active_nav = 0; root.type_filter = 5; root.type_filter_changed(5); root.fav_filter_changed(false); } }
            NavItem { icon: "📝"; label: "Note"; active: root.active_nav == 0 && !root.show_fav_only && root.type_filter == 3; tapped => { root.active_nav = 0; root.type_filter = 3; root.type_filter_changed(3); root.fav_filter_changed(false); } }
            NavItem { icon: "📜"; label: "License"; active: root.active_nav == 0 && !root.show_fav_only && root.type_filter == 2; tapped => { root.active_nav = 0; root.type_filter = 2; root.type_filter_changed(2); root.fav_filter_changed(false); } }
            NavItem { icon: "🔑"; label: "SSH Key"; active: root.active_nav == 0 && !root.show_fav_only && root.type_filter == 6; tapped => { root.active_nav = 0; root.type_filter = 6; root.type_filter_changed(6); root.fav_filter_changed(false); } }
            FieldLabel { text: "FOLDERS"; }
            for f in root.filter_folders : NavItem { icon: "📁"; label: f; active: root.active_nav == 0 && root.folder_filter == f; tapped => { root.active_nav = 0; root.folder_filter = f; root.folder_filter_changed(f); } }
            LineEdit { placeholder-text: "+ New folder..."; text <=> root.new_folder_name; height: 32px; accepted(text) => { root.add_folder_requested(text); } }
            FieldLabel { text: "APP"; }
            NavItem { icon: "➕"; label: "+ New"; active: root.show_add_form; tapped => { root.active_nav = 0; root.show_new_menu = !root.show_new_menu; } }
            if root.show_new_menu : VerticalLayout { spacing: 2px;
                NavItem { icon: "🌐"; label: "Login"; tapped => { root.open_new_form(1); } }
                NavItem { icon: "💳"; label: "Card"; tapped => { root.open_new_form(4); } }
                NavItem { icon: "🪪"; label: "Identity"; tapped => { root.open_new_form(5); } }
                NavItem { icon: "📝"; label: "Note"; tapped => { root.open_new_form(3); } }
                NavItem { icon: "📜"; label: "License"; tapped => { root.open_new_form(2); } }
                NavItem { icon: "🔑"; label: "SSH Key"; tapped => { root.open_new_form(6); } }
            }
            NavItem { icon: "🎲"; label: "Generator"; active: root.show_generator; tapped => { root.show_generator = true; root.regenerate(); } }
            NavItem { icon: "🛡️"; label: "2FA Hub"; active: root.active_nav == 1; tapped => { root.active_nav = 1; } }
            NavItem { icon: "📥"; label: "Import"; active: root.active_nav == 2; tapped => { root.active_nav = 2; } }
            NavItem { icon: "⚙️"; label: "Settings"; active: root.active_nav == 3; tapped => { root.active_nav = 3; } }
            NavItem { icon: "🔒"; label: "Lock"; tapped => { root.lock_now(); } }
            if root.is_travel_mode : Rectangle { background: #2a1f08; border-radius: 8px; height: 28px; Text { text: "✈️ TRAVEL ON"; color: #fbbf24; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
            }
            }
            AuraButton { label: root.is_travel_mode ? "✈️ TRAVEL ON" : "VAULT SEALED"; primary: !root.is_travel_mode; danger: root.is_travel_mode; height: 32px; clicked => { root.set_travel_mode(!root.is_travel_mode); } }
            }
        }

        // active_nav routing: 0=Vault 3-col, 1=2FA Hub grid, 2=Importer, 3=Settings center
        if root.active_nav == 1 : Rectangle {
            background: #080c14; horizontal-stretch: 1; clip: true;
            VerticalLayout { padding: 22px; spacing: 14px;
                HorizontalLayout { spacing: 8px;
                    AuraButton { label: "+ Add 2FA"; primary: true; width: 120px; clicked => { root.show_2fa_import = !root.show_2fa_import; } }
                    LineEdit { placeholder-text: "🔍 Search 2FA accounts..."; text <=> root.totp_search_query; height: 38px; horizontal-stretch: 1; edited(text) => { root.totp_search_changed(text); } }
                    AuraButton { label: "📲 Import"; width: 110px; clicked => { root.show_2fa_import = !root.show_2fa_import; } }
                    AuraButton { label: "📲 Export"; width: 110px; clicked => { root.ga_export_start(); } }
                    AuraButton { label: "⚙"; width: 46px; clicked => { root.active_nav = 3; } }
                }
                if root.show_2fa_import : Rectangle { background: #0d131f; border-radius: 12px; border-width: 1px; border-color: #26315c; VerticalLayout { padding: 14px; spacing: 8px;
                    Text { text: "Google  •  2FAS  •  Aegis  •  Steam .maFile  •  FreeOTP  •  Multi-QR  •  otpauth://"; color: #5b6589; font-size: 10px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; AuraButton { label: "📋 Scan QR"; primary: true; horizontal-stretch: 1; clicked => { root.scan_qr_requested(); } } AuraButton { label: "📷 Scan via Webcam"; horizontal-stretch: 1; clicked => { root.scan_webcam_requested(); } } AuraButton { label: "📁 Browse File"; horizontal-stretch: 1; clicked => { root.import_2fa_file(); } } }
                    TextEdit { placeholder-text: "Paste multi-line otpauth:// links or raw JSON here…"; text <=> root.import_input; height: 72px; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; alignment: center; AuraButton { label: "⬇ Import"; primary: true; width: 140px; clicked => { root.import_url_requested(root.import_input); } } }
                    if root.import_2fa_status != "" : Text { text: root.import_2fa_status; color: #38e1ff; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                } }
                ScrollView { vertical-stretch: 1; VerticalLayout { spacing: 14px;
                    // Proton-style 2-column card grid (rows of 2 from Rust;
                    // a lone card gets a stretch spacer, never full-width).
                    for row in root.auth_rows : HorizontalLayout { spacing: 14px;
                        for acc in row : Rectangle {
                            horizontal-stretch: 1;
                            background: #111827;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #1e293b;
                            height: 148px;
                            clip: true;
                            HorizontalLayout { padding: 14px; spacing: 10px;
                                VerticalLayout { horizontal-stretch: 1; spacing: 4px;
                                    HorizontalLayout { spacing: 8px;
                                        Rectangle { width: 36px; height: 36px; border-radius: 18px; background: acc.tint;
                                            Text { text: acc.icon; color: #080c14; font-size: 16px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } }
                                        VerticalLayout { spacing: 0px; alignment: center;
                                            Text { text: acc.issuer == "" ? acc.name : acc.issuer; color: #eef1ff; font-size: 13px; font-weight: 800; overflow: elide; }
                                            Text { text: acc.name; color: #8e99c0; font-size: 11px; overflow: elide; } }
                                    }
                                    Text { text: acc.display; color: #eef1ff; font-size: 26px; font-weight: 900; }
                                    Text { text: "Next: " + acc.next; color: #5b6589; font-size: 10px; overflow: elide; }
                                }
                                VerticalLayout { spacing: 4px; alignment: center;
                                    Rectangle { width: 48px; height: 48px; border-radius: 24px; border-width: 2px;
                                        border-color: acc.is_hotp ? #8b7cf6 : (acc.secs > 15 ? #8b7cf6 : (acc.secs > 5 ? #fbbf24 : #fb7185));
                                        Text { text: acc.countdown; color: acc.is_hotp ? #8b7cf6 : (acc.secs > 15 ? #8b7cf6 : (acc.secs > 5 ? #fbbf24 : #fb7185)); font-size: acc.is_hotp ? 9px : 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
                                    if acc.is_hotp : Text { text: "🔢 HOTP"; color: #8b7cf6; font-size: 9px; font-weight: 700; horizontal-alignment: center; }
                                    if acc.is_hotp : AuraButton { label: "🔄 Next"; width: 64px; height: 26px; clicked => { root.hotp_next(acc.id); } }
                                    HorizontalLayout { spacing: 4px; alignment: center;
                                        AuraButton { label: "📋 Copy"; width: 72px; height: 28px; clicked => { root.copy_password_requested(acc.code); } }
                                        AuraButton { label: "🗑️"; width: 40px; height: 28px; danger: true; clicked => { root.delete_auth_account(acc.id); } } }
                                }
                            }
                        }
                        if row.length == 1 : Rectangle { horizontal-stretch: 1; }
                    }
                    if root.auth_rows.length == 0 : Text { text: "No 2FA accounts yet — hit + Add."; color: #5b6589; font-size: 12px; horizontal-alignment: center; }
                    Text { text: "🔑  Resident Passkeys (WebAuthn)"; color: #eef1ff; font-size: 15px; font-weight: 900; }
                    HorizontalLayout { spacing: 8px; LineEdit { placeholder-text: "Relying party (github.com)"; text <=> root.pk_rp; height: 36px; horizontal-stretch: 1; } LineEdit { placeholder-text: "Username"; text <=> root.pk_user; height: 36px; horizontal-stretch: 1; } AuraButton { label: "+ Register"; primary: true; width: 130px; clicked => { root.register_passkey(root.pk_rp, root.pk_user); } } }
                    VerticalLayout { spacing: 8px;
                        for pk in root.passkeys : Rectangle { background: #0d131f; border-radius: 12px; border-width: 1px; border-color: #26315c; height: 64px;
                            HorizontalLayout { padding: 12px; spacing: 10px; alignment: space-between;
                                VerticalLayout { spacing: 1px; Text { text: "🔑 " + pk.rp + " • " + pk.user; color: #eef1ff; font-size: 13px; font-weight: 700; overflow: elide; } Text { text: pk.meta; color: #5b6589; font-size: 11px; overflow: elide; } }
                                HorizontalLayout { spacing: 8px; alignment: center; AuraButton { label: pk.fav ? "⭐" : "☆"; width: 44px; height: 32px; clicked => { root.toggle_passkey_fav(pk.id); } } AuraButton { label: "📋 Pub"; width: 80px; height: 32px; clicked => { root.copy_passkey_pub(pk.id); } } AuraButton { label: "🗑"; width: 44px; height: 32px; danger: true; clicked => { root.delete_passkey(pk.id); } } }
                            }
                        }
                        if root.passkeys.length == 0 : Text { text: "No passkeys yet — register one above."; color: #5b6589; font-size: 12px; horizontal-alignment: center; }
                        if root.passkeys_trash.length > 0 : VerticalLayout { spacing: 8px;
                            Text { text: "🗑️ Passkey Trash (shredded after 30 days)"; color: #fb7185; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                            for pk in root.passkeys_trash : Rectangle { background: #0d131f; border-radius: 12px; border-width: 1px; border-color: #fb718555; height: 64px;
                                HorizontalLayout { padding: 12px; spacing: 10px; alignment: space-between;
                                    VerticalLayout { spacing: 1px; Text { text: "🔑 " + pk.rp + " • " + pk.user; color: #8e99c0; font-size: 13px; font-weight: 700; overflow: elide; } Text { text: pk.meta; color: #5b6589; font-size: 11px; overflow: elide; } }
                                    HorizontalLayout { spacing: 8px; alignment: center; AuraButton { label: "♻️ Restore"; width: 110px; height: 32px; clicked => { root.restore_passkey(pk.id); } } AuraButton { label: "🔥"; width: 44px; height: 32px; danger: true; clicked => { root.delete_passkey(pk.id); } } }
                                }
                            }
                        }
                    }
                }}
                // Zero-lockin: scan pages into Google Authenticator.
                if root.ga_show : Rectangle {
                    background: #04060ecc;
                    TouchArea { clicked => { root.ga_show = false; } }
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: Math.max((parent.height - self.height) / 2 - 16px, 12px);
                        width: 420px;
                        background: #0d131f;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: #8b7cf6;
                        clip: true;
                        VerticalLayout { padding: 20px; spacing: 10px;
                            Text { text: "📲 Export to Google Authenticator"; color: #eef1ff; font-size: 15px; font-weight: 800; horizontal-alignment: center; }
                            Text { text: "Scan with your phone — secrets leave the vault only through your camera."; color: #8e99c0; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                            HorizontalLayout { alignment: center;
                                Rectangle { width: 300px; height: 300px; border-radius: 12px; background: #ffffff;
                                    Image { source: root.ga_image; width: 300px; height: 300px; image-fit: contain; }
                                }
                            }
