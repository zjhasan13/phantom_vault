    in-out property <bool> ext_pin_set: false;
    in-out property <string> ext_pin_status: "";
    in-out property <string> ssh_status: "Not checked";
    callback refresh_ssh_status();
    // One-click agent (no terminal): Start serves a vault-keys snapshot on a
