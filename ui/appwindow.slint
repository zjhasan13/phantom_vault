                        AuraButton { label: root.ui_lang == "bn" ? "বিদ্যমান আপডেট" : "Update existing"; primary: root.import_merge_mode == 1; width: 160px; height: 30px; clicked => { root.import_mode_changed(1); } }
                        AuraButton { label: root.ui_lang == "bn" ? "সব ইমপোর্ট" : "Import all"; primary: root.import_merge_mode == 2; width: 130px; height: 30px; clicked => { root.import_mode_changed(2); } }
                    }
                    if root.import_undo_available : AuraButton { label: root.ui_lang == "bn" ? "শেষ ইমপোর্ট আনডু" : "Undo last import"; width: 160px; height: 30px; clicked => { root.undo_import(); } }
                    HorizontalLayout { spacing: 8px; alignment: center;
                        AuraButton { label: root.ui_lang == "bn" ? "✅ ইমপোর্ট নিশ্চিত" : "✅ Confirm Import"; primary: true; width: 190px; height: 38px; clicked => { root.confirm_import_file(); } }
                        AuraButton { label: root.ui_lang == "bn" ? "✕ বাতিল" : "✕ Cancel"; width: 130px; height: 38px; clicked => { root.cancel_import_file(); } }
                    }
                }}
            }}
        }
        if root.active_nav == 3 : Rectangle {
            background: PhantomTheme.canvas; horizontal-stretch: 1; clip: true;
            settings_scroll := ScrollView { VerticalLayout { padding: 22px; spacing: 14px;
                Rectangle { background: PhantomTheme.surface-low; border-radius: 14px; border-width: 1px; border-color: PhantomTheme.border; VerticalLayout { padding: 18px; spacing: 10px;
                    HorizontalLayout { spacing: 10px; alignment: center;
                        Text { text: "SETTINGS & DEV CENTER"; color: PhantomTheme.text; font-size: 20px; font-weight: 900; letter-spacing: 0.4px; }
                        MonoChip { label: "LOCAL VAULT"; tone: PhantomTheme.success; }
                        MonoChip { label: "DPAPI BOUND"; tone: PhantomTheme.secondary; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: "v" + root.app_version; color: PhantomTheme.text-dim; font-size: 10px; font-family: "JetBrains Mono"; }
                    }
                    Text { text: "Master password, Windows Hello, sync, privacy, recovery, backups and the local API - every control grouped below."; color: PhantomTheme.text-muted; font-size: 11px; wrap: word-wrap; }
                    HorizontalLayout { spacing: 6px;
                        AuraButton { label: "Security"; primary: root.settings_tab == 0; width: 90px; height: 30px; clicked => { root.settings_tab = 0; } }
                        AuraButton { label: "Sync & Devices"; primary: root.settings_tab == 1; width: 124px; height: 30px; clicked => { root.settings_tab = 1; } }
                        AuraButton { label: "Privacy"; primary: root.settings_tab == 2; width: 82px; height: 30px; clicked => { root.settings_tab = 2; } }
                        AuraButton { label: "Recovery"; primary: root.settings_tab == 3; width: 92px; height: 30px; clicked => { root.settings_tab = 3; } }
                        AuraButton { label: "Backups"; primary: root.settings_tab == 4; width: 86px; height: 30px; clicked => { root.settings_tab = 4; } }
                        AuraButton { label: "Dev & API"; primary: root.settings_tab == 5; width: 94px; height: 30px; clicked => { root.settings_tab = 5; } }
                    }
                }
                }
                HorizontalLayout { spacing: 8px; Text { text: root.ui_lang == "bn" ? "ভাষা" : "Language"; color: PhantomTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } AuraButton { label: "English"; primary: root.ui_lang == "en"; width: 100px; height: 30px; clicked => { root.set_language("en"); } } AuraButton { label: "বাংলা"; primary: root.ui_lang == "bn"; width: 100px; height: 30px; clicked => { root.set_language("bn"); } } }
                if root.settings_tab == 0 : Rectangle { background: PhantomTheme.surface; border-radius: 12px; border-width: 1px; border-color: PhantomTheme.border; VerticalLayout { padding: 16px; spacing: 10px;
                    Text { text: "Security"; color: PhantomTheme.primary; font-size: 12px; font-weight: 800; }
                    HorizontalLayout { spacing: 8px; Text { text: "Screen Blackout"; color: PhantomTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } AuraButton { label: root.blackout_enabled ? "ON" : "OFF"; primary: root.blackout_enabled; width: 90px; clicked => { root.set_blackout(!root.blackout_enabled); } } }
                    HorizontalLayout { spacing: 8px; Text { text: "Website Favicons (same-origin)"; color: PhantomTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } AuraButton { label: root.favicons_enabled ? "ON" : "OFF"; primary: root.favicons_enabled; width: 90px; clicked => { root.set_favicons(!root.favicons_enabled); } } }
                    HorizontalLayout { spacing: 8px; Text { text: "Custom logos (per-domain override)"; color: PhantomTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } AuraButton { label: "↻ Refresh"; width: 90px; clicked => { root.refresh_favicons(); } } AuraButton { label: "🧹 Clear"; width: 90px; clicked => { root.clear_custom_favicons(); } } }
                    Text { text: "Missing an icon? Open the login → tap 🖼️ to set a logo manually, or hit Refresh. Letter = offline/uncached, or icons OFF above."; color: PhantomTheme.text-dim; font-size: 11px; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; Text { text: "Travel Mode"; color: PhantomTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } AuraButton { label: root.is_travel_mode ? "ON" : "OFF"; primary: root.is_travel_mode; width: 90px; clicked => { root.set_travel_mode(!root.is_travel_mode); } } }
                    HorizontalLayout { spacing: 8px; Text { text: "Windows Hello"; color: PhantomTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } Text { text: root.hello_status; color: PhantomTheme.text-muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; wrap: word-wrap; } }
                    HorizontalLayout { spacing: 8px; Text { text: "App PIN quick unlock (this PC only)"; color: PhantomTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } Text { text: root.pin_available ? "SET" : "OFF"; color: root.pin_available ? PhantomTheme.success : PhantomTheme.text-dim; font-size: 11px; font-weight: 800; vertical-alignment: center; } }
                    HorizontalLayout { spacing: 8px;
                        pin_new := LineEdit { placeholder-text: "New 4–8 digit PIN"; input-type: password; height: 36px; horizontal-stretch: 1; }
                        pin_confirm := LineEdit { placeholder-text: "Confirm PIN"; input-type: password; height: 36px; horizontal-stretch: 1; }
                    }
                    HorizontalLayout { spacing: 8px;
                        AuraButton { label: "Set PIN"; primary: true; width: 130px; height: 34px; clicked => { root.setup_app_pin(pin_new.text, pin_confirm.text); pin_new.text = ""; pin_confirm.text = ""; } }
                        if root.pin_available : AuraButton { label: root.confirm_pin_remove ? "Sure?" : "Remove PIN"; danger: true; width: root.confirm_pin_remove ? 110px : 130px; height: 34px; clicked => { if root.confirm_pin_remove { root.confirm_pin_remove = false; root.disable_app_pin(); } else { root.confirm_pin_remove = true; } } }
                    }
                    if root.pin_status != "" : Text { text: root.pin_status; color: PhantomTheme.secondary; font-size: 11px; wrap: word-wrap; }
                    // A5: master-password rotation (rekey). Old backups, exports
                    // and printed shards stay on the OLD password by design.
                    FieldLabel { text: root.ui_lang == "bn" ? "মাস্টার পাসওয়ার্ড পরিবর্তন" : "MASTER PASSWORD ROTATION"; }
                    Text { text: "Re-encrypts the vault with a fresh salt. Old backups, exports and printed shards keep the OLD password. App PIN is removed after rotation."; color: PhantomTheme.text-dim; font-size: 11px; wrap: word-wrap; }
                    HorizontalLayout { spacing: 6px;
                        rekey_old := LineEdit { placeholder-text: "Current master password"; input-type: password; height: 36px; horizontal-stretch: 1; }
                        rekey_new := LineEdit { placeholder-text: "New (8+ characters)"; input-type: password; height: 36px; horizontal-stretch: 1; }
                        rekey_confirm := LineEdit { placeholder-text: "Confirm new"; input-type: password; height: 36px; horizontal-stretch: 1; }
                    }
                    HorizontalLayout { spacing: 8px;
                        AuraButton { label: root.confirm_rekey ? "Sure? Re-encrypt" : "Change Master Password"; primary: !root.confirm_rekey; danger: root.confirm_rekey; width: root.confirm_rekey ? 190px : 220px; height: 34px; clicked => { if root.confirm_rekey { root.confirm_rekey = false; root.change_master_password(rekey_old.text, rekey_new.text, rekey_confirm.text); rekey_old.text = ""; rekey_new.text = ""; rekey_confirm.text = ""; } else { root.confirm_rekey = true; } } }
                        if root.confirm_rekey : AuraButton { label: "Cancel"; width: 90px; height: 34px; clicked => { root.confirm_rekey = false; } }
                    }
                    if root.rekey_status != "" : Text { text: root.rekey_status; color: PhantomTheme.secondary; font-size: 11px; wrap: word-wrap; }
                    // A11: read-only snapshot for the extension, opened with
                    // Windows Hello even when the desktop app is closed.
                    FieldLabel { text: root.ui_lang == "bn" ? "অফলাইন ব্রাউজার ক্যাশ (রিড-অনলি)" : "OFFLINE BROWSER CACHE (READ-ONLY)"; }
                    Text { text: root.ui_lang == "bn" ? "শুধু লগইন। DPAPI + র‍্যান্ডম কী দিয়ে সিল করা; এক্সটেনশন পড়তে Windows Hello পাস করতে হয়, ১৫ মিনিট রাখে। ডিকয় আনলক/বন্ধ/master rotation-এ মুছে যায়।" : "Logins only. Sealed with DPAPI + a random key; the extension must pass a Windows Hello prompt to read it, and keeps it for 15 minutes. Erased on decoy unlock, disable, or master rotation."; color: PhantomTheme.text-dim; font-size: 11px; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; Text { text: "Offline read-only cache"; color: PhantomTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } AuraButton { label: root.offline_cache_on ? "ON" : "OFF"; primary: root.offline_cache_on; width: 90px; clicked => { root.set_offline_cache(!root.offline_cache_on); } } }
                    HorizontalLayout { spacing: 8px; Text { text: "Allow extension PIN unlock (weaker than Hello)"; color: PhantomTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; } AuraButton { label: root.offline_pin_on ? "ON" : "OFF"; primary: root.offline_pin_on; width: 90px; clicked => { root.set_offline_cache_pin(!root.offline_pin_on); } } }
                    if root.offline_cache_status != "" : Text { text: root.offline_cache_status; color: PhantomTheme.secondary; font-size: 11px; wrap: word-wrap; }
                    // A22 Phase C: device-bound container profile. Correct
